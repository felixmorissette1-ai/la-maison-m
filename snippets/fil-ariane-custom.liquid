{% comment %}
  Paramètre: etape_active (1-9) — Configurateur Custom

  v2 — remplace l'ancien mécanisme "fenêtre condensée + flèches qui
  cachent/révèlent des étapes" (jugé pas assez évident à utiliser) par un
  simple bandeau défilant horizontal : toutes les étapes sont toujours
  présentes dans le DOM, on centre l'étape active au chargement, et les
  flèches ne font qu'un défilement natif (scrollBy) — aucune logique de
  fenêtre à comprendre, le geste de scroll (tactile, molette, flèches)
  suffit par lui-même.
{% endcomment %}
<style>
  .lmm-filc { background: var(--lmm-ivoire-pale); border-bottom: 1px solid rgba(var(--lmm-text-rgb),0.08); padding: 0 4%; position: relative; }
  .lmm-filc__inner { display: flex; align-items: stretch; height: 52px; gap: 0; position: relative; }
  .lmm-filc__track {
    display: flex; align-items: stretch; gap: 0; flex: 1; min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .lmm-filc__track::-webkit-scrollbar { display: none; }
  .lmm-filc__step {
    display: flex; align-items: center; gap: 8px; padding: 0 10px;
    text-decoration: none; color: var(--lmm-muted); font-size: 10px; letter-spacing: 0.1em;
    text-transform: uppercase; border-bottom: 2px solid transparent;
    cursor: default; white-space: nowrap; flex-shrink: 0;
  }
  .lmm-filc__group:first-child .lmm-filc__step { padding-left: 0; }
  .lmm-filc__step--active { color: var(--lmm-text); border-bottom-color: var(--lmm-bordeaux); }
  .lmm-filc__step--done { color: var(--lmm-muted); cursor: pointer; text-decoration: none; }
  .lmm-filc__step--done:hover { color: var(--lmm-text); }
  .lmm-filc__num {
    width: 18px; height: 18px; border-radius: 50%;
    background: var(--lmm-ivoire-deep); color: var(--lmm-text); font-size: 9px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; font-weight: 600;
  }
  .lmm-filc__step--active .lmm-filc__num { background: var(--lmm-bordeaux); color: var(--lmm-ivoire-pale); }
  .lmm-filc__step--done .lmm-filc__num { background: var(--lmm-text); color: var(--lmm-ivoire-pale); }
  .lmm-filc__sep { color: var(--lmm-muted); font-size: 14px; display: flex; align-items: center; flex-shrink: 0; padding: 0 2px; }
  .lmm-filc__group { display: flex; align-items: stretch; flex-shrink: 0; }
  .lmm-filc__nav-btn {
    display: flex; align-items: center; justify-content: center;
    width: 28px; flex-shrink: 0; background: none; border: none;
    color: var(--lmm-text); cursor: pointer; font-size: 15px;
  }
  .lmm-filc__nav-btn:hover { color: var(--lmm-bordeaux); }

  /* Indices visuels de défilement — un dégradé qui s'estompe sur les
     bords, pour signaler qu'il y a davantage à voir de chaque côté,
     même sans avoir cliqué les flèches. */
  .lmm-filc__fade { position: absolute; top: 0; bottom: 0; width: 24px; pointer-events: none; z-index: 1; transition: opacity 0.15s; }
  .lmm-filc__fade--left { left: 28px; background: linear-gradient(to right, var(--lmm-ivoire-pale), transparent); }
  .lmm-filc__fade--right { right: 28px; background: linear-gradient(to left, var(--lmm-ivoire-pale), transparent); }
  .lmm-filc__fade[hidden] { opacity: 0; }
</style>
<nav class="lmm-filc">
  <div class="lmm-filc__inner">
    <button type="button" class="lmm-filc__nav-btn" id="filc-prev" aria-label="Défiler vers les étapes précédentes">‹</button>
    <span class="lmm-filc__fade lmm-filc__fade--left" id="filc-fade-left" hidden></span>
    <div class="lmm-filc__track" id="filc-track">

    <div class="lmm-filc__group" data-step="1">
      {% if etape_active > 1 %}
        <a href="/pages/sur-mesure" class="lmm-filc__step lmm-filc__step--done" id="smc-step-1">
          <span class="lmm-filc__num">✓</span>Style
        </a>
      {% elsif etape_active == 1 %}
        <span class="lmm-filc__step lmm-filc__step--active" id="smc-step-1">
          <span class="lmm-filc__num">1</span>Style
        </span>
      {% else %}
        <span class="lmm-filc__step" id="smc-step-1"><span class="lmm-filc__num">1</span>Style</span>
      {% endif %}
      <span class="lmm-filc__sep">›</span>
    </div>

    <div class="lmm-filc__group" data-step="2">
      {% if etape_active > 2 %}
        <a href="/pages/sur-mesure-pieces" class="lmm-filc__step lmm-filc__step--done" id="smc-step-2">
          <span class="lmm-filc__num">✓</span>Pièces
        </a>
      {% elsif etape_active == 2 %}
        <span class="lmm-filc__step lmm-filc__step--active" id="smc-step-2">
          <span class="lmm-filc__num">2</span>Pièces
        </span>
      {% else %}
        <span class="lmm-filc__step" id="smc-step-2"><span class="lmm-filc__num">2</span>Pièces</span>
      {% endif %}
      <span class="lmm-filc__sep">›</span>
    </div>

    <div class="lmm-filc__group" data-step="3">
      {% if etape_active > 3 %}
        <a href="/pages/sur-mesure-tissu" class="lmm-filc__step lmm-filc__step--done" id="smc-step-3">
          <span class="lmm-filc__num">✓</span>Tissu
        </a>
      {% elsif etape_active == 3 %}
        <span class="lmm-filc__step lmm-filc__step--active" id="smc-step-3">
          <span class="lmm-filc__num">3</span>Tissu
        </span>
      {% else %}
        <span class="lmm-filc__step" id="smc-step-3"><span class="lmm-filc__num">3</span>Tissu</span>
      {% endif %}
      <span class="lmm-filc__sep">›</span>
    </div>

    <div class="lmm-filc__group" data-step="4">
      {% if etape_active > 4 %}
        <a href="/pages/sur-mesure-lining" class="lmm-filc__step lmm-filc__step--done" id="smc-step-4">
          <span class="lmm-filc__num">✓</span>Lining
        </a>
      {% elsif etape_active == 4 %}
        <span class="lmm-filc__step lmm-filc__step--active" id="smc-step-4">
          <span class="lmm-filc__num">4</span>Lining
        </span>
      {% else %}
        <span class="lmm-filc__step" id="smc-step-4"><span class="lmm-filc__num">4</span>Lining</span>
      {% endif %}
      <span class="lmm-filc__sep">›</span>
    </div>

    <div class="lmm-filc__group" data-step="5">
      {% if etape_active > 5 %}
        <a href="/pages/sur-mesure-boutons" class="lmm-filc__step lmm-filc__step--done" id="smc-step-5">
          <span class="lmm-filc__num">✓</span>Boutons
        </a>
      {% elsif etape_active == 5 %}
        <span class="lmm-filc__step lmm-filc__step--active" id="smc-step-5">
          <span class="lmm-filc__num">5</span>Boutons
        </span>
      {% else %}
        <span class="lmm-filc__step" id="smc-step-5"><span class="lmm-filc__num">5</span>Boutons</span>
      {% endif %}
      <span class="lmm-filc__sep">›</span>
    </div>

    <div class="lmm-filc__group" data-step="6">
      {% if etape_active > 6 %}
        <a href="/pages/sur-mesure-construction" class="lmm-filc__step lmm-filc__step--done" id="smc-step-6">
          <span class="lmm-filc__num">✓</span>Construction
        </a>
      {% elsif etape_active == 6 %}
        <span class="lmm-filc__step lmm-filc__step--active" id="smc-step-6">
          <span class="lmm-filc__num">6</span>Construction
        </span>
      {% else %}
        <span class="lmm-filc__step" id="smc-step-6"><span class="lmm-filc__num">6</span>Construction</span>
      {% endif %}
      <span class="lmm-filc__sep">›</span>
    </div>

    <div class="lmm-filc__group" data-step="7">
      {% if etape_active > 7 %}
        <a href="/pages/sur-mesure-ourlet" class="lmm-filc__step lmm-filc__step--done" id="smc-step-7">
          <span class="lmm-filc__num">✓</span>Pantalon
        </a>
      {% elsif etape_active == 7 %}
        <span class="lmm-filc__step lmm-filc__step--active" id="smc-step-7">
          <span class="lmm-filc__num">7</span>Pantalon
        </span>
      {% else %}
        <span class="lmm-filc__step" id="smc-step-7"><span class="lmm-filc__num">7</span>Pantalon</span>
      {% endif %}
      <span class="lmm-filc__sep">›</span>
    </div>

    <div class="lmm-filc__group" data-step="8">
      {% if etape_active > 8 %}
        <a href="/pages/sur-mesure-monogramme" class="lmm-filc__step lmm-filc__step--done" id="smc-step-8">
          <span class="lmm-filc__num">✓</span>Monogramme
        </a>
      {% elsif etape_active == 8 %}
        <span class="lmm-filc__step lmm-filc__step--active" id="smc-step-8">
          <span class="lmm-filc__num">8</span>Monogramme
        </span>
      {% else %}
        <span class="lmm-filc__step" id="smc-step-8"><span class="lmm-filc__num">8</span>Monogramme</span>
      {% endif %}
      <span class="lmm-filc__sep">›</span>
    </div>

    <div class="lmm-filc__group" data-step="9">
      {% if etape_active == 9 %}
        <span class="lmm-filc__step lmm-filc__step--active" id="smc-step-9">
          <span class="lmm-filc__num">9</span>Récap
        </span>
      {% else %}
        <span class="lmm-filc__step" id="smc-step-9"><span class="lmm-filc__num">9</span>Récap</span>
      {% endif %}
    </div>

    </div>
    <span class="lmm-filc__fade lmm-filc__fade--right" id="filc-fade-right" hidden></span>
    <button type="button" class="lmm-filc__nav-btn" id="filc-next" aria-label="Défiler vers les étapes suivantes">›</button>
  </div>
</nav>
<script>
  (function() {
    var params = new URLSearchParams(window.location.search);
    var pages = {
      2: '/pages/sur-mesure-pieces',
      3: '/pages/sur-mesure-tissu',
      4: '/pages/sur-mesure-lining',
      5: '/pages/sur-mesure-boutons',
      6: '/pages/sur-mesure-construction',
      7: '/pages/sur-mesure-ourlet',
      8: '/pages/sur-mesure-monogramme'
    };
    var completed = {
      2: !!params.get('pieces'),
      3: !!params.get('tissu'),
      4: !!params.get('lining'),
      5: !!params.get('bouton'),
      6: !!params.get('construction'),
      7: !!params.get('hauteur') && !!params.get('bas'),
      8: !!params.get('mono_vu')
    };
    [2, 3, 4, 5, 6, 7, 8].forEach(function(step) {
      var el = document.getElementById('smc-step-' + step);
      if (!el) return;
      if (completed[step] && !el.classList.contains('lmm-filc__step--active') && !el.classList.contains('lmm-filc__step--done')) {
        el.classList.add('lmm-filc__step--done');
        el.querySelector('.lmm-filc__num').textContent = '✓';
        el.style.cursor = 'pointer';
        el.addEventListener('click', function() {
          window.location.href = pages[step] + window.location.search;
        });
      }
    });
    document.querySelectorAll('.lmm-filc__step--done[href]').forEach(function(link) {
      link.setAttribute('href', link.getAttribute('href').split('?')[0] + window.location.search);
    });

    // Bandeau défilant : toutes les étapes existent toujours dans le DOM
    // (plus de fenêtre condensée à comprendre) — on centre juste l'étape
    // active au chargement, et les flèches ne font qu'un scroll de la
    // largeur visible, comme n'importe quel carrousel.
    var track = document.getElementById('filc-track');
    var activeEl = document.getElementById('smc-step-{{ etape_active }}');

    function centrerEtapeActive() {
      if (!track || !activeEl) return;
      var cible = activeEl.offsetLeft - (track.clientWidth / 2) + (activeEl.offsetWidth / 2);
      track.scrollLeft = Math.max(0, cible);
    }
    centrerEtapeActive();
    window.addEventListener('resize', centrerEtapeActive);

    function updateFades() {
      var fadeLeft = document.getElementById('filc-fade-left');
      var fadeRight = document.getElementById('filc-fade-right');
      var prevBtn = document.getElementById('filc-prev');
      var nextBtn = document.getElementById('filc-next');
      if (!track) return;
      var atStart = track.scrollLeft <= 2;
      var atEnd = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
      if (fadeLeft) fadeLeft.hidden = atStart;
      if (fadeRight) fadeRight.hidden = atEnd;
      if (prevBtn) prevBtn.style.opacity = atStart ? '0.3' : '1';
      if (nextBtn) nextBtn.style.opacity = atEnd ? '0.3' : '1';
    }
    if (track) {
      track.addEventListener('scroll', updateFades);
      updateFades();
    }

    document.getElementById('filc-prev').addEventListener('click', function() {
      if (track) track.scrollLeft -= 160;
    });
    document.getElementById('filc-next').addEventListener('click', function() {
      if (track) track.scrollLeft += 160;
    });
  })();
</script>
