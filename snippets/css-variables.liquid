{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;

    /* La Maison M — Palette */
    --lmm-white:   #ffffff;
    --lmm-surface: #ffffff;
    --lmm-border:  #E8E8E8;
    --lmm-text:    {{ settings.lmm_text }};
    --lmm-text-rgb: {{ settings.lmm_text | color_extract: 'red' }}, {{ settings.lmm_text | color_extract: 'green' }}, {{ settings.lmm_text | color_extract: 'blue' }};
    --lmm-muted:   {{ settings.lmm_muted }};
    --lmm-gold:    #C9A96E;
    --lmm-error:   #c0392b;
    --lmm-success: #7DAF7D;

    /* Palette bordeaux/ivoire — en-tête + page d'accueil pour l'instant
       (voir TODO.md : reste du site toujours sur la palette gold/text ci-dessus).
       Toutes ces couleurs (et le texte/muted plus haut) sont pilotées depuis
       Réglages du thème → La Maison M — Couleurs : un seul endroit pour tout
       changer, sans toucher au code. */
    --lmm-bordeaux:       {{ settings.lmm_bordeaux }};
    --lmm-bordeaux-rgb:   {{ settings.lmm_bordeaux | color_extract: 'red' }}, {{ settings.lmm_bordeaux | color_extract: 'green' }}, {{ settings.lmm_bordeaux | color_extract: 'blue' }};
    --lmm-bordeaux-soft:  {{ settings.lmm_bordeaux_soft }};
    --lmm-bordeaux-pale:  {{ settings.lmm_bordeaux_pale }};
    /* Ivoire pâle = l'ancien "ivoire foncé" (Felix a demandé d'inverser
       la hiérarchie) ; ivoire foncé est un tout nouveau ton, plus foncé
       que tout ce qu'il y avait avant. */
    --lmm-ivoire-pale:   {{ settings.lmm_ivoire_pale }};
    --lmm-ivoire:        {{ settings.lmm_ivoire }};
    --lmm-ivoire-rgb:    {{ settings.lmm_ivoire | color_extract: 'red' }}, {{ settings.lmm_ivoire | color_extract: 'green' }}, {{ settings.lmm_ivoire | color_extract: 'blue' }};
    --lmm-ivoire-deep:   {{ settings.lmm_ivoire_deep }};
    --lmm-ivoire-deep-rgb: {{ settings.lmm_ivoire_deep | color_extract: 'red' }}, {{ settings.lmm_ivoire_deep | color_extract: 'green' }}, {{ settings.lmm_ivoire_deep | color_extract: 'blue' }};
    --lmm-ivoire-line:   {{ settings.lmm_ivoire_line }};
    --lmm-ivoire-faint:  #A79F91;

    /* Types de texte — pilotés depuis Réglages du thème → La Maison M —
       Typographie. Le slogan et les citations gardent toujours une valeur
       plus grande que les titres de section (imposé par les min/max des
       curseurs dans settings_schema.json), pour ne jamais rivaliser avec
       le slogan principal du hero. */
    --lmm-fs-slogan:        {{ settings.lmm_fs_slogan }}px;
    --lmm-fs-quote:         {{ settings.lmm_fs_quote }}px;
    --lmm-fs-section-title: {{ settings.lmm_fs_section_title }}px;
    --lmm-fs-card-title:    {{ settings.lmm_fs_card_title }}px;
    --lmm-fs-number:        {{ settings.lmm_fs_number }}px;
    --lmm-fs-body:          {{ settings.lmm_fs_body }}px;
    --lmm-fs-label:         {{ settings.lmm_fs_label }}px;
  }

  /* Bouton d'action principal partagé — tous les boutons "continuer / ajouter au
     panier / confirmer" du site doivent utiliser cette seule classe pour rester
     visuellement identiques, peu importe la page. La variante claire du hero
     (fond photo) a son propre nom : .lmm-btn-hero-light, dans home-hero.liquid. */
  .lmm-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--lmm-text);
    color: #ffffff;
    border: none;
    padding: 16px 40px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: inherit;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .lmm-btn-primary:hover {
    opacity: 0.85;
  }
  .lmm-btn-primary:disabled,
  .lmm-btn-primary[disabled],
  .lmm-btn-primary.lmm-btn--inactive {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* ============================================================
     Système de design partagé — sur-mesure, collection, conseils
     stylistiques, panier, prise de rendez-vous. NE TOUCHE PAS à
     .lmm-btn-primary ci-dessus ni aux classes de home-hero.liquid
     (.lmm-hero__cta, .lmm-hero__cta-secondary) — la home page garde
     ses styles actuels tels quels. Les couleurs ci-dessous sont
     reprises telles quelles de ces boutons du hero (déjà approuvés),
     seul le rayon des coins diffère (0 partout ici, contre 8px sur
     le hero) et la taille est celle des boutons utilitaires du site
     (pas le grand format serif du hero).
     ============================================================ */

  .lmm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 40px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: inherit;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s ease, background 0.2s ease, color 0.2s ease;
  }
  .lmm-btn:disabled,
  .lmm-btn[disabled],
  .lmm-btn.is-disabled {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* Principal — même palette que .lmm-hero__cta (bordeaux/ivoire). */
  .lmm-btn-fill {
    background: var(--lmm-bordeaux);
    color: var(--lmm-ivoire-pale);
    border: none;
  }
  .lmm-btn-fill:hover { opacity: 0.85; }

  /* Secondaire — même palette que .lmm-hero__cta-secondary (contour
     foncé, se remplit au survol). */
  .lmm-btn-outline {
    background: transparent;
    color: var(--lmm-text);
    border: 1.5px solid var(--lmm-text);
  }
  .lmm-btn-outline:hover {
    background: var(--lmm-text);
    color: var(--lmm-ivoire);
  }

  /* Discret — actions mineures (retirer, annuler, modifier) : jamais
     l'action principale d'un écran, pas de fond ni de contour. */
  .lmm-btn-quiet {
    background: none;
    border: none;
    padding: 6px 0;
    color: var(--lmm-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .lmm-btn-quiet:hover { color: var(--lmm-text); }

  /* Typographie partagée — reprend les mêmes tailles/tons déjà utilisés
     partout (chaque section les redéfinissait individuellement avec un
     nom différent), pour que "titre", "étiquette", "corps de texte"
     restent identiques peu importe la page. */
  .lmm-eyebrow {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lmm-bordeaux);
  }
  .lmm-heading {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    color: var(--lmm-text);
    margin: 0;
  }
  .lmm-body-text {
    font-size: var(--lmm-fs-body);
    color: var(--lmm-muted);
    line-height: 1.7;
    font-weight: 300;
  }
  .lmm-field-label {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lmm-muted);
  }
{% endstyle %}
