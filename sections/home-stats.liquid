<section class="lmm-stats full-width">
  <div class="lmm-stats__inner">
    <div class="lmm-stats__layout">
      <div class="lmm-stats__title-col">
        <h2 class="lmm-stats__heading">{{ section.settings.section_title }}</h2>
      </div>

      <div class="lmm-stats__content-col">
        {% if section.settings.quote_text != blank %}
          <div class="lmm-stats__quote-block">
            <blockquote class="lmm-stats__quote">
              <p class="lmm-stats__quote-text">{{ section.settings.quote_text }}</p>
            </blockquote>
            {% if section.settings.quote_source != blank %}
              <p class="lmm-stats__quote-source">{{ section.settings.quote_source }}</p>
            {% endif %}
            {% if section.settings.quote_description != blank %}
              <button type="button" class="lmm-stats__quote-toggle" aria-expanded="false">
                <span>{{ section.settings.quote_toggle_label | default: "En savoir plus" }}</span>
                <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                  <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="lmm-stats__quote-description" hidden>
                <p class="lmm-stats__quote-description-text">{{ section.settings.quote_description }}</p>
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.quote2_text != blank %}
          <div class="lmm-stats__quote-block lmm-stats__quote-block--second">
            <blockquote class="lmm-stats__quote">
              <p class="lmm-stats__quote-text">{{ section.settings.quote2_text }}</p>
            </blockquote>
            {% if section.settings.quote2_source != blank %}
              <p class="lmm-stats__quote-source">{{ section.settings.quote2_source }}</p>
            {% endif %}
            {% if section.settings.quote2_description != blank %}
              <button type="button" class="lmm-stats__quote-toggle" aria-expanded="false">
                <span>{{ section.settings.quote_toggle_label | default: "En savoir plus" }}</span>
                <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                  <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="lmm-stats__quote-description" hidden>
                <p class="lmm-stats__quote-description-text">{{ section.settings.quote2_description }}</p>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('.lmm-stats__quote-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        var desc = btn.nextElementSibling;
        btn.setAttribute('aria-expanded', String(!expanded));
        if (!desc) return;
        if (expanded) {
          desc.setAttribute('hidden', '');
        } else {
          desc.removeAttribute('hidden');
        }
      });
    });
  })();

  // Garantie FIABLE à 100 % que le titre ne dépasse jamais la ligne de la
  // marge, SANS jamais couper un mot en deux — voir home-hero.liquid pour
  // le même mécanisme sur "Comment procéder".
  (function () {
    var title = document.querySelector('.lmm-stats__heading');
    if (!title) return;

    function fitTitle() {
      title.style.fontSize = '';
      var guard = 0;
      while (title.scrollWidth > title.clientWidth + 1 && guard < 40) {
        var current = parseFloat(getComputedStyle(title).fontSize);
        if (current <= 14) break;
        title.style.fontSize = (current - 1) + 'px';
        guard++;
      }
    }

    fitTitle();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(fitTitle);
    }
    window.addEventListener('load', fitTitle);

    var t;
    window.addEventListener('resize', function () {
      clearTimeout(t);
      t = setTimeout(fitTitle, 120);
    });
  })();
</script>

{% stylesheet %}
  /* Ivoire pâle — inversé avec "Pourquoi nous choisir" (maintenant en
     ivoire foncé) à la demande de Felix. Texte charcoal, comme les autres
     sections claires. */
  .lmm-stats {
    position: relative;
    background: var(--lmm-ivoire-pale);
  }

  /* Plein largeur (pas de max-width centré ici) — même approche que
     .lmm-plan__inner/.lmm-plan__layout dans home-hero.liquid : la
     colonne de titre reste collée au bord gauche à 56px, peu importe
     la largeur de l'écran, pour que la ligne de marge s'aligne
     exactement avec celle de "Comment procéder". Le contenu se centre
     PLUTÔT à l'intérieur de .lmm-stats__content-col (voir plus bas). */
  .lmm-stats__inner {
    width: 100%;
    padding: 90px 0;
  }

  .lmm-stats__layout {
    display: grid;
    grid-template-columns: clamp(170px, 15vw, 300px) 1fr;
    gap: 48px;
    padding: 0 40px 0 56px;
  }

  .lmm-stats__title-col {
    border-right: 1px solid var(--lmm-text);
    padding-right: 28px;
  }

  .lmm-stats__content-col {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lmm-stats__heading {
    text-align: center;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--lmm-fs-section-title);
    font-weight: 400;
    line-height: 1.3;
    color: var(--lmm-bordeaux);
    margin: 0;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  /* Citation vedette — centrée, prend toute la largeur de la section.
     Source toujours visible en dessous. La description (contexte de
     l'étude) est cachée par défaut, révélée au clic sur la flèche. */
  .lmm-stats__quote-block {
    max-width: 100%;
    text-align: center;
  }

  .lmm-stats__quote-block--second {
    margin-top: 64px;
    padding-top: 64px;
    border-top: 1px solid var(--lmm-ivoire-line);
  }

  .lmm-stats__quote {
    margin: 0 auto;
    padding: 0;
    border: none;
    max-width: 900px;
  }

  .lmm-stats__quote-text {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(28px, 3vw, var(--lmm-fs-quote));
    font-weight: 400;
    line-height: 1.45;
    color: var(--lmm-bordeaux);
    margin: 0;
  }

  /* Les 2 guillemets décoratifs sont maintenant de la même taille
     (Felix a signalé qu'ils étaient inégaux) et coulent dans le texte
     plutôt que d'être positionnés en absolu, pour rester bien centrés. */
  .lmm-stats__quote-text::before,
  .lmm-stats__quote-text::after {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.3em;
    color: var(--lmm-bordeaux);
  }

  .lmm-stats__quote-text::before {
    content: '\201C';
    margin-right: 1px;
  }

  .lmm-stats__quote-text::after {
    content: '\201D';
    margin-left: 1px;
  }

  .lmm-stats__quote-source {
    margin: 20px 0 0;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--lmm-muted);
  }

  .lmm-stats__quote-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 18px;
    background: none;
    border: none;
    padding: 6px 2px;
    font-size: 13px;
    letter-spacing: 0.03em;
    color: var(--lmm-bordeaux-soft);
    cursor: pointer;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .lmm-stats__quote-toggle svg {
    transition: transform 0.2s ease;
  }

  .lmm-stats__quote-toggle[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  .lmm-stats__quote-description {
    max-width: 640px;
    margin: 18px auto 0;
    text-align: left;
  }

  .lmm-stats__quote-description[hidden] {
    display: none;
  }

  .lmm-stats__quote-description-text {
    font-size: var(--lmm-fs-body);
    line-height: 1.85;
    color: var(--lmm-text);
    margin: 0;
  }

  @media (max-width: 900px) {
    .lmm-stats__layout {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 0 24px;
    }

    .lmm-stats__title-col {
      border-right: none;
      border-bottom: 1px solid var(--lmm-text);
      padding-right: 0;
      padding-bottom: 24px;
    }
  }

  @media (max-width: 767px) {
    .lmm-stats__heading {
      font-size: 26px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Statistiques",
  "settings": [
    { "type": "text", "id": "section_title", "label": "Titre de la section", "default": "Ce que la psychologie dit sur la première impression" },
    { "type": "text", "id": "quote_toggle_label", "label": "Texte du bouton \"en savoir plus\" (les 2 citations)", "default": "En savoir plus" },

    { "type": "header", "content": "Citation vedette 1 (permission requise)" },
    { "type": "paragraph", "content": "Ne pas publier tant que la permission de l'auteur (Oh, Shafir & Todorov) n'a pas été obtenue." },
    { "type": "textarea", "id": "quote_text", "label": "Citation (centrée, grande, bordeaux)" },
    { "type": "text", "id": "quote_source", "label": "Source complète (visible sous la citation)" },
    { "type": "textarea", "id": "quote_description", "label": "Description (cachée, révélée au clic sur la flèche)" },

    { "type": "header", "content": "Citation vedette 2 (permission requise)" },
    { "type": "paragraph", "content": "Ne pas publier tant que la permission de l'auteur (Willis & Todorov) n'a pas été obtenue." },
    { "type": "textarea", "id": "quote2_text", "label": "Citation (centrée, grande, bordeaux)" },
    { "type": "text", "id": "quote2_source", "label": "Source complète (visible sous la citation)" },
    { "type": "textarea", "id": "quote2_description", "label": "Description (cachée, révélée au clic sur la flèche)" }
  ],
  "presets": [
    { "name": "Statistiques" }
  ]
}
{% endschema %}
