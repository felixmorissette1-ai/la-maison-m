<section class="lmm-stats full-width">
  <div class="lmm-stats__inner">
    {% if section.settings.section_eyebrow != blank %}
      <p class="lmm-stats__eyebrow">{{ section.settings.section_eyebrow }}</p>
    {% endif %}
    <h2 class="lmm-stats__heading">{{ section.settings.section_title }}</h2>

    {% if section.settings.quote_text != blank %}
      <div class="lmm-stats__quote-wrap">
        {% if section.settings.quote_description != blank %}
          <div class="lmm-stats__quote-description">
            <p class="lmm-stats__quote-description-text">{{ section.settings.quote_description }}</p>
          </div>
        {% endif %}
        <blockquote class="lmm-stats__quote">
          <p class="lmm-stats__quote-text">{{ section.settings.quote_text }}</p>
        </blockquote>
      </div>
      {% if section.settings.quote_source != blank %}
        <p class="lmm-stats__quote-source">{{ section.settings.quote_source }}</p>
      {% endif %}
    {% endif %}

    {% if section.settings.quote2_text != blank %}
      <div class="lmm-stats__quote-wrap lmm-stats__quote-wrap--second">
        {% if section.settings.quote2_description != blank %}
          <div class="lmm-stats__quote-description">
            <p class="lmm-stats__quote-description-text">{{ section.settings.quote2_description }}</p>
          </div>
        {% endif %}
        <blockquote class="lmm-stats__quote">
          <p class="lmm-stats__quote-text">{{ section.settings.quote2_text }}</p>
        </blockquote>
      </div>
      {% if section.settings.quote2_source != blank %}
        <p class="lmm-stats__quote-source">{{ section.settings.quote2_source }}</p>
      {% endif %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  /* Ivoire pâle — inversé avec "Pourquoi nous choisir" (maintenant en
     ivoire foncé) à la demande de Felix. Texte charcoal, comme les autres
     sections claires. */
  .lmm-stats {
    position: relative;
    background: var(--lmm-ivoire-pale);
  }

  /* Fondu vers la couleur de la section suivante (Pourquoi nous
     choisir) plutôt qu'une coupure nette. */
  .lmm-stats::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30px;
    background: linear-gradient(to bottom, transparent, var(--lmm-ivoire-deep));
    pointer-events: none;
  }

  .lmm-stats__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 90px 32px;
  }

  .lmm-stats__eyebrow {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lmm-bordeaux-soft);
    margin: 0 0 12px;
  }

  .lmm-stats__heading {
    text-align: left;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--lmm-text);
    margin: 0 0 56px;
    max-width: 640px;
  }

  /* Citation vedette — description à gauche (plus petite, texte
     courant), citation en gros à droite (bordeaux, gros guillemets
     décoratifs). Une seule mention de source (complète), sous les
     deux colonnes, pour ne pas la dupliquer. */
  .lmm-stats__quote-wrap {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    column-gap: 56px;
    align-items: center;
  }

  .lmm-stats__quote-description-text {
    font-size: 15px;
    line-height: 1.7;
    color: var(--lmm-text);
    margin: 0;
  }

  .lmm-stats__quote {
    margin: 0;
    padding: 0;
    border: none;
  }

  .lmm-stats__quote-text {
    position: relative;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(24px, 2.6vw, 34px);
    font-weight: 400;
    line-height: 1.4;
    color: var(--lmm-bordeaux);
    margin: 0;
    padding-left: 46px;
  }

  .lmm-stats__quote-text::before {
    content: '\201C';
    position: absolute;
    left: -6px;
    top: -0.28em;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 2.6em;
    line-height: 1;
    color: var(--lmm-bordeaux);
  }

  .lmm-stats__quote-text::after {
    content: '\201D';
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.3em;
    color: var(--lmm-bordeaux);
  }

  .lmm-stats__quote-source {
    margin: 24px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--lmm-ivoire-line);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--lmm-muted);
  }

  .lmm-stats__quote-wrap--second {
    margin-top: 56px;
    padding-top: 56px;
    border-top: 1px solid var(--lmm-ivoire-line);
  }

  @media (max-width: 767px) {
    .lmm-stats__heading {
      font-size: 22px;
    }

    .lmm-stats__quote-wrap {
      grid-template-columns: 1fr;
      row-gap: 28px;
    }

    .lmm-stats__quote-text,
    .lmm-stats__quote-text::before {
      padding-left: 30px;
    }
    .lmm-stats__quote-text::before {
      font-size: 2.1em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Statistiques",
  "settings": [
    { "type": "text", "id": "section_eyebrow", "label": "Petit mot-clé au-dessus du titre", "default": "Recherche" },
    { "type": "text", "id": "section_title", "label": "Titre de la section", "default": "Ce que la psychologie dit sur la première impression" },

    { "type": "header", "content": "Citation vedette 1 (permission requise)" },
    { "type": "paragraph", "content": "Ne pas publier tant que la permission de l'auteur (Oh, Shafir & Todorov) n'a pas été obtenue." },
    { "type": "textarea", "id": "quote_description", "label": "Description (colonne gauche)" },
    { "type": "textarea", "id": "quote_text", "label": "Citation (colonne droite, grande, bordeaux)" },
    { "type": "text", "id": "quote_source", "label": "Source complète (une seule mention, sous les 2 colonnes)" },

    { "type": "header", "content": "Citation vedette 2 (permission requise)" },
    { "type": "paragraph", "content": "Ne pas publier tant que la permission de l'auteur (Willis & Todorov) n'a pas été obtenue." },
    { "type": "textarea", "id": "quote2_description", "label": "Description (colonne gauche)" },
    { "type": "textarea", "id": "quote2_text", "label": "Citation (colonne droite, grande, bordeaux)" },
    { "type": "text", "id": "quote2_source", "label": "Source complète (une seule mention, sous les 2 colonnes)" }
  ],
  "presets": [
    { "name": "Statistiques" }
  ]
}
{% endschema %}
