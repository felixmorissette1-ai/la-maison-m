<section class="lmm-stats full-width">
  <div class="lmm-stats__inner">
    <h2 class="lmm-stats__heading">{{ section.settings.section_title }}</h2>

    <div class="lmm-stats__row">
      <div class="lmm-stats__card">
        <p class="lmm-stats__finding">{{ section.settings.stat1_finding }}</p>
        <p class="lmm-stats__source">{{ section.settings.stat1_source }}</p>
      </div>
      <div class="lmm-stats__card">
        <p class="lmm-stats__finding">{{ section.settings.stat2_finding }}</p>
        <p class="lmm-stats__source">{{ section.settings.stat2_source }}</p>
      </div>
      <div class="lmm-stats__card">
        <p class="lmm-stats__finding">{{ section.settings.stat3_finding }}</p>
        <p class="lmm-stats__source">{{ section.settings.stat3_source }}</p>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  /* Essai : fond bordeaux tamisé (--lmm-bordeaux-muted), même famille que
     le header mais désaturé — pour distinguer cette section des sections
     claires qui l'entourent. Section volontairement vide de vrai contenu
     pour l'instant (voir schéma : les valeurs par défaut sont des
     espaces réservés) — la structure sert juste à visualiser la mise en
     page en attendant les vraies statistiques. */
  .lmm-stats {
    background: var(--lmm-bordeaux-muted);
    border-top: 1px solid rgba(var(--lmm-ivoire-rgb), 0.12);
  }

  .lmm-stats__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 90px 32px;
  }

  .lmm-stats__heading {
    text-align: left;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--lmm-ivoire);
    margin: 0 0 56px;
    max-width: 640px;
  }

  .lmm-stats__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 28px;
    row-gap: 28px;
    align-items: stretch;
  }

  .lmm-stats__card {
    box-sizing: border-box;
    border: 1px solid rgba(var(--lmm-ivoire-rgb), 0.18);
    border-radius: 10px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
  }

  .lmm-stats__finding {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--lmm-ivoire);
    margin: 0;
  }

  .lmm-stats__source {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: rgba(var(--lmm-ivoire-rgb), 0.65);
    margin: 0;
  }

  @media (max-width: 767px) {
    .lmm-stats__heading {
      font-size: 28px;
    }

    .lmm-stats__row {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Statistiques",
  "settings": [
    { "type": "text", "id": "section_title", "label": "Titre de la section", "default": "Ce que la science dit sur la première impression" },

    { "type": "header", "content": "Statistique 1 (espace réservé — à remplir)" },
    { "type": "textarea", "id": "stat1_finding", "label": "Constat", "default": "Statistique à venir — contenu à ajouter." },
    { "type": "text", "id": "stat1_source", "label": "Source", "default": "Source à venir" },

    { "type": "header", "content": "Statistique 2 (espace réservé — à remplir)" },
    { "type": "textarea", "id": "stat2_finding", "label": "Constat", "default": "Statistique à venir — contenu à ajouter." },
    { "type": "text", "id": "stat2_source", "label": "Source", "default": "Source à venir" },

    { "type": "header", "content": "Statistique 3 (espace réservé — à remplir)" },
    { "type": "textarea", "id": "stat3_finding", "label": "Constat", "default": "Statistique à venir — contenu à ajouter." },
    { "type": "text", "id": "stat3_source", "label": "Source", "default": "Source à venir" }
  ],
  "presets": [
    { "name": "Statistiques" }
  ]
}
{% endschema %}
