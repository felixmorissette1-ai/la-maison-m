<footer class="lmm-footer full-width">
  <div class="lmm-footer__inner">

    <div class="lmm-footer__col lmm-footer__brand">
      <span class="lmm-footer__logo">La Maison M.</span>
      <span class="lmm-footer__logo-sub">Tailleur sur mesure</span>
      {% if section.settings.tagline != blank %}
        <p class="lmm-footer__tagline">{{ section.settings.tagline }}</p>
      {% endif %}
    </div>

    <div class="lmm-footer__col">
      <h3 class="lmm-footer__heading">{{ section.settings.about_heading }}</h3>
      <ul class="lmm-footer__links">
        <li><a href="{{ section.settings.qui_sommes_url | default: '/pages/qui-nous-sommes' }}">{{ section.settings.qui_sommes_label }}</a></li>
        <li><a href="{{ section.settings.comment_url | default: '/pages/comment-ca-fonctionne' }}">{{ section.settings.comment_label }}</a></li>
      </ul>
    </div>

    <div class="lmm-footer__col">
      <h3 class="lmm-footer__heading">{{ section.settings.magasine_heading }}</h3>
      <ul class="lmm-footer__links">
        <li><a href="{{ section.settings.personnalise_url | default: '/pages/sur-mesure' }}">{{ section.settings.personnalise_label }}</a></li>
        <li><a href="{{ section.settings.collection_url | default: '/collections/frontpage' }}">{{ section.settings.collection_label }}</a></li>
        <li><a href="{{ section.settings.chemise_url | default: '/collections/chemises' }}">{{ section.settings.chemise_label }}</a></li>
      </ul>
    </div>

    <div class="lmm-footer__col">
      <h3 class="lmm-footer__heading">{{ section.settings.partenaires_heading }}</h3>
      <ul class="lmm-footer__links">
        <li><a href="{{ section.settings.couturieres_url | default: 'https://lmm-backend.vercel.app/mensurations.html' }}" target="_blank" rel="noopener">{{ section.settings.couturieres_label }}</a></li>
        <li><a href="{{ section.settings.ambassadeurs_url | default: 'https://lmm-backend.vercel.app/ambassadeur.html' }}" target="_blank" rel="noopener">{{ section.settings.ambassadeurs_label }}</a></li>
        <li><a href="{{ section.settings.devenir_partenaire_url | default: '/pages/devenir-partenaire' }}">{{ section.settings.devenir_partenaire_label }}</a></li>
      </ul>
    </div>

    <div class="lmm-footer__col lmm-footer__contact">
      <h3 class="lmm-footer__heading">{{ section.settings.contact_heading }}</h3>
      {% if section.settings.contact_address != blank %}
        <p class="lmm-footer__contact-line">{{ section.settings.contact_address }}</p>
      {% endif %}
      {% if section.settings.contact_phone != blank %}
        <p class="lmm-footer__contact-line"><a href="tel:{{ section.settings.contact_phone | remove: ' ' }}">{{ section.settings.contact_phone }}</a></p>
      {% endif %}
      {% if section.settings.contact_email != blank %}
        <p class="lmm-footer__contact-line"><a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a></p>
      {% endif %}
      {% if section.settings.contact_hours != blank %}
        <div class="lmm-footer__hours">{{ section.settings.contact_hours }}</div>
      {% endif %}
    </div>

  </div>

  <div class="lmm-footer__bottom">
    <div class="lmm-footer__copyright">
      &copy;
      {{ 'now' | date: '%Y' }}
      {{ shop.name | link_to: routes.root_url }}
    </div>

    <div class="lmm-footer__payment">
      {% if section.settings.show_payment_icons %}
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .lmm-footer {
    background: var(--lmm-bordeaux);
    color: rgba(var(--lmm-ivoire-rgb), 0.65);
  }

  .lmm-footer__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 56px 32px 40px;
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr 1.1fr;
    gap: 28px;
  }

  .lmm-footer__logo {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 20px;
    color: var(--lmm-ivoire-pale);
    letter-spacing: 0.04em;
  }

  .lmm-footer__logo-sub {
    display: block;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lmm-bordeaux-pale);
    margin-top: 3px;
  }

  .lmm-footer__tagline {
    font-size: 12px;
    line-height: 1.6;
    margin: 12px 0 0;
    max-width: 32ch;
  }

  .lmm-footer__heading {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lmm-ivoire-deep);
    font-weight: 400;
    margin: 0 0 16px;
  }

  .lmm-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .lmm-footer__links a {
    text-decoration: none;
    color: var(--lmm-ivoire-pale);
    font-size: 12px;
    letter-spacing: 0.02em;
    transition: color 0.2s;
  }

  .lmm-footer__links a:hover {
    color: var(--lmm-white);
  }

  .lmm-footer__contact-line {
    font-size: 12px;
    line-height: 1.7;
    margin: 0 0 6px;
  }

  .lmm-footer__contact-line a {
    color: var(--lmm-ivoire-pale);
    text-decoration: none;
    transition: color 0.2s;
  }

  .lmm-footer__contact-line a:hover {
    color: var(--lmm-white);
  }

  .lmm-footer__hours {
    font-size: 12px;
    line-height: 1.7;
    margin-top: 8px;
    color: rgba(var(--lmm-ivoire-rgb), 0.65);
  }

  .lmm-footer__bottom {
    max-width: 1280px;
    margin: 0 auto;
    padding: 20px 32px 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .lmm-footer__copyright {
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .lmm-footer__copyright a {
    color: rgba(var(--lmm-ivoire-rgb), 0.65);
    text-decoration: none;
  }

  .lmm-footer__payment {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .lmm-footer__payment svg {
    height: 20px;
    width: auto;
  }

  @media (max-width: 860px) {
    .lmm-footer__inner {
      grid-template-columns: 1fr 1fr;
      padding: 40px 24px 24px;
      gap: 28px;
    }
  }

  @media (max-width: 540px) {
    .lmm-footer__inner {
      grid-template-columns: 1fr;
      padding: 32px 20px 20px;
    }
    .lmm-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      padding: 16px 20px 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline (sous le nom)", "default": "Complets sur mesure, faits à la main." },

    { "type": "header", "content": "À propos" },
    { "type": "text", "id": "about_heading", "label": "Titre de la colonne", "default": "À propos" },
    { "type": "text", "id": "qui_sommes_label", "label": "Texte du lien — Qui nous sommes", "default": "Qui nous sommes" },
    { "type": "url", "id": "qui_sommes_url", "label": "Lien — Qui nous sommes (vide = /pages/qui-nous-sommes)" },
    { "type": "text", "id": "comment_label", "label": "Texte du lien — Comment ça fonctionne", "default": "Comment ça fonctionne" },
    { "type": "url", "id": "comment_url", "label": "Lien — Comment ça fonctionne (vide = /pages/comment-ca-fonctionne)" },

    { "type": "header", "content": "Magasiner" },
    { "type": "text", "id": "magasine_heading", "label": "Titre de la colonne", "default": "Magasiner" },
    { "type": "text", "id": "personnalise_label", "label": "Texte du lien — Personnalisé", "default": "Personnalisé" },
    { "type": "url", "id": "personnalise_url", "label": "Lien — Personnalisé (vide = /pages/sur-mesure)" },
    { "type": "text", "id": "collection_label", "label": "Texte du lien — Collection", "default": "Collection" },
    { "type": "url", "id": "collection_url", "label": "Lien — Collection (vide = /collections/frontpage)" },
    { "type": "text", "id": "chemise_label", "label": "Texte du lien — Chemise", "default": "Chemise" },
    { "type": "url", "id": "chemise_url", "label": "Lien — Chemise (vide = /collections/chemises)" },

    { "type": "header", "content": "Partenaires" },
    { "type": "text", "id": "partenaires_heading", "label": "Titre de la colonne", "default": "Partenaires" },
    { "type": "text", "id": "couturieres_label", "label": "Texte du lien — Tailleurs", "default": "Tailleurs" },
    { "type": "url", "id": "couturieres_url", "label": "Lien — Tailleurs (vide = portail par défaut)" },
    { "type": "text", "id": "ambassadeurs_label", "label": "Texte du lien — Ambassadeurs", "default": "Ambassadeurs" },
    { "type": "url", "id": "ambassadeurs_url", "label": "Lien — Ambassadeurs (vide = portail par défaut)" },
    { "type": "text", "id": "devenir_partenaire_label", "label": "Texte du lien — Devenir un partenaire", "default": "Devenir un partenaire" },
    { "type": "url", "id": "devenir_partenaire_url", "label": "Lien — Devenir un partenaire (vide = /pages/devenir-partenaire)" },

    { "type": "header", "content": "Contact" },
    { "type": "text", "id": "contact_heading", "label": "Titre de la colonne", "default": "Contact" },
    { "type": "textarea", "id": "contact_address", "label": "Adresse" },
    { "type": "text", "id": "contact_phone", "label": "Téléphone" },
    { "type": "text", "id": "contact_email", "label": "Courriel" },
    { "type": "richtext", "id": "contact_hours", "label": "Heures d'ouverture" },

    { "type": "checkbox", "id": "show_payment_icons", "label": "t:labels.show_payment_icons", "default": true }
  ]
}
{% endschema %}
