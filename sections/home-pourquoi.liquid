{% stylesheet %}
  /* Le fond est posé sur la <section> elle-même (comme .lmm-plan) pour
     couvrir toute la largeur de l'écran — .lmm-why__inner ne fait que
     centrer le contenu à 1180px, il ne doit jamais porter de background.
     Une seule couleur pour toute la section plutôt qu'une alternance
     interne : le rythme visuel vient de l'alternance gauche/droite des
     boîtes, la couleur sert à distinguer cette section des suivantes. */
  .lmm-why {
    /* Ivoire foncé — inversé avec Statistiques (maintenant en ivoire
       pâle) à la demande de Felix. */
    background: var(--lmm-ivoire-deep);
  }

  .lmm-why__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 90px 32px 50px;
  }

  /* Titre principal, aligné à gauche — sert de gabarit pour les titres
     des prochaines sections de la page. Poids normal (pas de gras) et
     plus petit que le slogan du hero (clamp 24-44px) : un titre de
     section ne doit jamais rivaliser en taille avec le slogan. */
  .lmm-why__heading {
    text-align: left;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 34px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--lmm-text);
    margin: 0 0 56px;
    max-width: 640px;
  }

  .lmm-why__row {
    display: flex;
    align-items: center;
    gap: 64px;
    padding: 40px 0;
  }

  .lmm-why__media,
  .lmm-why__box {
    flex: 1;
    min-width: 0;
  }

  .lmm-why__placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--lmm-ivoire-line);
    border-radius: 10px;
  }

  .lmm-why__img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
  }

  /* Photo générique en attendant les vraies photos de chaque
     caractéristique — même traitement (couleur) que la photo du hero,
     pour rester visuellement cohérent avec le haut de la page. */
  .lmm-why__img--placeholder {
    filter: grayscale(0.55) sepia(0.35) brightness(1.18) contrast(0.86) saturate(0.85);
  }

  .lmm-why__num {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 34px;
    font-weight: 400;
    color: var(--lmm-bordeaux);
    margin: 0 0 6px;
  }

  /* Le sous-titre porte le nom exact de la caractéristique (par
     opposition au titre, plus évocateur) — en gras et dans le rouge de
     la marque pour qu'il se distingue clairement du reste du texte. */
  .lmm-why__subtitle {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lmm-bordeaux-soft);
    margin: 0 0 10px;
  }

  .lmm-why__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 30px;
    font-weight: 400;
    color: var(--lmm-text);
    margin: 0 0 16px;
    line-height: 1.3;
  }

  .lmm-why__text {
    font-size: 18px;
    line-height: 1.85;
    color: var(--lmm-muted);
    margin: 0;
    max-width: 420px;
  }

  @media (max-width: 767px) {
    .lmm-why__row {
      flex-direction: column;
      gap: 28px;
      padding: 48px 24px;
    }

    .lmm-why__heading {
      font-size: 26px;
    }
  }
{% endstylesheet %}

{% schema %}
