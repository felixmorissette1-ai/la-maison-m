{% stylesheet %}
  .lmm-why__row {
    display: flex;
    align-items: center;
    gap: 64px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 76px 32px;
  }

  .lmm-why__row--pale {
    background: var(--lmm-ivoire);
  }

  .lmm-why__row--dark {
    background: var(--lmm-ivoire-deep);
  }

  /* Le fond doit s'étendre sur toute la largeur de l'écran mais le
     contenu reste centré à 1180px — chaque rangée est donc elle-même
     "full-width" via un fond appliqué à 100vw par un pseudo-élément
     n'est pas nécessaire ici : le fond est simplement posé sur la
     rangée elle-même qui a déjà width:100% (comportement par défaut
     d'un enfant direct de .full-width). */
  .lmm-why__media,
  .lmm-why__box {
    flex: 1;
    min-width: 0;
  }

  .lmm-why__placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--lmm-ivoire-line);
    border-radius: 10px;
  }

  .lmm-why__img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
  }

  .lmm-why__subtitle {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lmm-bordeaux-soft);
    margin: 0 0 10px;
  }

  .lmm-why__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 26px;
    font-weight: 400;
    color: var(--lmm-text);
    margin: 0 0 16px;
    line-height: 1.3;
  }

  .lmm-why__text {
    font-size: 15px;
    line-height: 1.65;
    color: var(--lmm-muted);
    margin: 0;
    max-width: 420px;
  }

  @media (max-width: 767px) {
    .lmm-why__row {
      flex-direction: column;
      gap: 28px;
      padding: 48px 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pourquoi nous choisir",
  "settings": [
    { "type": "header", "content": "Caractéristique 1" },
    { "type": "text", "id": "item1_subtitle", "label": "Sous-titre", "default": "Un veston sur mesure" },
    { "type": "text", "id": "item1_title", "label": "Titre", "default": "Un fit qui vous donne toute votre liberté" },
    { "type": "textarea", "id": "item1_text", "label": "Texte", "default": "Chaque complet est taillé sur vos mensurations exactes, pour un veston qui tombe bien et une liberté de mouvement que le prêt-à-porter ne permet pas." },
    { "type": "image_picker", "id": "item1_image", "label": "Image (laisser vide pour un espace réservé)" },

    { "type": "header", "content": "Caractéristique 2" },
    { "type": "text", "id": "item2_subtitle", "label": "Sous-titre", "default": "Coutures critiques cousues à la main" },
    { "type": "text", "id": "item2_title", "label": "Titre", "default": "Des coutures pensées pour bouger" },
    { "type": "textarea", "id": "item2_text", "label": "Texte", "default": "Plus souples qu'une couture machine, pour un confort qui dure toute la journée." },
    { "type": "image_picker", "id": "item2_image", "label": "Image (laisser vide pour un espace réservé)" },

    { "type": "header", "content": "Caractéristique 3" },
    { "type": "text", "id": "item3_subtitle", "label": "Sous-titre", "default": "Tissus 100% naturels" },
    { "type": "text", "id": "item3_title", "label": "Titre", "default": "Rien que des tissus nobles" },
    { "type": "textarea", "id": "item3_text", "label": "Texte", "default": "Nous travaillons uniquement avec des matières naturelles, gage de crédibilité : plus belles, plus durables, et qui respirent mieux." },
    { "type": "image_picker", "id": "item3_image", "label": "Image (laisser vide pour un espace réservé)" },

    { "type": "header", "content": "Caractéristique 4" },
    { "type": "text", "id": "item4_subtitle", "label": "Sous-titre", "default": "Mesures à domicile et retouches gratuites" },
    { "type": "text", "id": "item4_title", "label": "Titre", "default": "Un accompagnement qui inspire confiance" },
    { "type": "textarea", "id": "item4_text", "label": "Texte", "default": "Vos mensurations sont prises par un professionnel près de chez vous, du début à la fin, la confiance d'un vrai savoir-faire, pas un service impersonnel." },
    { "type": "image_picker", "id": "item4_image", "label": "Image (laisser vide pour un espace réservé)" },

    { "type": "header", "content": "Caractéristique 5" },
    { "type": "text", "id": "item5_subtitle", "label": "Sous-titre", "default": "Tout en ligne, couturière compétente près de chez vous" },
    { "type": "text", "id": "item5_title", "label": "Titre", "default": "Sans friction, du début à la fin" },
    { "type": "textarea", "id": "item5_text", "label": "Texte", "default": "Configurez, commandez et payez en ligne en quelques clics, puis une couturière compétente, à proximité, s'occupe de vos mensurations et de vos retouches. Aucun casse-tête, aucun détour." },
    { "type": "image_picker", "id": "item5_image", "label": "Image (laisser vide pour un espace réservé)" }
  ],
  "presets": [
    { "name": "Pourquoi nous choisir" }
  ]
}
{% endschema %}
