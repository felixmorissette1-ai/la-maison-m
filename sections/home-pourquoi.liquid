    { "type": "textarea", "id": "item2_text", "label": "Texte", "default": "Chaque complet est taillé sur vos mensurations exactes, pour un veston qui tombe bien et une liberté de mouvement que le prêt-à-porter ne permet pas." },
    { "type": "image_picker", "id": "item2_image", "label": "Image (laisser vide pour un espace réservé)" },

