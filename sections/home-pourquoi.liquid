    { "type": "text", "id": "item5_subtitle", "label": "Sous-titre", "default": "Mesures à domicile et retouches gratuites" },
    { "type": "text", "id": "item5_title", "label": "Titre", "default": "Un accompagnement qui inspire confiance" },
    { "type": "textarea", "id": "item5_text", "label": "Texte", "default": "Vos mensurations sont prises par un professionnel près de chez vous, du début à la fin. La confiance d'un vrai savoir-faire, pas un service impersonnel." },
    { "type": "image_picker", "id": "item5_image", "label": "Image (laisser vide pour un espace réservé)" }
  ],
  "presets": [
