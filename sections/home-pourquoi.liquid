        <img src="{{ section.settings.item3_image | image_url: width: 900 }}" alt="" class="lmm-why__img" loading="lazy">
      {% else %}
        <div class="lmm-why__placeholder"></div>
      {% endif %}
    </div>
    <div class="lmm-why__box">
      <p class="lmm-why__subtitle">{{ section.settings.item3_subtitle }}</p>
      <h3 class="lmm-why__title">{{ section.settings.item3_title }}</h3>
      <p class="lmm-why__text">{{ section.settings.item3_text }}</p>
    </div>
  </div>

  <div class="lmm-why__row lmm-why__row--dark">
    <div class="lmm-why__box">
      <p class="lmm-why__subtitle">{{ section.settings.item4_subtitle }}</p>
