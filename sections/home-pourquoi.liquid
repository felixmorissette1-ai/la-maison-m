<script>
  // Garantie FIABLE à 100 % que le titre ne dépasse jamais la ligne de la
  // marge, SANS jamais couper un mot en deux — voir home-hero.liquid pour
  // le même mécanisme sur "Comment procéder".
  (function () {
    var title = document.querySelector('.lmm-why__heading');
    if (!title) return;

    function fitTitle() {
      title.style.fontSize = '';
      var guard = 0;
      while (title.scrollWidth > title.clientWidth + 1 && guard < 40) {
        var current = parseFloat(getComputedStyle(title).fontSize);
        if (current <= 14) break;
        title.style.fontSize = (current - 1) + 'px';
        guard++;
      }
    }

    fitTitle();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(fitTitle);
    }
    window.addEventListener('load', fitTitle);

    var t;
    window.addEventListener('resize', function () {
      clearTimeout(t);
      t = setTimeout(fitTitle, 120);
    });
  })();
</script>

{% stylesheet %}
  /* Le fond est posé sur la <section> elle-même (comme .lmm-plan) pour
     couvrir toute la largeur de l'écran — .lmm-why__inner ne fait que
     centrer le contenu à 1180px, il ne doit jamais porter de background.
     Une seule couleur pour toute la section plutôt qu'une alternance
     interne : le rythme visuel vient de l'alternance gauche/droite des
     boîtes, la couleur sert à distinguer cette section des suivantes. */
  .lmm-why {
    /* Ivoire foncé — inversé avec Statistiques (maintenant en ivoire
       pâle) à la demande de Felix. */
    background: var(--lmm-ivoire-deep);
  }

  /* Plein largeur (pas de max-width centré ici) — même approche que
     .lmm-plan__inner/.lmm-plan__layout dans home-hero.liquid : la
     colonne de titre reste collée au bord gauche à 56px, peu importe
     la largeur de l'écran, pour que la ligne de marge s'aligne
     exactement avec celle de "Comment procéder". Le contenu se centre
     PLUTÔT à l'intérieur de .lmm-why__content-col (voir plus bas). */
  .lmm-why__inner {
    width: 100%;
    padding: 90px 0 50px;
  }

  .lmm-why__layout {
    display: grid;
    grid-template-columns: clamp(170px, 15vw, 300px) 1fr;
    gap: 48px;
    padding: 0 40px 0 56px;
  }

  .lmm-why__title-col {
    border-right: 1px solid var(--lmm-text);
    padding-right: 28px;
  }

  .lmm-why__content-col {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lmm-why__heading {
    text-align: center;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--lmm-fs-section-title);
    font-weight: 400;
    line-height: 1.3;
    color: var(--lmm-bordeaux);
    margin: 0;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .lmm-why__row {
    width: 100%;
    max-width: 1200px;
    display: flex;
    align-items: center;
    gap: 64px;
    padding: 40px 0;
  }

  .lmm-why__media,
  .lmm-why__box {
    flex: 1;
    min-width: 0;
  }

  .lmm-why__placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--lmm-ivoire-line);
    border-radius: 10px;
  }

  .lmm-why__img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
  }

  /* Photo générique en attendant les vraies photos de chaque
     caractéristique — même traitement (couleur) que la photo du hero,
     pour rester visuellement cohérent avec le haut de la page. */
  .lmm-why__img--placeholder {
    filter: grayscale(0.55) sepia(0.35) brightness(1.18) contrast(0.86) saturate(0.85);
  }

  .lmm-why__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--lmm-fs-card-title);
    font-weight: 400;
    color: var(--lmm-bordeaux);
    margin: 0 0 16px;
    line-height: 1.3;
  }

  .lmm-why__text {
    font-size: var(--lmm-fs-body);
    line-height: 1.85;
    color: var(--lmm-text);
    margin: 0;
    max-width: 420px;
  }

  @media (max-width: 900px) {
    .lmm-why__layout {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 0 24px;
    }

    .lmm-why__title-col {
      border-right: none;
      border-bottom: 1px solid var(--lmm-text);
      padding-right: 0;
      padding-bottom: 24px;
    }
  }

  @media (max-width: 767px) {
    .lmm-why__row {
      flex-direction: column;
      gap: 28px;
      padding: 48px 24px;
    }

    .lmm-why__heading {
      font-size: 26px;
    }
  }
{% endstylesheet %}

