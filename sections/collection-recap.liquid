{% comment %} Récapitulatif — Collection La Maison M. {% endcomment %}
{% render 'fil-ariane-collection', etape_active: 6 %}

<style>
  .lmm-recap-wrap { width: 90%; max-width: 900px; margin: 0 auto; padding: 40px 0 60px; }
  .lmm-recap__header { margin-bottom: 48px; }
  .lmm-recap__title { font-family: Georgia, serif; font-size: 36px; font-weight: 400; color: var(--lmm-text); margin-bottom: 12px; }
  .lmm-recap__sub { font-size: 14px; color: var(--lmm-muted); font-weight: 300; line-height: 1.7; }
  .lmm-recap__table { border-top: 1px solid var(--lmm-border); margin-bottom: 48px; }
  .lmm-recap__row { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--lmm-border); }
  .lmm-recap__key { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--lmm-muted); }
  .lmm-recap__val { font-size: 15px; color: var(--lmm-text); font-family: Georgia, serif; }
  .lmm-recap__total { display: flex; justify-content: space-between; align-items: baseline; background: var(--lmm-ivoire-deep); padding: 20px 24px; margin-bottom: 32px; }
  .lmm-recap__total-label { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--lmm-text); }
  .lmm-recap__total-price { font-family: Georgia, serif; font-size: 32px; color: var(--lmm-text); }
  .lmm-recap__nav { display: flex; gap: 12px; align-items: center; }
  .lmm-recap__btn-add { padding: 20px 56px; font-size: 13px; }
  .lmm-recap__error { color: var(--lmm-error); font-size: 12px; margin-top: 12px; display: none; }
</style>

<div class="lmm-recap-wrap">
  <div class="lmm-recap__header">
    <p class="lmm-label" style="color:var(--lmm-bordeaux); margin-bottom:12px;">Sur mesure — Récapitulatif</p>
    <h1 class="lmm-recap__title">Votre commande</h1>
    <p class="lmm-recap__sub">Vérifiez vos choix avant d'ajouter au panier.</p>
  </div>

  <div class="lmm-recap__table">
    <div class="lmm-recap__row"><span class="lmm-recap__key">Modèle</span><span class="lmm-recap__val" id="r-modele">—</span></div>
    <div class="lmm-recap__row"><span class="lmm-recap__key">Construction</span><span class="lmm-recap__val" id="r-canva">—</span></div>
    <div class="lmm-recap__row"><span class="lmm-recap__key">Pièces</span><span class="lmm-recap__val" id="r-pieces">—</span></div>
    <div class="lmm-recap__row"><span class="lmm-recap__key">Bas de pantalon</span><span class="lmm-recap__val" id="r-bas">—</span></div>
    <div class="lmm-recap__row"><span class="lmm-recap__key">Hauteur du pantalon</span><span class="lmm-recap__val" id="r-hauteur">—</span></div>
    <div class="lmm-recap__row" id="r-mono-row" style="display:none;"><span class="lmm-recap__key">Monogramme</span><span class="lmm-recap__val" id="r-mono">—</span></div>
  </div>

  <div class="lmm-recap__total">
    <span class="lmm-recap__total-label">Prix de base</span>
    <span class="lmm-recap__total-price" id="r-prix">—</span>
  </div>

  <div class="lmm-recap__nav">
    <button class="lmm-btn lmm-btn-fill lmm-recap__btn-add" onclick="ajouterAuPanier()">Ajouter au panier</button>
  </div>
  <p class="lmm-recap__error" id="recap-erreur">Une erreur est survenue. Veuillez réessayer.</p>
</div>

<script>
  var params = new URLSearchParams(window.location.search);
  var canvaChoisi = params.get('canva');

  document.getElementById('r-modele').textContent = params.get('modele_nom') || params.get('modele') || '—';
  document.getElementById('r-canva').textContent = params.get('canva_nom') || '—';
  document.getElementById('r-pieces').textContent = params.get('pieces') || '—';
  document.getElementById('r-bas').textContent = params.get('bas') || '—';
  document.getElementById('r-hauteur').textContent = params.get('hauteur') || '—';

  var monogramme = params.get('monogramme') || '';
  var prixMonogrammeCents = {{ section.settings.prix_monogramme | default: 0 }};
  if (monogramme) {
    document.getElementById('r-mono-row').style.display = 'flex';
    document.getElementById('r-mono').textContent = monogramme + (prixMonogrammeCents ? ' (+$' + (prixMonogrammeCents / 100).toLocaleString('fr-CA', { minimumFractionDigits: 2 }) + ')' : '');
  }

  // Supplément 3 pièces (gilet) — dépend du produit (metafield
  // custom.supplement_3_pieces, en dollars), appliqué seulement si "3
  // pièces" est choisi. Pour l'aperçu seulement — le vrai montant facturé
  // est recalculé côté serveur dans handleCollectionCheckout.
  var pieces3PiecesCents = params.get('pieces') === '3 pièces'
    ? Math.round((parseFloat(params.get('p3pieces')) || 0) * 100)
    : 0;

  var prixCents = parseInt(params.get('prix') || '0') + pieces3PiecesCents + (monogramme ? prixMonogrammeCents : 0);
  var prixFormate = prixCents ? '$' + (prixCents / 100).toLocaleString('fr-CA', { minimumFractionDigits: 2 }) : '—';
  document.getElementById('r-prix').textContent = prixFormate;

  // Le prix affiché tient compte du supplément de construction choisi
  // (voir page-canva.liquid), mais aucune variante Shopify réelle n'existe
  // pour ce prix ajusté (chaque produit n'a qu'une seule variante, au prix
  // de la construction recommandée) — le serveur recalcule le vrai total à
  // partir du produit réel et de ses metafields de supplément (jamais le
  // prix envoyé par le navigateur), voir handleCollectionCheckout dans
  // couturiere-actions.js.
  function ajouterAuPanier() {
    var btn = document.querySelector('.lmm-recap__btn-add');
    var original = btn.textContent;
    btn.textContent = 'Ajout au panier…';
    btn.disabled = true;
    document.getElementById('recap-erreur').style.display = 'none';

    fetch('https://lmm-backend.vercel.app/api/couturiere-actions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        action: 'collection-checkout',
        modele: params.get('modele') || '',
        canva: canvaChoisi || '',
        canva_nom: params.get('canva_nom') || '',
        pieces: params.get('pieces') || '',
        bas: params.get('bas') || '',
        hauteur: params.get('hauteur') || '',
        monogramme: monogramme,
        monogramme_prix: prixMonogrammeCents
      })
    })
    .then(function(res) { return res.json().then(function(d) { return { ok: res.ok, d: d }; }); })
    .then(function(res) {
      if (!res.ok) throw new Error(res.d.error || 'Erreur');
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: res.d.variant_id, quantity: res.d.quantity, properties: res.d.properties })
      });
    })
    .then(function(cartRes) {
      if (!cartRes.ok) throw new Error('Échec de l\'ajout au panier');
      window.location.href = '/cart';
    })
    .catch(function() {
      document.getElementById('recap-erreur').style.display = 'block';
      btn.textContent = original;
      btn.disabled = false;
    });
  }
</script>

{% schema %}
{
  "name": "Collection — Recap",
  "settings": [
    { "type": "number", "id": "prix_monogramme", "label": "Prix du monogramme (en cents, ex: 1500 = 15,00$)", "default": 2000 }
  ],
  "presets": [{ "name": "Collection — Récapitulatif" }]
}
{% endschema %}
