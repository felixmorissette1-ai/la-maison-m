{% comment %} Aide pour configurer — formulaire réservé aux clients connectés {% endcomment %}
<div class="lmm-partenaire-wrap">
  <div class="lmm-partenaire__header">
    <p class="lmm-partenaire__label">{{ section.settings.label }}</p>
    <h1 class="lmm-partenaire__title">{{ section.settings.titre }}</h1>
    <p class="lmm-partenaire__sub">{{ section.settings.sous_titre }}</p>
  </div>

  <form id="aide-config-form" class="lmm-partenaire__form" onsubmit="event.preventDefault(); {% if customer %}lmmSoumettreAideConfig();{% endif %}">
    <div class="lmm-partenaire__field">
      <label for="ac-prenom">Prénom</label>
      <input type="text" id="ac-prenom" name="prenom" value="{{ customer.first_name | escape }}" required>
    </div>
    <div class="lmm-partenaire__field">
      <label for="ac-nom">Nom</label>
      <input type="text" id="ac-nom" name="nom" value="{{ customer.last_name | escape }}" required>
    </div>
    <div class="lmm-partenaire__field">
      <label for="ac-evenement">Événement</label>
      <input type="text" id="ac-evenement" name="evenement" placeholder="Mariage, travail, occasion spéciale…">
    </div>
    <div class="lmm-partenaire__field">
      <label for="ac-note">Note</label>
      <textarea id="ac-note" name="note" rows="5" placeholder="Dites-nous en un peu plus sur ce que vous cherchez."></textarea>
    </div>
    {% if customer %}
      <input type="hidden" id="ac-email" value="{{ customer.email | escape }}">
      <button type="submit" class="lmm-btn-primary" id="aide-config-submit-btn">Envoyer ma requête</button>
    {% else %}
      <a href="/account/login?return_url={{ request.path | url_encode }}" class="lmm-btn-primary" id="aide-config-login-link" target="_blank" rel="noopener" onclick="lmmSauvegarderAideConfig(); lmmAfficherAttenteConnexion();">Se connecter et envoyer ma demande</a>
    {% endif %}
    <p class="lmm-partenaire__error" id="aide-config-error"></p>
    <p class="lmm-partenaire__success" id="aide-config-success">Merci ! Votre demande a bien été envoyée — nous vous répondrons sous peu.</p>
  </form>
</div>

<!-- Écran d'attente pendant la connexion dans l'autre onglet — floute le
     reste de la page plutôt que de la cacher complètement, pour montrer
     clairement que le formulaire est toujours là en dessous. Pas de
     détection automatique (testée et prouvée peu fiable, voir historique
     de ce fichier) : le client clique lui-même une fois de retour, ce qui
     déclenche un vrai rechargement de page. -->
<div id="aide-config-overlay" class="aide-config-overlay" hidden>
  <div class="aide-config-overlay__box">
    <p class="aide-config-overlay__text">Une fois connecté(e) dans l'autre onglet, cliquez ici pour continuer votre demande.</p>
    <button type="button" class="aide-config-overlay__btn" onclick="window.location.reload()">Continuer ma demande</button>
    <button type="button" class="aide-config-overlay__cancel" onclick="lmmAnnulerAttenteConnexion()">Annuler ma demande</button>
  </div>
</div>

<style>
  .lmm-partenaire-wrap {
    width: 90%; max-width: 560px; margin: 0 auto; padding: 56px 0 80px;
  }
  .lmm-partenaire__label { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lmm-bordeaux); margin-bottom: 8px; }
  .lmm-partenaire__title { font-family: Georgia, serif; font-size: 32px; font-weight: 400; color: var(--lmm-text); margin: 0 0 12px; }
  .lmm-partenaire__sub { font-size: 14px; color: var(--lmm-muted); line-height: 1.7; margin: 0 0 40px; }
  .lmm-partenaire__field { margin-bottom: 20px; }
  .lmm-partenaire__field label {
    display: block; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--lmm-muted); margin-bottom: 8px;
  }
  .lmm-partenaire__field input,
  .lmm-partenaire__field textarea {
    width: 100%; box-sizing: border-box; border: 1px solid var(--lmm-border); background: var(--lmm-white);
    padding: 14px 16px; font-family: inherit; font-size: 15px; color: var(--lmm-text);
  }
  .lmm-partenaire__field textarea { resize: vertical; }
  .lmm-partenaire__field input:focus,
  .lmm-partenaire__field textarea:focus { outline: none; border-color: var(--lmm-bordeaux); }
  .lmm-partenaire__error { color: var(--lmm-error); font-size: 13px; margin-top: 14px; display: none; }
  .lmm-partenaire__success { color: var(--lmm-success); font-size: 13px; margin-top: 14px; display: none; }

  /* Écran d'attente : floute l'arrière-plan (couleurs claires de cette
     page, pas le fond sombre emprunté à l'overlay de prise de
     rendez-vous) plutôt que de le cacher, pour rassurer que le
     formulaire est toujours intact en dessous. */
  .aide-config-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .aide-config-overlay[hidden] {
    display: none;
  }
  .aide-config-overlay__box {
    background: var(--lmm-white);
    border: 1px solid var(--lmm-border);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
    max-width: 380px;
    width: 100%;
    padding: 40px 36px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .aide-config-overlay__text {
    font-size: 15px;
    color: var(--lmm-text);
    line-height: 1.7;
    margin: 0;
  }

  /* Même gabarit que le bouton secondaire du hero (.lmm-hero__cta-secondary
     dans home-hero.liquid) : contour, coins ronds, remplissage au hover —
     plutôt que le bouton plein/carré .lmm-btn-primary utilisé ailleurs sur
     cette page. */
  .aide-config-overlay__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1.5px solid var(--lmm-bordeaux);
    color: var(--lmm-bordeaux);
    font-family: inherit;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 14px 32px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .aide-config-overlay__btn:hover {
    background: var(--lmm-bordeaux);
    color: var(--lmm-white);
  }

  .aide-config-overlay__cancel {
    background: none;
    border: none;
    color: var(--lmm-muted);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    font-family: inherit;
    padding: 0;
  }
  .aide-config-overlay__cancel:hover {
    color: var(--lmm-text);
  }
</style>

<script>
  // Le client n'est pas forcément connecté quand il remplit ce formulaire —
  // "Se connecter et envoyer ma demande" l'envoie vers /account/login,
  // ouvert dans un nouvel onglet pour garder celui-ci intact. On sauvegarde
  // les champs avant de partir pour ne pas les perdre, et on les restaure
  // au retour — sans rien envoyer automatiquement : le client clique
  // lui-même "Envoyer ma requête" une fois prêt. Pas de détection
  // automatique de la connexion non plus (testée en direct et prouvée peu
  // fiable — le cache CDN de Shopify sert des réponses incohérentes pour
  // ce genre de requête) — juste un bouton "J'ai terminé" que le client
  // clique lui-même, qui déclenche un vrai rechargement de page.
  function lmmSauvegarderAideConfig() {
    try {
      localStorage.setItem('lmm_aide_config_pending', JSON.stringify({
        prenom: document.getElementById('ac-prenom').value,
        nom: document.getElementById('ac-nom').value,
        evenement: document.getElementById('ac-evenement').value,
        note: document.getElementById('ac-note').value
      }));
    } catch (e) {}
  }

  function lmmAfficherAttenteConnexion() {
    var overlay = document.getElementById('aide-config-overlay');
    if (overlay) overlay.hidden = false;
  }

  // Retire la demande en attente (le client change d'avis) et referme
  // l'écran d'attente pour revenir au site normal, sans recharger la page.
  function lmmAnnulerAttenteConnexion() {
    try {
      localStorage.removeItem('lmm_aide_config_pending');
    } catch (e) {}
    var overlay = document.getElementById('aide-config-overlay');
    if (overlay) overlay.hidden = true;
  }

  function lmmSoumettreAideConfig() {
    var btn = document.getElementById('aide-config-submit-btn');
    var errEl = document.getElementById('aide-config-error');
    var okEl = document.getElementById('aide-config-success');
    errEl.style.display = 'none';
    okEl.style.display = 'none';
    btn.disabled = true;
    btn.textContent = 'Envoi en cours…';

    fetch('https://lmm-backend.vercel.app/api/aide-configuration', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        prenom: document.getElementById('ac-prenom').value,
        nom: document.getElementById('ac-nom').value,
        email: document.getElementById('ac-email').value,
        evenement: document.getElementById('ac-evenement').value,
        note: document.getElementById('ac-note').value
      })
    })
    .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, d: d }; }); })
    .then(function(res) {
      if (!res.ok) {
        errEl.textContent = res.d.error || 'Une erreur est survenue. Réessayez.';
        errEl.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Envoyer ma requête';
        return;
      }
      document.getElementById('aide-config-form').reset();
      okEl.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Envoyer ma requête';
    })
    .catch(function() {
      errEl.textContent = 'Erreur réseau. Réessayez.';
      errEl.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Envoyer ma requête';
    });
  }

  {% if customer %}
    // De retour de /account/login, maintenant connecté : restaure ce que le
    // client avait tapé avant de partir dans les champs — mais ne l'envoie
    // PAS automatiquement, le client clique lui-même "Envoyer ma requête".
    (function () {
      var pending;
      try {
        pending = JSON.parse(localStorage.getItem('lmm_aide_config_pending') || 'null');
      } catch (e) {
        pending = null;
      }
      if (!pending) return;
      localStorage.removeItem('lmm_aide_config_pending');
      if (pending.prenom) document.getElementById('ac-prenom').value = pending.prenom;
      if (pending.nom) document.getElementById('ac-nom').value = pending.nom;
      document.getElementById('ac-evenement').value = pending.evenement || '';
      document.getElementById('ac-note').value = pending.note || '';
    })();
  {% endif %}
</script>

{% schema %}
{
  "name": "Aide pour configurer",
  "settings": [
    { "type": "text", "id": "label", "label": "Étiquette", "default": "Besoin d'aide" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Aide pour configurer votre complet" },
    { "type": "textarea", "id": "sous_titre", "label": "Sous-titre", "default": "Dites-nous en un peu plus sur ce que vous cherchez, et nous vous répondrons sous peu." }
  ],
  "presets": [{ "name": "Aide pour configurer" }]
}
{% endschema %}
