{% comment %} Aide pour configurer — formulaire réservé aux clients connectés {% endcomment %}
<div class="lmm-partenaire-wrap">
  <div class="lmm-partenaire__header">
    <p class="lmm-partenaire__label">{{ section.settings.label }}</p>
    <h1 class="lmm-partenaire__title">{{ section.settings.titre }}</h1>
    <p class="lmm-partenaire__sub">{{ section.settings.sous_titre }}</p>
  </div>

  <form id="aide-config-form" class="lmm-partenaire__form" onsubmit="event.preventDefault(); {% if customer %}lmmSoumettreAideConfig();{% endif %}">
    <div class="lmm-partenaire__field">
      <label for="ac-prenom">Prénom</label>
      <input type="text" id="ac-prenom" name="prenom" value="{{ customer.first_name | escape }}" required>
    </div>
    <div class="lmm-partenaire__field">
      <label for="ac-nom">Nom</label>
      <input type="text" id="ac-nom" name="nom" value="{{ customer.last_name | escape }}" required>
    </div>
    <div class="lmm-partenaire__field">
      <label for="ac-evenement">Événement</label>
      <input type="text" id="ac-evenement" name="evenement" placeholder="Mariage, travail, occasion spéciale…">
    </div>
    <div class="lmm-partenaire__field">
      <label for="ac-note">Note</label>
      <textarea id="ac-note" name="note" rows="5" placeholder="Dites-nous en un peu plus sur ce que vous cherchez."></textarea>
    </div>
    {% if customer %}
      <input type="hidden" id="ac-email" value="{{ customer.email | escape }}">
      <button type="submit" class="lmm-btn-primary" id="aide-config-submit-btn">Envoyer ma requête</button>
    {% else %}
      <a href="/account/login?return_url={{ request.path | url_encode }}" class="lmm-btn-primary" id="aide-config-login-link" target="_blank" rel="noopener" onclick="lmmSauvegarderAideConfig(); lmmAfficherAttenteConnexion();">Se connecter et envoyer ma demande</a>
    {% endif %}
    <p class="lmm-partenaire__error" id="aide-config-error"></p>
    <p class="lmm-partenaire__success" id="aide-config-success">Merci ! Votre demande a bien été envoyée — nous vous répondrons sous peu.</p>
  </form>
</div>

<!-- Marqueur lu par lmmVerifierConnexionEnArrierePlan() (voir <script>) — un
     fetch en arrière-plan de cette même page relit cet attribut pour savoir
     si le client est maintenant connecté, sans jamais recharger visiblement
     la page tant que ce n'est pas le cas. -->
<div id="lmm-customer-flag" data-lmm-customer-status="{% if customer %}1{% else %}0{% endif %}" hidden></div>

<!-- Bloque la page pendant l'attente du retour du nouvel onglet — même
     traitement visuel que #lmm-booking-overlay (prise de rendez-vous, voir
     header.liquid), ID différent pour ne pas entrer en conflit avec lui. -->
<div id="aide-config-overlay" style="display:none; position:fixed; inset:0; background:var(--lmm-text); z-index:99999; flex-direction:column; align-items:center; justify-content:center; gap:20px; text-align:center; padding:24px;">
  <p style="font-family:Georgia,serif; font-size:22px; color:var(--lmm-white); letter-spacing:0.04em; margin:0;">En attente de votre connexion…</p>
  <p style="font-size:13px; color:var(--lmm-ivoire-pale); line-height:1.7; margin:0; max-width:340px;">Une fois connecté dans l'autre onglet, si vous arrivez sur la page de votre compte, cliquez sur le logo « La Maison M » là-bas pour revenir sur notre site — votre demande s'enverra alors automatiquement ici.</p>
  <div style="width:120px; height:2px; background:rgba(var(--lmm-ivoire-rgb),0.2); position:relative; overflow:hidden;">
    <div style="position:absolute; top:0; width:40px; height:2px; background:var(--lmm-bordeaux); animation:lmm-aide-config-slide 1.2s ease-in-out infinite;"></div>
  </div>
  <button type="button" id="aide-config-overlay-cancel" style="display:none; background:none; border:none; color:var(--lmm-border); font-size:11px; letter-spacing:0.08em; text-transform:uppercase; cursor:pointer; font-family:inherit; margin-top:12px;" onclick="lmmMasquerAttenteConnexion()">Annuler l'attente</button>
</div>

<style>
  .lmm-partenaire-wrap {
    width: 90%; max-width: 560px; margin: 0 auto; padding: 56px 0 80px;
  }
  .lmm-partenaire__label { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lmm-bordeaux); margin-bottom: 8px; }
  .lmm-partenaire__title { font-family: Georgia, serif; font-size: 32px; font-weight: 400; color: var(--lmm-text); margin: 0 0 12px; }
  .lmm-partenaire__sub { font-size: 14px; color: var(--lmm-muted); line-height: 1.7; margin: 0 0 40px; }
  .lmm-partenaire__field { margin-bottom: 20px; }
  .lmm-partenaire__field label {
    display: block; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--lmm-muted); margin-bottom: 8px;
  }
  .lmm-partenaire__field input,
  .lmm-partenaire__field textarea {
    width: 100%; box-sizing: border-box; border: 1px solid var(--lmm-border); background: var(--lmm-white);
    padding: 14px 16px; font-family: inherit; font-size: 15px; color: var(--lmm-text);
  }
  .lmm-partenaire__field textarea { resize: vertical; }
  .lmm-partenaire__field input:focus,
  .lmm-partenaire__field textarea:focus { outline: none; border-color: var(--lmm-bordeaux); }
  .lmm-partenaire__error { color: var(--lmm-error); font-size: 13px; margin-top: 14px; display: none; }
  .lmm-partenaire__success { color: var(--lmm-success); font-size: 13px; margin-top: 14px; display: none; }

  @keyframes lmm-aide-config-slide {
    0% { left: -40px; }
    100% { left: 120px; }
  }
</style>

<script>
  // Le client n'est pas forcément connecté quand il remplit ce formulaire —
  // "Se connecter et envoyer ma demande" l'envoie vers /account/login puis
  // le ramène ici via return_url. Sans ceci, il perdrait ce qu'il a tapé et
  // devrait tout retaper + recliquer "Envoyer" une fois connecté. On
  // sauvegarde donc les champs juste avant de partir, et on les restaure +
  // on soumet automatiquement dès le retour, connecté.
  function lmmSauvegarderAideConfig() {
    try {
      localStorage.setItem('lmm_aide_config_pending', JSON.stringify({
        prenom: document.getElementById('ac-prenom').value,
        nom: document.getElementById('ac-nom').value,
        evenement: document.getElementById('ac-evenement').value,
        note: document.getElementById('ac-note').value
      }));
    } catch (e) {}
  }

  // Le lien de connexion s'ouvre maintenant dans un nouvel onglet (voir
  // target="_blank") plutôt que de quitter cette page — l'onglet original
  // reste donc affiché avec le formulaire intact pendant que le client se
  // connecte/s'inscrit ailleurs. On bloque la page avec un écran de
  // chargement pendant l'attente (même traitement que la prise de
  // rendez-vous) plutôt que de la laisser "retouchable" dans un état
  // périmé — voir #aide-config-overlay plus haut.
  var lmmAttentePollTimer = null;
  var lmmAttenteAuthPollTimer = null;
  var lmmAttenteMaxTimer = null;
  var lmmAttenteDepuis = 0;

  function lmmAfficherAttenteConnexion() {
    lmmAttenteDepuis = Date.now();
    var overlay = document.getElementById('aide-config-overlay');
    var cancelBtn = document.getElementById('aide-config-overlay-cancel');
    if (overlay) overlay.style.display = 'flex';
    if (cancelBtn) cancelBtn.style.display = 'none';

    // Le "storage" event (déclenché dans CET onglet quand un AUTRE onglet
    // écrit dans localStorage) est le chemin rapide, mais ce n'est pas
    // fiable à 100 % selon le navigateur/l'état de l'onglet en arrière-plan
    // — voir l'écouteur plus bas. Le sondage ci-dessous, qui relit
    // directement la valeur plutôt que de dépendre d'être notifié d'un
    // changement, est le filet de sécurité qui garantit que ça finit
    // toujours par se mettre à jour, sans jamais avoir à rafraîchir.
    clearInterval(lmmAttentePollTimer);
    lmmAttentePollTimer = setInterval(lmmVerifierEnvoiTermine, 500);

    // Deuxième filet, complémentaire : le cookie de session Shopify est
    // partagé entre onglets du même navigateur, donc CET onglet peut lui
    // aussi devenir "connecté" dès que la connexion se termine dans l'autre
    // onglet — même si celui-ci n'a jamais rechargé une page de notre site.
    // On revérifie ça en arrière-plan (un fetch, jamais un rechargement
    // visible) toutes les 500ms ; dès que c'est détecté, LÀ on recharge
    // réellement pour de vrai, ce qui déclenche le remplissage + l'envoi
    // automatique déjà en place plus bas.
    clearInterval(lmmAttenteAuthPollTimer);
    lmmAttenteAuthPollTimer = setInterval(lmmVerifierConnexionEnArrierePlan, 500);

    // Après 8s, offrir un moyen de sortir plutôt que de bloquer
    // indéfiniment si le client abandonne la connexion dans l'autre onglet.
    clearTimeout(lmmAttenteMaxTimer);
    lmmAttenteMaxTimer = setTimeout(function () {
      if (cancelBtn) cancelBtn.style.display = 'inline-block';
    }, 8000);

    // Les navigateurs peuvent ralentir/mettre en pause les timers d'un
    // onglet en arrière-plan — on revérifie donc aussi dès que ce
    // premier onglet redevient visible (l'utilisateur y revient).
    document.addEventListener('visibilitychange', lmmVerifierEnvoiTermine);
  }

  function lmmMasquerAttenteConnexion() {
    var overlay = document.getElementById('aide-config-overlay');
    if (overlay) overlay.style.display = 'none';
    clearInterval(lmmAttentePollTimer);
    clearInterval(lmmAttenteAuthPollTimer);
    clearTimeout(lmmAttenteMaxTimer);
  }

  function lmmVerifierEnvoiTermine() {
    if (document.visibilityState === 'hidden') return;
    var valeur;
    try {
      valeur = Number(localStorage.getItem('lmm_aide_config_done') || 0);
    } catch (e) {
      valeur = 0;
    }
    // N'accepte que si le signal date d'APRÈS le clic sur "Se connecter" —
    // sinon un vieux signal laissé par une session précédente afficherait
    // faussement un succès immédiat.
    if (valeur && valeur >= lmmAttenteDepuis) {
      lmmMasquerAttenteConnexion();
      var okEl = document.getElementById('aide-config-success');
      if (okEl) okEl.style.display = 'block';
      document.removeEventListener('visibilitychange', lmmVerifierEnvoiTermine);
    }
  }

  function lmmVerifierConnexionEnArrierePlan() {
    if (document.visibilityState === 'hidden') return;
    fetch(window.location.pathname + window.location.search, { credentials: 'same-origin', cache: 'no-store' })
      .then(function (r) { return r.text(); })
      .then(function (html) {
        if (html.indexOf('data-lmm-customer-status="1"') === -1) return;
        clearInterval(lmmAttenteAuthPollTimer);
        // Un vrai rechargement ici (pas juste une mise à jour du DOM) pour
        // que le rendu du bloc "client connecté" se refasse correctement
        // côté serveur (courriel du compte, bouton, etc.) et que le code
        // qui restaure + envoie automatiquement la demande en attente
        // s'exécute.
        window.location.reload();
      })
      .catch(function () {});
  }

  // L'envoi effectif de la demande se produit dans l'AUTRE onglet (une fois
  // connecté là-bas, voir plus bas + header.liquid) — c'est le chemin
  // rapide quand le navigateur livre bien l'événement ; lmmVerifierEnvoiTermine
  // (sondage) est le filet de sécurité si jamais il ne se déclenche pas.
  window.addEventListener('storage', function (e) {
    if (e.key !== 'lmm_aide_config_done') return;
    lmmVerifierEnvoiTermine();
  });

  function lmmSoumettreAideConfig() {
    var btn = document.getElementById('aide-config-submit-btn');
    var errEl = document.getElementById('aide-config-error');
    var okEl = document.getElementById('aide-config-success');
    errEl.style.display = 'none';
    okEl.style.display = 'none';
    btn.disabled = true;
    btn.textContent = 'Envoi en cours…';

    fetch('https://lmm-backend.vercel.app/api/aide-configuration', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        prenom: document.getElementById('ac-prenom').value,
        nom: document.getElementById('ac-nom').value,
        email: document.getElementById('ac-email').value,
        evenement: document.getElementById('ac-evenement').value,
        note: document.getElementById('ac-note').value
      })
    })
    .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, d: d }; }); })
    .then(function(res) {
      if (!res.ok) {
        errEl.textContent = res.d.error || 'Une erreur est survenue. Réessayez.';
        errEl.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Envoyer ma requête';
        return;
      }
      document.getElementById('aide-config-form').reset();
      okEl.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Envoyer ma requête';
      // Signale aux AUTRES onglets du même site (voir l'écouteur "storage"
      // plus haut) que la demande vient d'être envoyée avec succès.
      try { localStorage.setItem('lmm_aide_config_done', String(Date.now())); } catch (e) {}
    })
    .catch(function() {
      errEl.textContent = 'Erreur réseau. Réessayez.';
      errEl.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Envoyer ma requête';
    });
  }

  {% if customer %}
    // De retour de /account/login, maintenant connecté : restaure ce que le
    // client avait tapé avant de partir et envoie la demande tout de suite,
    // sans qu'il ait à retaper ou recliquer quoi que ce soit.
    (function () {
      var pending;
      try {
        pending = JSON.parse(localStorage.getItem('lmm_aide_config_pending') || 'null');
      } catch (e) {
        pending = null;
      }
      if (!pending) return;
      localStorage.removeItem('lmm_aide_config_pending');
      if (pending.prenom) document.getElementById('ac-prenom').value = pending.prenom;
      if (pending.nom) document.getElementById('ac-nom').value = pending.nom;
      document.getElementById('ac-evenement').value = pending.evenement || '';
      document.getElementById('ac-note').value = pending.note || '';
      lmmSoumettreAideConfig();
    })();
  {% endif %}
</script>

{% schema %}
{
  "name": "Aide pour configurer",
  "settings": [
    { "type": "text", "id": "label", "label": "Étiquette", "default": "Besoin d'aide" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Aide pour configurer votre complet" },
    { "type": "textarea", "id": "sous_titre", "label": "Sous-titre", "default": "Dites-nous en un peu plus sur ce que vous cherchez, et nous vous répondrons sous peu." }
  ],
  "presets": [{ "name": "Aide pour configurer" }]
}
{% endschema %}
