{% comment %} Tissu — Configurateur Custom {% endcomment %}
{% render 'fil-ariane-custom', etape_active: 3 %}
{% render 'sm-preview' %}

<style>
  .lmm-sm-tissu-wrap {
    width: 90%; margin: 0 auto; padding: 20px 0 16px;
    display: flex; flex-direction: column; box-sizing: border-box;
  }
  @media (min-width: 861px) { .lmm-sm-tissu-wrap { width: 86%; margin-right: 0; margin-left: 5%; } }
  .lmm-sm-tissu__header { margin-bottom: 12px; }
  .lmm-sm-tissu__label { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lmm-bordeaux); margin-bottom: 4px; }
  .lmm-sm-tissu__title { font-family: Georgia, serif; font-size: 24px; font-weight: 400; color: var(--lmm-text); margin-bottom: 3px; }
  .lmm-sm-tissu__sub { font-size: 12px; color: var(--lmm-muted); font-weight: 300; line-height: 1.5; }

  /* Barre de filtres */
  .lmm-sm-tissu__filter-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .lmm-sm-tissu__filter-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: none;
    border: 1.5px solid var(--lmm-text);
    border-radius: 8px;
    color: var(--lmm-text);
    padding: 6px 14px;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    user-select: none;
  }
  .lmm-sm-tissu__filter-toggle:hover,
  .lmm-sm-tissu__filter-toggle.open { background: var(--lmm-text); color: var(--lmm-ivoire-pale); }
  .lmm-sm-tissu__filter-count {
    display: none;
    background: var(--lmm-bordeaux);
    color: var(--lmm-ivoire-pale);
    border-radius: 8px;
    padding: 1px 6px;
    font-size: 9px;
    letter-spacing: 0;
    line-height: 1.6;
  }
  .lmm-sm-tissu__filter-count.visible { display: inline-block; }

  /* Panneau de filtres */
  .lmm-sm-tissu__filter-panel {
    display: none;
    border: 1px solid var(--lmm-border);
    border-radius: 8px;
    background: var(--lmm-ivoire-pale);
    padding: 14px 16px;
    margin-bottom: 14px;
    flex-direction: column;
    gap: 10px;
  }
  .lmm-sm-tissu__filter-panel.open { display: flex; }

  .lmm-sm-tissu__filter-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 26px;
  }
  .lmm-sm-tissu__filter-key {
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lmm-muted);
    flex-shrink: 0;
    width: 52px;
  }
  .lmm-sm-tissu__filter-pills {
    display: flex;
    gap: 5px;
    overflow-x: auto;
    flex: 1;
    scrollbar-width: none;
  }
  .lmm-sm-tissu__filter-pills::-webkit-scrollbar { display: none; }
  .lmm-sm-tissu__pill {
    background: transparent;
    border: 1px solid var(--lmm-ivoire-line);
    border-radius: 8px;
    color: var(--lmm-muted);
    padding: 4px 11px;
    font-size: 10px;
    letter-spacing: 0.06em;
    cursor: pointer;
    white-space: nowrap;
    font-family: inherit;
    transition: all 0.15s;
    flex-shrink: 0;
  }
  .lmm-sm-tissu__pill:hover { border-color: var(--lmm-text); color: var(--lmm-text); }
  .lmm-sm-tissu__pill.active { background: var(--lmm-bordeaux); border-color: var(--lmm-bordeaux); color: var(--lmm-ivoire-pale); }

  /* Rayons — un livre = une rangée qui se scroll horizontalement, plutôt
     qu'une seule grande grille. Le vrai catalogue sera organisé ainsi
     (Nobility Fashion, Nobility Flannel, Cavani Four Seasons, Summer
     Romance by Canavi, Drago Vantage 3). */
  .lmm-sm-tissu__shelves { display: flex; flex-direction: column; gap: 20px; }
  .lmm-sm-tissu__shelf[hidden] { display: none; }
  .lmm-sm-tissu__shelf-title { font-family: Georgia, serif; font-size: 15px; color: var(--lmm-text); margin: 0 0 8px; }
  .lmm-sm-tissu__shelf-row {
    display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px;
    scrollbar-width: thin;
  }

  .lmm-sm-tissu__card {
    background: var(--lmm-ivoire-pale); border: 1px solid rgba(var(--lmm-text-rgb),0.1);
    border-radius: 8px;
    cursor: pointer; transition: border-color 0.2s, box-shadow 0.2s;
    display: flex; flex-direction: column; overflow: hidden;
    width: 130px; flex-shrink: 0;
  }
  .lmm-sm-tissu__card[hidden] { display: none; }
  .lmm-sm-tissu__card:hover { border-color: rgba(var(--lmm-text-rgb),0.3); box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
  .lmm-sm-tissu__card--selected { border: 2px solid var(--lmm-bordeaux) !important; }
  .lmm-sm-tissu__card-photo {
    width: 100%; aspect-ratio: 1/1;
    background: var(--lmm-ivoire-deep); display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative;
  }
  .lmm-sm-tissu__card-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .lmm-sm-tissu__card:hover .lmm-sm-tissu__card-photo img { transform: scale(1.04); }
  .lmm-sm-tissu__card-photo-placeholder { font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--lmm-muted); text-align: center; padding: 0 6px; }
  .lmm-sm-tissu__zoom-btn {
    position: absolute; bottom: 6px; right: 6px; width: 24px; height: 24px;
    background: rgba(var(--lmm-text-rgb),0.65); color: var(--lmm-white); border: none; border-radius: 6px; cursor: pointer;
    display: none; align-items: center; justify-content: center;
    backdrop-filter: blur(4px); transition: background 0.2s;
  }
  .lmm-sm-tissu__card-photo:hover .lmm-sm-tissu__zoom-btn,
  .lmm-sm-tissu__card--selected .lmm-sm-tissu__zoom-btn { display: flex; }
  .lmm-sm-tissu__zoom-btn:hover { background: rgba(var(--lmm-text-rgb),0.9); }
  .lmm-sm-tissu__card-body { padding: 7px 8px 9px; }
  .lmm-sm-tissu__name { font-family: Georgia, serif; font-size: 12px; font-weight: 400; color: var(--lmm-text); margin-bottom: 2px; line-height: 1.3; }
  .lmm-sm-tissu__meta { font-size: 9px; color: var(--lmm-muted); margin-bottom: 3px; line-height: 1.4; }
  .lmm-sm-tissu__prix { font-size: 11px; color: var(--lmm-text); font-weight: 500; }
  .lmm-sm-tissu__no-results { display: none; padding: 40px 0; text-align: center; font-size: 12px; color: var(--lmm-muted); letter-spacing: 0.06em; }

  /* Lightbox */
  .lmm-sm-lightbox { display: none; position: fixed; inset: 0; background: rgba(var(--lmm-text-rgb),0.92); z-index: 9999; align-items: center; justify-content: center; }
  .lmm-sm-lightbox.open { display: flex; }
  .lmm-sm-lightbox__inner { position: relative; max-width: 90vw; max-height: 90vh; display: flex; align-items: center; justify-content: center; }
  .lmm-sm-lightbox__img { max-width: 90vw; max-height: 90vh; object-fit: contain; display: block; cursor: zoom-in; transition: transform 0.3s ease; transform-origin: center center; border-radius: 8px; }
  .lmm-sm-lightbox__img.zoomed { cursor: zoom-out; transform: scale(2); }
  .lmm-sm-lightbox__swatch { width: min(60vw, 400px); height: min(60vw, 400px); border-radius: 8px; }
  .lmm-sm-lightbox__close { position: fixed; top: 20px; right: 24px; background: none; border: none; color: rgba(var(--lmm-ivoire-rgb),0.7); font-size: 28px; cursor: pointer; line-height: 1; transition: color 0.2s; }
  .lmm-sm-lightbox__close:hover { color: var(--lmm-white); }
  .lmm-sm-lightbox__name { position: fixed; bottom: 28px; left: 0; right: 0; text-align: center; font-family: Georgia, serif; font-size: 16px; color: rgba(var(--lmm-ivoire-rgb),0.8); }

  @media (max-width: 600px) { .lmm-sm-tissu-wrap { width: 92%; } }
</style>

{% comment %} Valeurs uniques pour filtres (texte libre) {% endcomment %}
{% assign _couleurs_raw = '' %}{% assign _patterns_raw = '' %}{% assign _matieres_raw = '' %}{% assign _origines_raw = '' %}
{% for entry in shop.metaobjects.tissu.values %}
  {% if entry.couleur.value != blank %}{% assign _couleurs_raw = _couleurs_raw | append: entry.couleur.value | append: '|||' %}{% endif %}
  {% if entry.pattern.value != blank %}{% assign _patterns_raw = _patterns_raw | append: entry.pattern.value | append: '|||' %}{% endif %}
  {% if entry.matiere.value != blank %}{% assign _matieres_raw = _matieres_raw | append: entry.matiere.value | append: '|||' %}{% endif %}
  {% if entry.origine.value != blank %}{% assign _origines_raw = _origines_raw | append: entry.origine.value | append: '|||' %}{% endif %}
{% endfor %}
{% assign _couleurs = _couleurs_raw | split: '|||' | uniq %}
{% assign _patterns = _patterns_raw | split: '|||' | uniq %}
{% assign _matieres = _matieres_raw | split: '|||' | uniq %}
{% assign _origines = _origines_raw | split: '|||' | uniq %}
{% assign _has_filters = true %}

<div class="lmm-sm-tissu-wrap lmm-sm-main">
  <div class="lmm-sm-tissu__header">
    <p class="lmm-sm-tissu__label">Configurateur custom — Étape 3 sur 9</p>
    <h1 class="lmm-sm-tissu__title">{{ section.settings.titre }}</h1>
    <p class="lmm-sm-tissu__sub">{{ section.settings.sous_titre }}</p>
  </div>

  <div class="lmm-sm-tissu__filter-bar">
    <button class="lmm-sm-tissu__filter-toggle" id="tissu-filter-toggle" onclick="toggleFilters()">
      Filtres
    </button>
    <span class="lmm-sm-tissu__filter-count" id="tissu-filter-count"></span>
  </div>

  <div class="lmm-sm-tissu__filter-panel" id="tissu-filter-panel">
    <div class="lmm-sm-tissu__filter-row">
      <span class="lmm-sm-tissu__filter-key">Prix</span>
      <div class="lmm-sm-tissu__filter-pills" data-filter="prix">
        <button class="lmm-sm-tissu__pill active" data-val="">Tous</button>
        <button class="lmm-sm-tissu__pill" data-val="1">Moins de 1 800 $</button>
        <button class="lmm-sm-tissu__pill" data-val="2">1 800 – 2 200 $</button>
        <button class="lmm-sm-tissu__pill" data-val="3">2 200 – 2 600 $</button>
        <button class="lmm-sm-tissu__pill" data-val="4">2 600 $ et plus</button>
      </div>
    </div>
    <div class="lmm-sm-tissu__filter-row">
      <span class="lmm-sm-tissu__filter-key">Masse</span>
      <div class="lmm-sm-tissu__filter-pills" data-filter="masse">
        <button class="lmm-sm-tissu__pill active" data-val="">Tous</button>
        <button class="lmm-sm-tissu__pill" data-val="leger">Léger</button>
        <button class="lmm-sm-tissu__pill" data-val="moyen">Moyen</button>
        <button class="lmm-sm-tissu__pill" data-val="lourd">Lourd</button>
      </div>
    </div>
    <div class="lmm-sm-tissu__filter-row">
      <span class="lmm-sm-tissu__filter-key">Saison</span>
      <div class="lmm-sm-tissu__filter-pills" data-filter="ete">
        <button class="lmm-sm-tissu__pill active" data-val="">Tous</button>
        <button class="lmm-sm-tissu__pill" data-val="oui">Léger — été / mariage</button>
      </div>
    </div>
    {% assign _matieres_exist = false %}{% for v in _matieres %}{% if v != '' %}{% assign _matieres_exist = true %}{% endif %}{% endfor %}
    {% if _matieres_exist %}
    <div class="lmm-sm-tissu__filter-row">
      <span class="lmm-sm-tissu__filter-key">Type</span>
      <div class="lmm-sm-tissu__filter-pills" data-filter="matiere">
        <button class="lmm-sm-tissu__pill active" data-val="">Tous</button>
        {% for v in _matieres %}{% if v != '' %}<button class="lmm-sm-tissu__pill" data-val="{{ v | escape }}">{{ v }}</button>{% endif %}{% endfor %}
      </div>
    </div>
    {% endif %}
    {% assign _couleurs_exist = false %}{% for v in _couleurs %}{% if v != '' %}{% assign _couleurs_exist = true %}{% endif %}{% endfor %}
    {% if _couleurs_exist %}
    <div class="lmm-sm-tissu__filter-row">
      <span class="lmm-sm-tissu__filter-key">Couleur</span>
      <div class="lmm-sm-tissu__filter-pills" data-filter="couleur">
        <button class="lmm-sm-tissu__pill active" data-val="">Tous</button>
        {% for v in _couleurs %}{% if v != '' %}<button class="lmm-sm-tissu__pill" data-val="{{ v | escape }}">{{ v }}</button>{% endif %}{% endfor %}
      </div>
    </div>
    {% endif %}
    {% assign _patterns_exist = false %}{% for v in _patterns %}{% if v != '' %}{% assign _patterns_exist = true %}{% endif %}{% endfor %}
    {% if _patterns_exist %}
    <div class="lmm-sm-tissu__filter-row">
      <span class="lmm-sm-tissu__filter-key">Pattern</span>
      <div class="lmm-sm-tissu__filter-pills" data-filter="pattern">
        <button class="lmm-sm-tissu__pill active" data-val="">Tous</button>
        {% for v in _patterns %}{% if v != '' %}<button class="lmm-sm-tissu__pill" data-val="{{ v | escape }}">{{ v }}</button>{% endif %}{% endfor %}
      </div>
    </div>
    {% endif %}
    {% assign _origines_exist = false %}{% for v in _origines %}{% if v != '' %}{% assign _origines_exist = true %}{% endif %}{% endfor %}
    {% if _origines_exist %}
    <div class="lmm-sm-tissu__filter-row">
      <span class="lmm-sm-tissu__filter-key">Origine</span>
      <div class="lmm-sm-tissu__filter-pills" data-filter="origine">
        <button class="lmm-sm-tissu__pill active" data-val="">Tous</button>
        {% for v in _origines %}{% if v != '' %}<button class="lmm-sm-tissu__pill" data-val="{{ v | escape }}">{{ v }}</button>{% endif %}{% endfor %}
      </div>
    </div>
    {% endif %}
  </div>

  {% comment %}
    Un rayon par livre, dans cet ordre précis — puis un rayon "Autres
    tissus" pour tout ce qui n'a pas (encore) de livre assigné. Le "where"
    de Liquid ne fonctionne pas de façon fiable sur un champ metaobject
    imbriqué (entry.livre.value) — même approche explicite que pour
    l'ordre des tailles de pantalon (sm-ourlet.liquid).
  {% endcomment %}
  {% assign _livres_ordre = "Nobility Fashion,Nobility Flannel,Cavani Four Seasons,Summer Romance by Canavi,Drago Vantage 3" | split: "," %}
  <div class="lmm-sm-tissu__shelves" id="tissu-shelves">
    {% for _livre_nom in _livres_ordre %}
      {% assign _shelf_count = 0 %}
      {% for entry in shop.metaobjects.tissu.values %}
        {% if entry.livre.value == _livre_nom %}{% assign _shelf_count = _shelf_count | plus: 1 %}{% endif %}
      {% endfor %}
      {% if _shelf_count > 0 %}
        <div class="lmm-sm-tissu__shelf" data-livre="{{ _livre_nom | escape }}">
          <p class="lmm-sm-tissu__shelf-title">{{ _livre_nom }}</p>
          <div class="lmm-sm-tissu__shelf-row">
            {% for entry in shop.metaobjects.tissu.values %}
              {% if entry.livre.value == _livre_nom %}
                {% render 'sm-tissu-card', entry: entry %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% assign _autres_count = 0 %}
    {% for entry in shop.metaobjects.tissu.values %}
      {% assign _dans_un_livre = false %}
      {% for _livre_nom in _livres_ordre %}{% if entry.livre.value == _livre_nom %}{% assign _dans_un_livre = true %}{% endif %}{% endfor %}
      {% unless _dans_un_livre %}{% assign _autres_count = _autres_count | plus: 1 %}{% endunless %}
    {% endfor %}
    {% if _autres_count > 0 %}
      <div class="lmm-sm-tissu__shelf" data-livre="">
        <p class="lmm-sm-tissu__shelf-title">Autres tissus</p>
        <div class="lmm-sm-tissu__shelf-row">
          {% for entry in shop.metaobjects.tissu.values %}
            {% assign _dans_un_livre = false %}
            {% for _livre_nom in _livres_ordre %}{% if entry.livre.value == _livre_nom %}{% assign _dans_un_livre = true %}{% endif %}{% endfor %}
            {% unless _dans_un_livre %}
              {% render 'sm-tissu-card', entry: entry %}
            {% endunless %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
  <p class="lmm-sm-tissu__no-results" id="tissu-no-results">Aucun tissu ne correspond à ces filtres.</p>
</div>

<div class="lmm-sm-lightbox" id="lmm-lightbox" onclick="if(event.target===this) fermerLightbox()">
  <button class="lmm-sm-lightbox__close" onclick="fermerLightbox()">×</button>
  <div class="lmm-sm-lightbox__inner">
    <img class="lmm-sm-lightbox__img" id="lmm-lightbox-img" src="" alt="" onclick="toggleZoom(this)">
    <div class="lmm-sm-lightbox__img lmm-sm-lightbox__swatch" id="lmm-lightbox-swatch" style="display:none;"></div>
  </div>
  <p class="lmm-sm-lightbox__name" id="lmm-lightbox-name"></p>
</div>

<script>
  var selected = null;
  var selectedPrix = 0;
  var _p = new URLSearchParams(window.location.search);
  var activeFilters = { livre: '', couleur: '', pattern: '', matiere: '', origine: '', ete: '', masse: '', prix: '' };

  var savedTissu = _p.get('tissu');
  if (savedTissu) {
    var savedCard = document.querySelector('#tissu-shelves [data-val="' + savedTissu + '"]');
    if (savedCard) selectTissu(savedCard);
  }

  function selectTissu(el) {
    document.querySelectorAll('#tissu-shelves .lmm-sm-tissu__card').forEach(function(c) { c.classList.remove('lmm-sm-tissu__card--selected'); });
    el.classList.add('lmm-sm-tissu__card--selected');
    selected = el.dataset.val;
    selectedPrix = parseFloat(el.dataset.prix) || 0;
    var btn = document.getElementById('lmm-prev-btn-next');
    if (btn) btn.classList.add('active');
    _p.set('tissu', selected);
    _p.set('tissu_prix', selectedPrix);
    // Supplément "3 pièces" (gilet) : dépend du tissu, appliqué seulement
    // si le client a choisi "3 pièces" à l'étape précédente — voir la
    // décision finale dans sm-recap.liquid.
    _p.set('tissu_prix_3pieces', parseFloat(el.dataset.prix3pieces) || 0);
    if (el.dataset.photo) _p.set('tissu_photo', el.dataset.photo);
    history.replaceState(null, '', '?' + _p.toString());
    var imgEl = document.getElementById('lmm-prev-tissu-img');
    var emptyEl = document.getElementById('lmm-prev-empty');
    var lblEl = document.getElementById('lmm-prev-tissu-label');
    if (imgEl && el.dataset.photo) {
      imgEl.src = el.dataset.photo; imgEl.style.display = 'block';
      if (emptyEl) emptyEl.style.display = 'none';
      if (lblEl) { lblEl.textContent = selected; lblEl.style.display = 'block'; }
    }
  }

  function goNext() {
    if (!selected) return;
    _p.set('_t', Date.now()); window.location.href = '/pages/sur-mesure-lining?' + _p.toString();
  }

  function toggleFilters() {
    var toggle = document.getElementById('tissu-filter-toggle');
    var panel = document.getElementById('tissu-filter-panel');
    if (!toggle || !panel) return;
    toggle.classList.toggle('open');
    panel.classList.toggle('open');
  }

  document.querySelectorAll('.lmm-sm-tissu__pill').forEach(function(pill) {
    pill.addEventListener('click', function() {
      var group = this.closest('[data-filter]');
      var filterKey = group.dataset.filter;
      group.querySelectorAll('.lmm-sm-tissu__pill').forEach(function(p) { p.classList.remove('active'); });
      this.classList.add('active');
      activeFilters[filterKey] = this.dataset.val;
      updateFilterCount();
      filterTissus();
    });
  });

  function updateFilterCount() {
    var count = 0;
    Object.keys(activeFilters).forEach(function(k) { if (activeFilters[k]) count++; });
    var el = document.getElementById('tissu-filter-count');
    if (!el) return;
    if (count > 0) {
      el.textContent = count;
      el.classList.add('visible');
    } else {
      el.classList.remove('visible');
    }
  }

  function filterTissus() {
    var cards = document.querySelectorAll('#tissu-shelves .lmm-sm-tissu__card');
    var visible = 0;
    cards.forEach(function(card) {
      var show = true;
      if (activeFilters.couleur && card.dataset.couleur !== activeFilters.couleur) show = false;
      if (activeFilters.pattern && card.dataset.pattern !== activeFilters.pattern) show = false;
      if (activeFilters.matiere && card.dataset.matiere !== activeFilters.matiere) show = false;
      if (activeFilters.origine && card.dataset.origine !== activeFilters.origine) show = false;
      if (activeFilters.ete && card.dataset.ete !== activeFilters.ete) show = false;
      if (activeFilters.masse && card.dataset.masseBucket !== activeFilters.masse) show = false;
      if (activeFilters.prix && card.dataset.prixBucket !== activeFilters.prix) show = false;
      card.hidden = !show;
      if (show) visible++;
    });
    // Un rayon sans carte visible se cache entièrement (pas de titre "Livre" flottant sans rien dessous).
    document.querySelectorAll('#tissu-shelves .lmm-sm-tissu__shelf').forEach(function(shelf) {
      var hasVisible = shelf.querySelector('.lmm-sm-tissu__card:not([hidden])');
      shelf.hidden = !hasVisible;
    });
    var noResults = document.getElementById('tissu-no-results');
    if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
  }

  function ouvrirLightbox(urlOrColor, nom, isSwatch) {
    var lb = document.getElementById('lmm-lightbox');
    var img = document.getElementById('lmm-lightbox-img');
    var swatch = document.getElementById('lmm-lightbox-swatch');
    if (isSwatch) {
      img.style.display = 'none';
      swatch.style.display = 'block';
      swatch.style.background = urlOrColor;
    } else {
      swatch.style.display = 'none';
      img.style.display = 'block';
      img.src = urlOrColor; img.classList.remove('zoomed');
    }
    document.getElementById('lmm-lightbox-name').textContent = nom;
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function fermerLightbox() {
    document.getElementById('lmm-lightbox').classList.remove('open');
    document.getElementById('lmm-lightbox-img').classList.remove('zoomed');
    document.body.style.overflow = '';
  }

  function toggleZoom(img) { img.classList.toggle('zoomed'); }
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') fermerLightbox(); });
</script>

