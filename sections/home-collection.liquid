<section class="lmm-home-collection full-width">
  <div class="lmm-home-collection__inner">
    <div class="lmm-home-collection__layout">
      <div class="lmm-home-collection__title-col">
        <h2 class="lmm-home-collection__heading">{{ section.settings.section_title }}</h2>
      </div>

      <div class="lmm-home-collection__content-col">
        {% assign coll = section.settings.collection %}
        {% if coll != blank and coll.products.size > 0 %}
          <div class="lmm-home-collection__track" id="lmm-home-collection-track">
            {% for product in coll.products limit: 12 %}
              <a href="{{ product.url }}" class="lmm-home-collection__card">
                <div class="lmm-home-collection__card-img">
                  {% if product.featured_image %}
                    <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" loading="lazy">
                  {% endif %}
                </div>
                <p class="lmm-home-collection__card-title">{{ product.title }}</p>
                <p class="lmm-home-collection__card-price">{{ product.price | money }}</p>
              </a>
            {% endfor %}
          </div>

          <div class="lmm-home-collection__cta">
            <a href="{{ section.settings.link_url | default: coll.url }}" class="lmm-home-collection__link">{{ section.settings.link_label }}</a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var track = document.getElementById('lmm-home-collection-track');
    if (!track) return;

    function avancer() {
      var card = track.querySelector('.lmm-home-collection__card');
      if (!card) return;
      var style = getComputedStyle(track);
      var gap = parseFloat(style.columnGap || style.gap || 24);
      var cardWidth = card.getBoundingClientRect().width + gap;
      var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      track.scrollTo({ left: atEnd ? 0 : track.scrollLeft + cardWidth, behavior: 'smooth' });
    }

    var timer = setInterval(avancer, 4000);

    // L'interaction manuelle (survol, défilement tactile/molette) met
    // l'avancement automatique en pause plutôt que de l'annuler
    // définitivement — reprend tout seul après quelques secondes.
    var resumeTimeout;
    function pauserTemporairement() {
      clearInterval(timer);
      clearTimeout(resumeTimeout);
      resumeTimeout = setTimeout(function () { timer = setInterval(avancer, 4000); }, 6000);
    }
    track.addEventListener('mouseenter', function () { clearInterval(timer); });
    track.addEventListener('mouseleave', function () { timer = setInterval(avancer, 4000); });
    track.addEventListener('touchstart', pauserTemporairement, { passive: true });
    track.addEventListener('wheel', pauserTemporairement, { passive: true });
  })();
</script>

{% stylesheet %}
  .lmm-home-collection {
    /* Alterne pâle/foncé avec les sections voisines : plan (pâle, fondu
       photo) -> collection (foncé) -> statistiques (pâle) -> pourquoi
       (foncé). */
    position: relative;
    background: var(--lmm-ivoire-deep);
  }

  .lmm-home-collection__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 70px 32px 90px;
  }

  /* Titre en marge — même gabarit que "Comment procéder" (voir
     home-hero.liquid), essayé ici pour voir si ça vaut la peine de
     l'uniformiser sur toutes les sections. */
  .lmm-home-collection__layout {
    display: grid;
    grid-template-columns: clamp(170px, 15vw, 300px) 1fr;
    gap: 48px;
  }

  .lmm-home-collection__title-col {
    border-right: 1px solid var(--lmm-text);
    padding-right: 28px;
    display: flex;
    align-items: center;
  }

  .lmm-home-collection__content-col {
    min-width: 0;
  }

  .lmm-home-collection__heading {
    width: 100%;
    text-align: center;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--lmm-fs-section-title);
    font-weight: 400;
    line-height: 1.3;
    color: var(--lmm-text);
    margin: 0;
  }

  .lmm-home-collection__track {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 4px;
  }

  .lmm-home-collection__track::-webkit-scrollbar {
    display: none;
  }

  .lmm-home-collection__card {
    flex: 0 0 calc((100% - 48px) / 3);
    scroll-snap-align: start;
    text-decoration: none;
    display: block;
  }

  .lmm-home-collection__card-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: var(--lmm-ivoire-line);
    overflow: hidden;
    border-radius: 6px;
    margin-bottom: 14px;
  }

  .lmm-home-collection__card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lmm-home-collection__card-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 17px;
    color: var(--lmm-text);
    margin: 0 0 4px;
  }

  .lmm-home-collection__card-price {
    font-size: 13px;
    color: var(--lmm-muted);
    margin: 0;
  }

  .lmm-home-collection__cta {
    text-align: center;
    margin-top: 44px;
  }

  .lmm-home-collection__link {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lmm-bordeaux-soft);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .lmm-home-collection__link:hover {
    color: var(--lmm-bordeaux);
  }

  @media (max-width: 900px) {
    .lmm-home-collection__card {
      flex: 0 0 calc((100% - 24px) / 2);
    }

    .lmm-home-collection__layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .lmm-home-collection__title-col {
      border-right: none;
      border-bottom: 1px solid var(--lmm-text);
      padding-right: 0;
      padding-bottom: 24px;
    }
  }

  @media (max-width: 600px) {
    .lmm-home-collection__card {
      flex: 0 0 85%;
    }

    .lmm-home-collection__heading {
      font-size: 26px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection — Accueil",
  "settings": [
    { "type": "text", "id": "section_title", "label": "Titre de la section", "default": "Découvrez notre collection" },
    { "type": "collection", "id": "collection", "label": "Collection à afficher" },
    { "type": "text", "id": "link_label", "label": "Texte du lien", "default": "Voir la collection complète" },
    { "type": "url", "id": "link_url", "label": "Lien (vide = page de la collection)" }
  ],
  "presets": [
    { "name": "Collection — Accueil" }
  ]
}
{% endschema %}
