{% comment %} Récapitulatif — Configurateur Custom {% endcomment %}
{% render 'fil-ariane-custom', etape_active: 9 %}
{% render 'sm-preview' %}

<style>
  .lmm-sm-recap-wrap { width: 90%; max-width: 900px; margin: 0 auto; padding: 40px 0 60px; }
  @media (min-width: 861px) { .lmm-sm-recap-wrap { max-width: none; width: 86%; margin-right: 0; margin-left: 5%; } }
  .lmm-sm-recap__header { margin-bottom: 48px; }
  .lmm-sm-recap__label { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lmm-bordeaux); margin-bottom: 12px; }
  .lmm-sm-recap__title { font-family: Georgia, serif; font-size: 36px; font-weight: 400; color: var(--lmm-text); margin-bottom: 12px; }
  .lmm-sm-recap__sub { font-size: 14px; color: var(--lmm-muted); font-weight: 300; line-height: 1.7; }
  .lmm-sm-recap__table { border-top: 1px solid var(--lmm-border); margin-bottom: 48px; }
  .lmm-sm-recap__row { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--lmm-border); }
  .lmm-sm-recap__key { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--lmm-muted); }
  .lmm-sm-recap__val { font-size: 15px; color: var(--lmm-text); font-family: Georgia, serif; }
  .lmm-sm-recap__val--prix { font-size: 12px; color: var(--lmm-muted); margin-left: 8px; }
  .lmm-sm-recap__total { display: flex; justify-content: space-between; align-items: baseline; background: var(--lmm-ivoire-deep); padding: 20px 24px; margin-bottom: 32px; }
  .lmm-sm-recap__total-label { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--lmm-text); }
  .lmm-sm-recap__total-price { font-family: Georgia, serif; font-size: 32px; color: var(--lmm-text); }
</style>

<div class="lmm-sm-recap-wrap lmm-sm-main">
  <div class="lmm-sm-recap__header">
    <p class="lmm-sm-recap__label">Configurateur custom — Récapitulatif</p>
    <h1 class="lmm-sm-recap__title">{{ section.settings.titre }}</h1>
    <p class="lmm-sm-recap__sub">{{ section.settings.sous_titre }}</p>
  </div>

  <div class="lmm-sm-recap__table">
    <div class="lmm-sm-recap__row">
      <span class="lmm-sm-recap__key">Style</span>
      <span class="lmm-sm-recap__val" id="r-style">—</span>
    </div>
    <div class="lmm-sm-recap__row">
      <span class="lmm-sm-recap__key">Pièces</span>
      <span class="lmm-sm-recap__val" id="r-pieces">—</span>
    </div>
    <div class="lmm-sm-recap__row">
      <span class="lmm-sm-recap__key">Tissu</span>
      <span class="lmm-sm-recap__val" id="r-tissu">—</span>
    </div>
    <div class="lmm-sm-recap__row">
      <span class="lmm-sm-recap__key">Lining</span>
      <span class="lmm-sm-recap__val" id="r-lining">—</span>
    </div>
    <div class="lmm-sm-recap__row">
      <span class="lmm-sm-recap__key">Boutons</span>
      <span class="lmm-sm-recap__val" id="r-bouton">—</span>
    </div>
    <div class="lmm-sm-recap__row">
      <span class="lmm-sm-recap__key">Construction</span>
      <span class="lmm-sm-recap__val" id="r-construction">—</span>
    </div>
    <div class="lmm-sm-recap__row">
      <span class="lmm-sm-recap__key">Hauteur du pantalon</span>
      <span class="lmm-sm-recap__val" id="r-hauteur">—</span>
    </div>
    <div class="lmm-sm-recap__row">
      <span class="lmm-sm-recap__key">Bas de pantalon</span>
      <span class="lmm-sm-recap__val" id="r-bas">—</span>
    </div>
    <div class="lmm-sm-recap__row" id="r-mono-row" style="display:none;">
      <span class="lmm-sm-recap__key">Monogramme</span>
      <span class="lmm-sm-recap__val" id="r-mono">—</span>
    </div>
  </div>

  <div class="lmm-sm-recap__total">
    <span class="lmm-sm-recap__total-label">Estimation de base</span>
    <span class="lmm-sm-recap__total-price" id="r-total">—</span>
  </div>

</div>

<script>
  var params = new URLSearchParams(window.location.search);

  document.getElementById('r-style').textContent = params.get('style') || '—';
  document.getElementById('r-pieces').textContent = params.get('pieces') || '—';
  document.getElementById('r-tissu').textContent = params.get('tissu') || '—';
  document.getElementById('r-lining').textContent = params.get('lining') || '—';
  document.getElementById('r-bouton').textContent = params.get('bouton') || '—';
  document.getElementById('r-construction').textContent = params.get('construction') || '—';
  document.getElementById('r-hauteur').textContent = params.get('hauteur') || '—';
  document.getElementById('r-bas').textContent = params.get('bas') || '—';

  var tissuPrix = parseFloat(params.get('tissu_prix') || '0');
  var liningPrix = parseFloat(params.get('lining_prix') || '0');
  var boutonPrix = parseFloat(params.get('bouton_prix') || '0');
  var constPrix = parseFloat(params.get('construction_prix') || '0');
  // Le supplément 3 pièces (gilet) dépend du tissu choisi — appliqué
  // seulement si "3 pièces" est sélectionné, voir sm-tissu.liquid.
  var piecesPrix = params.get('pieces') === '3 pièces' ? parseFloat(params.get('tissu_prix_3pieces') || '0') : 0;

  var monogramme = params.get('monogramme') || '';
  var prixMonogramme = {{ section.settings.prix_monogramme | default: 0 }} / 100;
  if (monogramme) {
    document.getElementById('r-mono-row').style.display = 'flex';
    document.getElementById('r-mono').textContent = monogramme + (prixMonogramme ? ' (+$' + prixMonogramme.toLocaleString('fr-CA', { minimumFractionDigits: 2 }) + ')' : '');
  }

  var total = tissuPrix + liningPrix + boutonPrix + constPrix + piecesPrix + (monogramme ? prixMonogramme : 0);
  document.getElementById('r-total').textContent = total > 0 ? '$' + total.toLocaleString('fr-CA', { minimumFractionDigits: 2 }) : '—';

  // Récap = toujours actionnable : le bouton partagé du panneau preview
  // (même bouton "Continuer" que sur toutes les autres étapes) devient
  // "Ajouter au panier" et déclenche la création de la commande.
  var lmmSharedBtn = document.getElementById('lmm-prev-btn-next');
  if (lmmSharedBtn) {
    lmmSharedBtn.classList.add('active');
    lmmSharedBtn.classList.remove('lmm-btn-outline');
    lmmSharedBtn.classList.add('lmm-btn-fill');
    lmmSharedBtn.childNodes[0].textContent = 'Ajouter au panier';
  }
  function goNext() { confirmer(); }

  // Le complet sur mesure n'a pas de prix fixe (le tissu détermine le prix
  // de base, lining/boutons/construction ajoutent des suppléments) — le
  // serveur recalcule le vrai total à partir des mêmes tissus/lining/
  // boutons/construction (jamais le prix affiché ici, qui ne sert qu'à
  // l'aperçu), puis on ajoute au VRAI panier Shopify avec ce que le
  // backend retourne (variante + quantité qui encodent ce prix) — voir
  // handleSmCheckout dans couturiere-actions.js pour le détail.
  function confirmer() {
    var btn = document.getElementById('lmm-prev-btn-next');
    btn.childNodes[0].textContent = 'Ajout au panier…';
    btn.disabled = true;
    btn.classList.remove('active');

    fetch('https://lmm-backend.vercel.app/api/couturiere-actions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        action: 'sm-checkout',
        style: params.get('style') || '',
        pieces: params.get('pieces') || '',
        tissu: params.get('tissu') || '',
        lining: params.get('lining') || '',
        bouton: params.get('bouton') || '',
        construction: params.get('construction') || '',
        hauteur: params.get('hauteur') || '',
        bas: params.get('bas') || '',
        monogramme: monogramme,
        monogramme_prix: prixMonogramme * 100
      })
    })
    .then(function(res) { return res.json().then(function(d) { return { ok: res.ok, d: d }; }); })
    .then(function(res) {
      if (!res.ok) throw new Error(res.d.error || 'Erreur');
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: res.d.variant_id, quantity: res.d.quantity, properties: res.d.properties })
      });
    })
    .then(function(cartRes) {
      if (!cartRes.ok) throw new Error('Échec de l\'ajout au panier');
      window.location.href = '/cart';
    })
    .catch(function(err) {
      console.error('Erreur ajout panier:', err);
      btn.childNodes[0].textContent = 'Ajouter au panier';
      btn.disabled = false;
      btn.classList.add('active');
      alert('Une erreur est survenue. Veuillez réessayer.');
    });
  }
</script>

{% schema %}
{
  "name": "Custom — Récapitulatif",
  "settings": [
    { "type": "text", "id": "titre", "label": "Titre", "default": "Votre complet sur mesure" },
    { "type": "textarea", "id": "sous_titre", "label": "Sous-titre", "default": "Vérifiez vos choix avant de confirmer votre commande." },
    { "type": "number", "id": "prix_monogramme", "label": "Prix du monogramme (en cents, ex: 1500 = 15,00$)", "default": 2000 }
  ],
  "presets": [{ "name": "Custom — Récapitulatif" }]
}
{% endschema %}
