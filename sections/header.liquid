<header class="lmm-header full-width">
  <div class="lmm-header__inner">
    <div class="lmm-header__cell lmm-header__cell--toggle">
      <button type="button" class="lmm-menu-toggle" aria-expanded="false" aria-controls="lmm-mobile-nav" onclick="toggleMobileNav()">
        <span class="lmm-menu-toggle__bar"></span>
        <span class="lmm-menu-toggle__bar"></span>
        <span class="lmm-menu-toggle__bar"></span>
        <span class="lmm-visually-hidden">Menu</span>
      </button>
    </div>

    <div class="lmm-header__cell lmm-header__cell--nav">
      <a href="/pages/sur-mesure" class="lmm-nav-link{% if request.path contains 'sur-mesure' %} lmm-nav-link--active{% endif %}">Configurateur</a>
    </div>
    <div class="lmm-header__cell lmm-header__cell--nav">
      <a href="/collections/frontpage" class="lmm-nav-link{% if request.path contains '/collections/frontpage' %} lmm-nav-link--active{% endif %}">Collection</a>
    </div>
    <div class="lmm-header__cell lmm-header__cell--nav">
      <a href="/collections/chemises" class="lmm-nav-link{% if request.path contains '/collections/chemises' %} lmm-nav-link--active{% endif %}">Chemise</a>
    </div>

    <div class="lmm-header__cell lmm-header__cell--logo">
      <a href="{{ routes.root_url }}" class="lmm-header__logo">
        {% if section.settings.logo_image %}
          <img src="{{ section.settings.logo_image | image_url: width: 400 }}" alt="{{ shop.name }}" class="lmm-header__logo-img" style="height: {{ section.settings.logo_height | default: 32 }}px;">
        {% else %}
          <span class="lmm-logo-main">La Maison M.</span>
        {% endif %}
        <span class="lmm-logo-sub">Tailleur sur mesure</span>
      </a>
    </div>

    <div class="lmm-header__cell lmm-header__cell--nav lmm-header__cell--dropdown">
      <a href="/pages/qui-nous-sommes" class="lmm-nav-link{% if request.path contains 'qui-nous-sommes' or request.path contains 'comment-ca-fonctionne' %} lmm-nav-link--active{% endif %}">À propos</a>
      <div class="lmm-header__dropdown">
        <a href="/pages/qui-nous-sommes" class="lmm-header__dropdown-link">Qui nous sommes</a>
        <a href="/pages/comment-ca-fonctionne" class="lmm-header__dropdown-link">Comment ça fonctionne</a>
      </div>
    </div>

    <div class="lmm-header__cell lmm-header__cell--nav">
      {% assign now_ts = 'now' | date: '%s' %}
      {% assign rdv_ts = customer.metafields.custom.rdv_date_heure | date: '%s' %}
      {% if customer and customer.metafields.custom.rdv_futur and rdv_ts > now_ts %}
        <a href="#" class="lmm-nav-link" onclick="event.preventDefault(); ouvrirGestionModal()">Gestion du rendez-vous</a>
      {% else %}
        <a href="#" class="lmm-nav-link" onclick="event.preventDefault(); ouvrirLocalisationModal()">Prendre rendez-vous</a>
      {% endif %}
    </div>

    <div class="lmm-header__cell lmm-header__cell--icons">
      <div class="lmm-header__icons">
        <a href="{{ routes.cart_url }}" class="lmm-icon-btn lmm-cart-btn">
          {{ 'icon-cart.svg' | inline_asset_content }}
          {% if cart.item_count > 0 %}
            <span class="lmm-cart-count">{{ cart.item_count }}</span>
          {% endif %}
        </a>

        {% if shop.customer_accounts_enabled %}
          <shopify-account menu="{{ section.settings.customer_account_menu }}" class="lmm-icon-btn">
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        {% endif %}
      </div>
    </div>
  </div>
</header>

<div id="lmm-mobile-nav-backdrop" class="lmm-mobile-nav__backdrop" onclick="fermerMobileNav()"></div>
<nav id="lmm-mobile-nav" class="lmm-mobile-nav" aria-hidden="true">
  <a href="/pages/sur-mesure" class="lmm-mobile-nav__link{% if request.path contains 'sur-mesure' %} lmm-mobile-nav__link--active{% endif %}">Configurateur</a>
  <a href="/collections/frontpage" class="lmm-mobile-nav__link{% if request.path contains '/collections/frontpage' %} lmm-mobile-nav__link--active{% endif %}">Collection</a>
  <a href="/collections/chemises" class="lmm-mobile-nav__link{% if request.path contains '/collections/chemises' %} lmm-mobile-nav__link--active{% endif %}">Chemise</a>
  <a href="/pages/qui-nous-sommes" class="lmm-mobile-nav__link{% if request.path contains 'qui-nous-sommes' %} lmm-mobile-nav__link--active{% endif %}">Qui nous sommes</a>
  <a href="/pages/comment-ca-fonctionne" class="lmm-mobile-nav__link{% if request.path contains 'comment-ca-fonctionne' %} lmm-mobile-nav__link--active{% endif %}">Comment ça fonctionne</a>
  {% if customer and customer.metafields.custom.rdv_futur and rdv_ts > now_ts %}
    <a href="#" class="lmm-mobile-nav__link" onclick="event.preventDefault(); fermerMobileNav(); ouvrirGestionModal()">Gestion du rendez-vous</a>
  {% else %}
    <a href="#" class="lmm-mobile-nav__link" onclick="event.preventDefault(); fermerMobileNav(); ouvrirLocalisationModal()">Prendre rendez-vous</a>
  {% endif %}
</nav>

<div class="lmm-cal-modal" id="lmm-localisation-modal" onclick="if(event.target===this) fermerLocalisationModal()">
  <div class="lmm-cal-modal__inner" style="padding:40px 32px; max-width:600px; width:90vw; max-height:90vh; display:flex; flex-direction:column;">
    <button class="lmm-cal-modal__close" onclick="fermerLocalisationModal()">×</button>
    <h2 style="font-family:Georgia,serif; font-size:22px; font-weight:400; color:var(--lmm-text); margin:0 0 8px;">Votre tailleur</h2>
    <p style="font-size:12px; color:var(--lmm-muted); letter-spacing:0.04em; margin:0 0 20px; line-height:1.7;">Nous trouvons le tailleur le plus près de vous.</p>

    <div id="lmm-loc-auto" style="display:flex; flex-direction:column; gap:10px; margin-bottom:20px;">
      <button onclick="localiserAuto()" style="background:var(--lmm-text); color:#ffffff; border:none; padding:14px 32px; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; cursor:pointer; font-family:inherit; display:flex; align-items:center; justify-content:center; gap:10px;">
        Utiliser ma localisation
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
      </button>
      <p style="text-align:center; font-size:11px; color:var(--lmm-border); margin:0;">— ou —</p>
      <div style="display:flex; gap:8px;">
        <input id="lmm-code-postal" type="text" placeholder="Code postal (ex: G6V 1A1)" style="flex:1; border:1px solid var(--lmm-border); padding:12px; font-family:inherit; font-size:13px; color:var(--lmm-text);">
        <button onclick="localiserParCodePostal()" style="background:var(--lmm-gold); color:var(--lmm-text); border:none; padding:12px 20px; font-size:11px; letter-spacing:0.08em; text-transform:uppercase; cursor:pointer; font-family:inherit;">
          OK
        </button>
      </div>
    </div>

    <div id="lmm-loc-loading" style="display:none; text-align:center; padding:20px 0;">
      <p style="font-size:12px; color:var(--lmm-muted); letter-spacing:0.08em;">Recherche en cours...</p>
    </div>

    <div id="lmm-loc-resultat" style="display:none; flex-direction:column; gap:0; flex:1; min-height:0;">
      <div id="lmm-map" style="width:100%; height:200px; background:var(--lmm-white); flex-shrink:0;"></div>

      <div id="lmm-vendeuse-legende" style="display:none; flex-shrink:0; border:1px solid var(--lmm-border); border-top:none; padding:16px 18px; flex-direction:column; gap:12px; background:var(--lmm-surface);">
        <div style="display:flex; flex-direction:column; gap:10px;">
          <span style="display:flex; align-items:center; gap:10px; font-size:12px; color:var(--lmm-text);">
            <svg width="14" height="14" viewBox="0 0 14 14" style="flex-shrink:0;"><circle cx="7" cy="7" r="7" fill="var(--lmm-gold)"/></svg>
            Mensurations, altérations et visualisation des tissus
          </span>
          <span style="display:flex; align-items:center; gap:10px; font-size:12px; color:var(--lmm-text);">
            <svg width="14" height="14" viewBox="0 0 14 14" style="flex-shrink:0;"><circle cx="7" cy="7" r="7" fill="var(--lmm-text)"/></svg>
            Mensurations et altérations
          </span>
        </div>
        <button type="button" id="lmm-vendeuse-toggle" onclick="toggleVendeuseSeulement()" style="display:flex; align-items:center; justify-content:space-between; gap:8px; background:none; border:none; border-top:1px solid var(--lmm-border); padding:12px 0 0; cursor:pointer; font-family:inherit; width:100%;">
          <span style="font-size:11px; letter-spacing:0.04em; color:var(--lmm-text);">Voir seulement les tailleurs avec livres de tissus</span>
          <span class="lmm-toggle-track"><span class="lmm-toggle-thumb"></span></span>
        </button>
      </div>

      <div id="lmm-couturieres-liste" style="display:flex; flex-direction:column; gap:8px; overflow-y:auto; flex:1; min-height:0; margin-top:12px;"></div>

      <div style="flex-shrink:0; display:flex; flex-direction:column; gap:8px; padding-top:4px;">
        <button onclick="confirmerCouturiereEtOuvrirCal()" style="background:var(--lmm-text); color:#ffffff; border:none; padding:14px 32px; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; cursor:pointer; font-family:inherit;">
          Prendre rendez-vous
        </button>
        <button onclick="afficherLocAuto()" style="background:none; border:1px solid var(--lmm-border); color:var(--lmm-muted); padding:12px; font-size:11px; letter-spacing:0.08em; text-transform:uppercase; cursor:pointer; font-family:inherit;">
          Changer de localisation
        </button>
      </div>
    </div>

    <p id="lmm-loc-erreur" style="color:var(--lmm-error); font-size:12px; margin:12px 0 0; display:none;">Impossible de trouver votre localisation. Essayez avec un code postal.</p>
  </div>
</div>

<div class="lmm-cal-modal" id="lmm-annulation-modal" onclick="if(event.target===this) fermerAnnulationModal()">
  <div class="lmm-cal-modal__inner" style="padding:40px 32px; max-width:480px;">
    <button class="lmm-cal-modal__close" onclick="fermerAnnulationModal()">×</button>
    <h2 style="font-family:Georgia,serif; font-size:22px; font-weight:400; color:var(--lmm-text); margin:0 0 8px;">Annuler le rendez-vous</h2>
    <p style="font-size:12px; color:var(--lmm-muted); letter-spacing:0.04em; margin:0 0 24px;">Veuillez indiquer la raison de votre annulation.</p>
    <textarea id="lmm-annulation-raison" placeholder="Raison de l'annulation..." style="width:100%; height:100px; border:1px solid var(--lmm-border); padding:12px; font-family:inherit; font-size:13px; color:var(--lmm-text); resize:none; box-sizing:border-box; margin-bottom:16px;"></textarea>
    <div style="display:flex; flex-direction:column; gap:10px;">
      <button onclick="confirmerAnnulation()" style="background:var(--lmm-text); color:#ffffff; border:none; padding:14px 32px; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; cursor:pointer; font-family:inherit;">
        Confirmer l'annulation
      </button>
      <button onclick="fermerAnnulationModal()" style="background:none; border:1px solid var(--lmm-border); color:var(--lmm-muted); padding:14px 32px; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; cursor:pointer; font-family:inherit;">
        Retour
      </button>
    </div>
    <p id="lmm-annulation-erreur" style="color:var(--lmm-error); font-size:12px; margin:12px 0 0; display:none;">Une erreur est survenue. Veuillez réessayer.</p>
  </div>
</div>

<div class="lmm-cal-modal" id="lmm-signup-modal">
  <div class="lmm-cal-modal__inner" style="padding:40px 32px; max-width:480px;">
    <h2 style="font-family:Georgia,serif; font-size:22px; font-weight:400; color:var(--lmm-text); margin:0 0 8px;">Rendez-vous confirmé ✓</h2>
    <p style="font-size:13px; color:var(--lmm-muted); margin:0 0 24px; line-height:1.6;">Connectez-vous pour accéder au paiement et que vos mensurations soient enregistrées à votre nom.</p>
    <a id="lmm-signup-link" href="/account/login" style="display:flex; align-items:center; justify-content:center; gap:10px; background:var(--lmm-gold); color:var(--lmm-text); padding:14px 32px; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; text-decoration:none; font-family:inherit; margin-bottom:10px;">
      Se connecter
      <svg width="14" height="14" viewBox="0 0 18 18" fill="none"><path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <a href="/account/register" style="display:block; text-align:center; font-size:11px; letter-spacing:0.08em; color:var(--lmm-muted); text-decoration:none; margin-bottom:16px;">
      Créer un compte
    </a>
    <input type="hidden" id="lmm-signup-email" value="">
    <button onclick="document.getElementById('lmm-signup-modal').classList.remove('open'); window.location.href='/cart';" style="background:none; border:none; color:var(--lmm-border); font-size:11px; letter-spacing:0.08em; text-transform:uppercase; cursor:pointer; font-family:inherit; width:100%; padding:10px;">
      Continuer sans compte
    </button>
  </div>
</div>

<div id="lmm-booking-overlay" style="display:none; position:fixed; inset:0; background:var(--lmm-text); z-index:99999; flex-direction:column; align-items:center; justify-content:center; gap:20px;">
  <p style="font-family:Georgia,serif; font-size:22px; color:#ffffff; letter-spacing:0.04em;">Rendez-vous confirmé</p>
  <p style="font-size:12px; color:var(--lmm-gold); letter-spacing:0.12em; text-transform:uppercase;">Redirection vers votre panier...</p>
  <div style="width:40px; height:2px; background:var(--lmm-gold); animation:lmm-progress 3s linear forwards;"></div>
</div>

<div class="lmm-cal-modal" id="lmm-reschedule-modal" onclick="if(event.target===this) fermerRescheduleModal()">
  <div class="lmm-cal-modal__inner">
    <button class="lmm-cal-modal__close" onclick="fermerRescheduleModal()">×</button>
    <iframe id="lmm-reschedule-iframe" src="" frameborder="0" allow="camera; microphone; fullscreen" style="width:100%; min-height:600px; display:block;"></iframe>
  </div>
</div>

<div class="lmm-cal-modal" id="lmm-cal-modal" onclick="if(event.target===this) fermerCalModal()">
  <div class="lmm-cal-modal__inner">
    <button class="lmm-cal-modal__close" onclick="fermerCalModal()">×</button>
    <button onclick="retourSelectionCouturiere()" style="position:absolute; top:16px; left:16px; z-index:2; background:none; border:none; color:var(--lmm-muted); font-size:11px; letter-spacing:0.06em; text-transform:uppercase; cursor:pointer; font-family:inherit; display:flex; align-items:center; gap:6px;">
      <svg width="12" height="12" viewBox="0 0 18 18" fill="none"><path d="M15 9H3M3 9L8 4M3 9L8 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Changer de tailleur
    </button>
    <iframe id="lmm-cal-iframe" src="" frameborder="0" allow="camera; microphone; fullscreen" style="width:100%; min-height:600px; display:block;"></iframe>
  </div>
</div>

<div class="lmm-cal-modal" id="lmm-gestion-modal" onclick="if(event.target===this) fermerGestionModal()">
  <div class="lmm-cal-modal__inner" style="padding:40px 32px; max-width:480px;">
    <button class="lmm-cal-modal__close" onclick="fermerGestionModal()">×</button>
    <h2 style="font-family:Georgia,serif; font-size:22px; font-weight:400; color:var(--lmm-text); margin:0 0 24px;">Votre rendez-vous</h2>

    {% if customer and customer.metafields.custom.rdv_date_heure != blank %}
      <div style="background:var(--lmm-surface); padding:20px 24px; margin-bottom:28px;">
        <p style="font-size:11px; color:var(--lmm-muted); letter-spacing:0.1em; text-transform:uppercase; margin:0 0 6px;">Date et heure</p>
        <p style="font-family:Georgia,serif; font-size:18px; color:var(--lmm-text); margin:0;">
          {{ customer.metafields.custom.rdv_date_heure | date: "%A %d %B %Y" | capitalize }}
        </p>
        <p style="font-size:14px; color:var(--lmm-muted); margin:4px 0 0;">
          {{ customer.metafields.custom.rdv_date_heure | date: "%H:%M" }}
        </p>
      </div>
    {% endif %}

    <div style="display:flex; flex-direction:column; gap:10px;">
      {% if customer and customer.metafields.custom.rdv_uid != blank %}
        <button onclick="ouvrirRescheduleModal()" style="display:flex; align-items:center; justify-content:center; gap:10px; background:var(--lmm-text); color:#ffffff; border:none; padding:14px 32px; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; cursor:pointer; font-family:inherit; width:100%;">
          Modifier le rendez-vous
          <svg width="14" height="14" viewBox="0 0 18 18" fill="none"><path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button onclick="ouvrirChangementCouturiere()" style="display:flex; align-items:center; justify-content:center; background:none; border:1px solid var(--lmm-border); color:var(--lmm-muted); padding:14px 32px; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; cursor:pointer; font-family:inherit; width:100%;">
          Changer de tailleur
        </button>
        <button onclick="ouvrirAnnulationModal()" style="display:flex; align-items:center; justify-content:center; background:none; border:1px solid var(--lmm-border); color:var(--lmm-muted); padding:14px 32px; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; cursor:pointer; font-family:inherit; width:100%;">
          Annuler le rendez-vous
        </button>
      {% endif %}
    </div>
  </div>
</div>

<script>
  // === Menu mobile ===
  function toggleMobileNav() {
    var nav = document.getElementById('lmm-mobile-nav');
    if (nav.classList.contains('open')) {
      fermerMobileNav();
    } else {
      ouvrirMobileNav();
    }
  }

  function ouvrirMobileNav() {
    document.getElementById('lmm-mobile-nav').classList.add('open');
    document.getElementById('lmm-mobile-nav').setAttribute('aria-hidden', 'false');
    document.getElementById('lmm-mobile-nav-backdrop').classList.add('open');
    document.querySelector('.lmm-menu-toggle').setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function fermerMobileNav() {
    document.getElementById('lmm-mobile-nav').classList.remove('open');
    document.getElementById('lmm-mobile-nav').setAttribute('aria-hidden', 'true');
    document.getElementById('lmm-mobile-nav-backdrop').classList.remove('open');
    document.querySelector('.lmm-menu-toggle').setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  window.addEventListener('resize', function () {
    if (window.innerWidth > 900) fermerMobileNav();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') fermerMobileNav();
  });
  // === Fin menu mobile ===

  // === Localisation / Tailleur ===
  var tunnelUrl = 'https://lmm-backend.vercel.app';

  function ouvrirLocalisationModal() {
    afficherLocAuto();
    document.getElementById('lmm-localisation-modal').classList.add('open');
  }

  function fermerLocalisationModal() {
    document.getElementById('lmm-localisation-modal').classList.remove('open');
    document.getElementById('lmm-loc-erreur').style.display = 'none';
  }

  function afficherLocAuto() {
    document.getElementById('lmm-loc-auto').style.display = 'flex';
    document.getElementById('lmm-loc-loading').style.display = 'none';
    document.getElementById('lmm-loc-resultat').style.display = 'none';
    document.getElementById('lmm-code-postal').value = '';
    document.getElementById('lmm-loc-erreur').style.display = 'none';
    lmmMap = null;
    document.getElementById('lmm-map').innerHTML = '';
    document.getElementById('lmm-couturieres-liste').innerHTML = '';
  }

  function afficherLoading() {
    document.getElementById('lmm-loc-auto').style.display = 'none';
    document.getElementById('lmm-loc-loading').style.display = 'block';
    document.getElementById('lmm-loc-resultat').style.display = 'none';
    document.getElementById('lmm-loc-erreur').style.display = 'none';
  }

  var lmmLienCalChoisi = '';
  var lmmMap = null;
  var lmmMapCharge = false;
  var lmmVendeuseSeulement = false;
  var lmmListeActive = [];
  var lmmOrigine = null;

  function chargerGoogleMaps(callback) {
    if (window.google && window.google.maps) { callback(); return; }
    window._lmmMapCallback = callback;
    var s = document.createElement('script');
    s.src = 'https://maps.googleapis.com/maps/api/js?key=AIzaSyCyzVI3XFE-f8ir2aE4QTjUB0haaJRyhig&callback=_lmmMapCallback';
    s.async = true;
    document.head.appendChild(s);
  }

  function afficherResultat(couturieres) {
    lmmDernierResultat = couturieres;
    lmmVendeuseSeulement = false;
    document.getElementById('lmm-loc-loading').style.display = 'none';
    document.getElementById('lmm-loc-resultat').style.display = 'flex';
    rendererResultat();
  }

  function toggleVendeuseSeulement() {
    lmmVendeuseSeulement = !lmmVendeuseSeulement;
    rendererResultat();
  }

  function rendererResultat() {
    var hasVendeuse = lmmDernierResultat.some(function(c) { return c.vendeuse; });
    var legende = document.getElementById('lmm-vendeuse-legende');
    legende.style.display = hasVendeuse ? 'flex' : 'none';
    if (!hasVendeuse) lmmVendeuseSeulement = false;
    document.getElementById('lmm-vendeuse-toggle').classList.toggle('active', lmmVendeuseSeulement);

    var couturieres = lmmVendeuseSeulement
      ? lmmDernierResultat.filter(function(c) { return c.vendeuse; })
      : lmmDernierResultat;
    lmmListeActive = couturieres;

    var liste = document.getElementById('lmm-couturieres-liste');
    liste.innerHTML = '';

    if (!couturieres.length) {
      liste.innerHTML = '<p style="font-size:12px; color:var(--lmm-muted); text-align:center; padding:24px 0;">Aucun tailleur avec livres de tissus dans votre secteur pour l\'instant.</p>';
      if (lmmMap) { document.getElementById('lmm-map').innerHTML = ''; lmmMap = null; }
      return;
    }

    lmmLienCalChoisi = couturieres[0].lien_cal || '';

    couturieres.forEach(function(c, i) {
      var card = document.createElement('div');
      card.id = 'lmm-card-' + i;
      card.setAttribute('onclick', 'selectionnerCouturiere(' + i + ')');
      card.style.cssText = 'background:#fff; border:1px solid var(--lmm-border); padding:14px 18px; cursor:pointer; display:flex; justify-content:space-between; align-items:center;';
      var typeService = c.vendeuse
        ? '<span style="display:flex; align-items:center; gap:6px; font-size:10px; letter-spacing:0.03em; color:var(--lmm-gold); margin-top:4px;"><svg width="9" height="9" viewBox="0 0 9 9" style="flex-shrink:0;"><circle cx="4.5" cy="4.5" r="4.5" fill="var(--lmm-gold)"/></svg>Mensurations, altérations et visualisation des tissus</span>'
        : '<span style="display:flex; align-items:center; gap:6px; font-size:10px; letter-spacing:0.03em; color:var(--lmm-muted); margin-top:4px;"><svg width="7" height="7" viewBox="0 0 7 7" style="flex-shrink:0;"><circle cx="3.5" cy="3.5" r="3.5" fill="var(--lmm-text)"/></svg>Mensurations et altérations</span>';
      card.innerHTML = '<div style="flex:1;">' +
        (i === 0 ? '<p style="font-size:10px;color:var(--lmm-gold);letter-spacing:0.1em;text-transform:uppercase;margin:0 0 4px;">La plus proche</p>' : '') +
        '<p style="font-family:Georgia,serif;font-size:15px;color:var(--lmm-text);margin:0 0 2px;">' + c.nom + '</p>' +
        '<p style="font-size:11px;color:var(--lmm-muted);margin:0;">' + c.adresse + '</p>' +
        typeService +
        '</div>' +
        '<p id="lmm-btn-' + i + '" style="font-size:12px;color:var(--lmm-gold);margin:0;flex-shrink:0;margin-left:12px;">' + c.distance + '</p>';
      liste.appendChild(card);
    });
    selectionnerCouturiere(0);

    // Map — centrée sur la position du client (pas sur les tailleurs), avec un
    // zoom serré sur sa région pour éviter de dézoomer jusqu'à voir tout le Québec
    // dès qu'un tailleur plus lointain fait partie des résultats.
    chargerGoogleMaps(function() {
      var mapEl = document.getElementById('lmm-map');
      mapEl.innerHTML = '';
      var center = lmmOrigine || { lat: couturieres[0].lat, lng: couturieres[0].lng };
      lmmMap = new google.maps.Map(mapEl, {
        center: center,
        zoom: 11,
        disableDefaultUI: true,
        zoomControl: true,
        styles: [
          { elementType: 'geometry', stylers: [{ color: '#F5F2EE' }] },
          { elementType: 'labels.icon', stylers: [{ visibility: 'off' }] },
          { elementType: 'labels.text.fill', stylers: [{ color: '#888888' }] },
          { elementType: 'labels.text.stroke', stylers: [{ color: '#ffffff' }] },
          { featureType: 'water', elementType: 'geometry', stylers: [{ color: '#E3DFDA' }] },
          { featureType: 'road', elementType: 'geometry.fill', stylers: [{ color: '#ffffff' }] },
          { featureType: 'road', elementType: 'geometry.stroke', stylers: [{ color: '#E8E8E8' }] },
          { featureType: 'poi', stylers: [{ visibility: 'off' }] },
          { featureType: 'transit', stylers: [{ visibility: 'off' }] },
          { featureType: 'administrative', elementType: 'geometry', stylers: [{ color: '#E8E8E8' }] }
        ]
      });
      if (lmmOrigine) {
        new google.maps.Marker({
          position: lmmOrigine,
          map: lmmMap,
          title: 'Vous',
          icon: {
            path: google.maps.SymbolPath.CIRCLE,
            scale: 6,
            fillColor: '#4285F4',
            fillOpacity: 1,
            strokeColor: '#fff',
            strokeWeight: 2
          }
        });
      }
      couturieres.forEach(function(c, i) {
        var pos = { lat: c.lat, lng: c.lng };
        var isNearest = i === 0;
        // Couleurs littérales : l'API Google Maps ne résout pas les variables CSS
        // (var(--lmm-gold) etc.) — ce ne sont pas de vrais éléments DOM stylés.
        // Le format des tailleurs "tissus" est fixe (pas de variation selon la
        // proximité ou le filtre actif) pour rester cohérent d'une vue à l'autre.
        var icon = c.vendeuse
          ? {
              path: google.maps.SymbolPath.CIRCLE,
              scale: 11,
              fillColor: '#C9A96E',
              fillOpacity: 1,
              strokeColor: '#ffffff',
              strokeWeight: 2
            }
          : {
              // Doré réservé exclusivement aux tailleurs "tissus" (voir légende) —
              // le doré ne sert plus à indiquer "la plus proche" sur la carte, pour
              // éviter la confusion avec deux pastilles dorées identiques. La
              // proximité reste indiquée par la taille et par le libellé dans la liste.
              path: google.maps.SymbolPath.CIRCLE,
              scale: isNearest ? 10 : 7,
              fillColor: '#1C1C1C',
              fillOpacity: 1,
              strokeColor: '#ffffff',
              strokeWeight: 2
            };
        new google.maps.Marker({
          position: pos,
          map: lmmMap,
          title: c.nom + (c.vendeuse ? ' — présente les tissus' : ''),
          icon: icon
        });
      });
    });
  }

  var lmmDernierResultat = [];
  var lmmIndexChoisi = 0;

  function selectionnerCouturiere(index) {
    lmmIndexChoisi = index;
    lmmLienCalChoisi = lmmListeActive[index].lien_cal || '';
    var n = lmmListeActive.length;
    for (var j = 0; j < n; j++) {
      var card = document.getElementById('lmm-card-' + j);
      var btn = document.getElementById('lmm-btn-' + j);
      if (!card || !btn) continue;
      if (j === index) {
        card.style.background = 'var(--lmm-surface)';
        card.style.borderColor = 'var(--lmm-gold)';
        btn.style.background = 'var(--lmm-text)';
        btn.style.color = '#ffffff';
      } else {
        card.style.background = '#fff';
        card.style.borderColor = 'var(--lmm-border)';
        btn.style.background = 'var(--lmm-border)';
        btn.style.color = 'var(--lmm-muted)';
      }
    }
  }

  function localiserAuto() {
    if (!navigator.geolocation) {
      document.getElementById('lmm-loc-erreur').style.display = 'block';
      return;
    }
    afficherLoading();
    navigator.geolocation.getCurrentPosition(
      function(pos) {
        fetch(tunnelUrl + '/api/couturiere', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lat: pos.coords.latitude, lng: pos.coords.longitude })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.success) {
            lmmOrigine = { lat: pos.coords.latitude, lng: pos.coords.longitude };
            lmmDernierResultat = data.couturieres;
            afficherResultat(data.couturieres);
          } else {
            afficherLocAuto();
            document.getElementById('lmm-loc-erreur').style.display = 'block';
          }
        })
        .catch(function() {
          afficherLocAuto();
          document.getElementById('lmm-loc-erreur').style.display = 'block';
        });
      },
      function() {
        afficherLocAuto();
        document.getElementById('lmm-loc-erreur').style.display = 'block';
      }
    );
  }

  function localiserParCodePostal() {
    var cp = document.getElementById('lmm-code-postal').value.trim();
    if (!cp) return;
    afficherLoading();
    fetch(tunnelUrl + '/api/couturiere', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ codePostal: cp })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        lmmOrigine = data.origine || null;
        lmmDernierResultat = data.couturieres;
        afficherResultat(data.couturieres);
      } else {
        afficherLocAuto();
        document.getElementById('lmm-loc-erreur').textContent = data.error || 'Code postal invalide.';
        document.getElementById('lmm-loc-erreur').style.display = 'block';
      }
    })
    .catch(function() {
      afficherLocAuto();
      document.getElementById('lmm-loc-erreur').style.display = 'block';
    });
  }

  function confirmerCouturiereEtOuvrirCal() {
    fermerLocalisationModal();
    calCharge = false;
    ouvrirCalModal(lmmLienCalChoisi);
  }
  // === Fin Localisation ===

  var calCharge = false;
  function ouvrirCalModal(lienCal) {
    document.getElementById('lmm-cal-modal').classList.add('open');
    if (!calCharge) {
      calCharge = true;
      var lien = lienCal || 'felix-morissette-cf6pjb/test-site';
      var calUrl = 'https://cal.com/' + lien;
      {% if customer %}
        calUrl += '?email={{ customer.email | url_encode }}';
        {% assign full_name = customer.first_name | append: ' ' | append: customer.last_name | strip %}
        {% if full_name != blank %}
          calUrl += '&name={{ full_name | url_encode }}';
        {% endif %}
      {% endif %}
      document.getElementById('lmm-cal-iframe').src = calUrl;
    }
  }
  function fermerCalModal() {
    document.getElementById('lmm-cal-modal').classList.remove('open');
  }
  function retourSelectionCouturiere() {
    document.getElementById('lmm-cal-modal').classList.remove('open');
    document.getElementById('lmm-localisation-modal').classList.add('open');
  }

  var rescheduleCharge = false;
  function ouvrirRescheduleModal() {
    fermerGestionModal();
    document.getElementById('lmm-reschedule-modal').classList.add('open');
    if (!rescheduleCharge) {
      rescheduleCharge = true;
      document.getElementById('lmm-reschedule-iframe').src = 'https://cal.com/reschedule/{{ customer.metafields.custom.rdv_uid }}';
    }
  }
  function fermerRescheduleModal() {
    document.getElementById('lmm-reschedule-modal').classList.remove('open');
    rescheduleCharge = false;
    document.getElementById('lmm-reschedule-iframe').src = '';
  }

  function ouvrirGestionModal() {
    document.getElementById('lmm-gestion-modal').classList.add('open');
  }

  function fermerGestionModal() {
    document.getElementById('lmm-gestion-modal').classList.remove('open');
  }

  function ouvrirAnnulationModal() {
    lmmAnnulationPourChangement = false;
    fermerGestionModal();
    document.getElementById('lmm-annulation-raison').value = '';
    document.getElementById('lmm-annulation-modal').classList.add('open');
  }

  var lmmAnnulationPourChangement = false;
  function ouvrirChangementCouturiere() {
    lmmAnnulationPourChangement = true;
    fermerGestionModal();
    document.getElementById('lmm-annulation-raison').value = 'Changement de tailleur';
    document.getElementById('lmm-annulation-modal').classList.add('open');
  }

  function fermerAnnulationModal() {
    document.getElementById('lmm-annulation-modal').classList.remove('open');
    document.getElementById('lmm-annulation-raison').value = '';
    document.getElementById('lmm-annulation-erreur').style.display = 'none';
  }

  function confirmerAnnulation() {
    var raison = document.getElementById('lmm-annulation-raison').value;
    var uid = '{{ customer.metafields.custom.rdv_uid }}';
    var pourChangement = lmmAnnulationPourChangement;

    // Afficher l'overlay immédiatement
    fermerAnnulationModal();
    var overlay = document.getElementById('lmm-booking-overlay');
    overlay.querySelector('p:first-child').textContent = 'Annulation en cours...';
    overlay.style.display = 'flex';

    fetch(tunnelUrl + '/api/cal-cancel', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ uid: uid, reason: raison })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        if (pourChangement) {
          overlay.style.display = 'none';
          ouvrirLocalisationModal();
        } else {
          overlay.querySelector('p:first-child').textContent = 'Rendez-vous annulé';
          setTimeout(function() { window.location.reload(); }, 2000);
        }
      } else {
        overlay.style.display = 'none';
        document.getElementById('lmm-annulation-modal').classList.add('open');
        document.getElementById('lmm-annulation-erreur').style.display = 'block';
      }
    })
    .catch(function() {
      overlay.style.display = 'none';
      document.getElementById('lmm-annulation-modal').classList.add('open');
      document.getElementById('lmm-annulation-erreur').style.display = 'block';
    });
  }

  var emailRdv = '';

  window.addEventListener('message', function(e) {
    if (!e.data) return;
    var data = e.data.data || e.data;
    var type = e.data.type || (e.data.data && e.data.data.type) || '';

    // Capter l'email depuis les données Cal.com
    if (data && data.booking && data.booking.attendees && data.booking.attendees[0]) {
      emailRdv = data.booking.attendees[0].email || '';
    }
    if (data && data.email) emailRdv = data.email;

    if (type === 'bookingSuccessful' || type === '__cal__bookingSuccessful' || type === 'booking_successful' || String(type).toLowerCase().includes('booking')) {
      afficherConfirmation();
    }
  });

  document.getElementById('lmm-cal-iframe').addEventListener('load', function() {
    try {
      var iframeUrl = this.contentWindow.location.href;
      if (iframeUrl && (iframeUrl.includes('/booking/') || iframeUrl.includes('confirmed') || iframeUrl.includes('success'))) {
        afficherConfirmation();
      }
    } catch(e) {}
  });

  function afficherConfirmation() {
    fermerCalModal();
    {% unless customer %}
      // Sauvegarder le booking en localStorage pour synchronisation après connexion
      if (emailRdv) {
        document.getElementById('lmm-signup-email').value = emailRdv;
        document.getElementById('lmm-signup-link').href = '/account/login';
      }
      // Stocker les infos RDV pour les appliquer après connexion
      localStorage.setItem('lmm_rdv_pending', JSON.stringify({ email: emailRdv, ts: Date.now() }));
      document.getElementById('lmm-signup-modal').classList.add('open');
    {% else %}
      var overlay = document.getElementById('lmm-booking-overlay');
      overlay.querySelector('p:first-child').textContent = 'Rendez-vous confirmé';
      overlay.style.display = 'flex';

      // On attend la confirmation réelle de la synchronisation (au lieu d'un
      // délai fixe qui peut recharger la page avant que le webhook Cal.com
      // ait fini d'écrire les metafields) avant de rediriger. Un filet de
      // sécurité limite l'attente maximale pour ne jamais bloquer l'utilisateur.
      var syncTermine = fetch(tunnelUrl + '/api/cal-sync', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: '{{ customer.email }}' })
      }).catch(function() {});

      var delaiMax = new Promise(function(resolve) { setTimeout(resolve, 6000); });

      Promise.race([syncTermine, delaiMax]).then(function() {
        window.location.href = '/cart';
      });
    {% endunless %}
  }
</script>

{% stylesheet %}
  .lmm-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--lmm-bordeaux);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    height: 104px;
  }

  .lmm-header__inner {
    max-width: 1520px;
    margin: 0 auto;
    padding: 0 32px;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    align-items: center;
  }

  .lmm-header__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  /* Séparateur discret entre chaque zone : une petite ligne verticale
     centrée (pas toute la hauteur du header), assez subtile pour
     apaiser l'œil sans attirer l'attention — et qui montre au passage
     que les 7 zones sont bien réparties également. */
  .lmm-header__cell + .lmm-header__cell::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 22px;
    background: rgba(var(--lmm-ivoire-deep-rgb), 0.18);
  }

  .lmm-header__logo {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lmm-header__logo-img {
    display: block;
    width: auto;
  }

  .lmm-logo-main {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 26px;
    font-weight: 400;
    color: var(--lmm-ivoire-pale);
    letter-spacing: 0.04em;
  }

  .lmm-logo-sub {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lmm-bordeaux-pale);
    margin-top: 3px;
  }

  .lmm-nav-link {
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--lmm-ivoire-pale);
    transition: color 0.2s;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .lmm-nav-link:hover,
  .lmm-nav-link--active {
    color: var(--lmm-ivoire-pale);
  }

  /* Sous-menu "À propos" — s'ouvre au survol (desktop uniquement, voir
     le tiroir mobile pour l'équivalent tactile). La cellule doit couvrir
     toute la hauteur du header (contrairement aux autres cellules, qui
     s'ajustent à leur contenu) pour que le sous-menu, ancré à top:100%,
     s'aligne exactement sous le header plutôt qu'au milieu. */
  .lmm-header__cell--dropdown {
    height: 100%;
  }

  .lmm-header__dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    background: var(--lmm-bordeaux);
    border: 1px solid rgba(var(--lmm-ivoire-deep-rgb), 0.18);
    min-width: 200px;
    padding: 8px 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
    z-index: 50;
  }

  .lmm-header__cell--dropdown:hover .lmm-header__dropdown,
  .lmm-header__cell--dropdown:focus-within .lmm-header__dropdown {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  .lmm-header__dropdown-link {
    display: block;
    padding: 12px 22px;
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--lmm-ivoire-pale);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease;
  }

  .lmm-header__dropdown-link:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .lmm-header__icons {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .lmm-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--lmm-ivoire-pale);
    text-decoration: none;
    transition: color 0.2s;
    position: relative;
  }

  .lmm-icon-btn:hover {
    color: var(--lmm-ivoire-pale);
  }

  .lmm-icon-btn svg {
    width: 19px;
    height: 19px;
  }

  .lmm-cart-count {
    position: absolute;
    top: -6px;
    right: -8px;
    background: var(--lmm-ivoire);
    color: var(--lmm-bordeaux);
    font-size: 9px;
    font-weight: 600;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lmm-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Bouton hamburger — caché en desktop, seule la grille du header en
     dessous de 900px le fait apparaître (voir @media plus bas). Les 3
     barres se transforment en croix à l'ouverture. */
  .lmm-header__cell--toggle {
    display: none;
  }

  .lmm-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .lmm-menu-toggle__bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--lmm-ivoire-pale);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .lmm-menu-toggle[aria-expanded="true"] .lmm-menu-toggle__bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .lmm-menu-toggle[aria-expanded="true"] .lmm-menu-toggle__bar:nth-child(2) {
    opacity: 0;
  }

  .lmm-menu-toggle[aria-expanded="true"] .lmm-menu-toggle__bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* Tiroir du menu mobile — panneau plein-largeur ancré sous le header
     fixe (top: 104px, hauteur du header). Caché par défaut (opacity +
     pointer-events) plutôt que display:none pour permettre la
     transition d'ouverture. */
  .lmm-mobile-nav {
    position: fixed;
    top: 104px;
    left: 0;
    right: 0;
    background: var(--lmm-bordeaux);
    z-index: 99;
    display: flex;
    flex-direction: column;
    padding: 8px 24px 24px;
    max-height: calc(100dvh - 104px);
    overflow-y: auto;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .lmm-mobile-nav.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .lmm-mobile-nav__link {
    text-decoration: none;
    font-size: 15px;
    letter-spacing: 0.02em;
    color: var(--lmm-ivoire-pale);
    padding: 16px 4px;
    border-bottom: 1px solid rgba(var(--lmm-ivoire-deep-rgb), 0.18);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .lmm-mobile-nav__link:last-child {
    border-bottom: none;
  }

  .lmm-mobile-nav__link--active {
    color: var(--lmm-ivoire);
  }

  .lmm-mobile-nav__backdrop {
    display: none;
    position: fixed;
    top: 104px;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(28, 28, 28, 0.45);
    z-index: 98;
  }

  .lmm-mobile-nav__backdrop.open {
    display: block;
  }

  /* En dessous de 900px, la grille à 7 colonnes du header déborde déjà
     (liens qui se compressent/chevauchent) — on bascule sur un hamburger
     plutôt que d'essayer de faire tenir 5 liens + logo + icônes sur une
     seule rangée. */
  @media (max-width: 900px) {
    .lmm-header__inner {
      grid-template-columns: 40px 1fr 76px;
      padding: 0 20px;
    }

    .lmm-header__cell--toggle {
      display: flex;
      justify-content: flex-start;
    }

    .lmm-header__cell--nav {
      display: none;
    }

    .lmm-header__cell + .lmm-header__cell::before {
      display: none;
    }
  }

  body {
    padding-top: 104px;
    background: var(--lmm-surface);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--lmm-text);
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .lmm-main {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
  }

  .lmm-cal-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(28,28,28,0.7);
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .lmm-cal-modal.open {
    display: flex;
  }

  .lmm-cal-modal__inner {
    background: #fff;
    width: 90%;
    max-width: 820px;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
  }

  .lmm-cal-modal__close {
    position: absolute;
    top: 12px;
    right: 16px;
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: var(--lmm-muted);
    z-index: 1;
    line-height: 1;
  }

  .lmm-cal-modal__close:hover {
    color: var(--lmm-text);
  }

  #lmm-cal-embed {
    min-height: 600px;
  }

  .lmm-toggle-track {
    position: relative;
    display: inline-block;
    width: 30px;
    height: 17px;
    background: var(--lmm-border);
    border-radius: 10px;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }

  .lmm-toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 13px;
    height: 13px;
    background: #ffffff;
    border-radius: 50%;
    box-shadow: 0 1px 2px rgba(0,0,0,0.25);
    transition: transform 0.2s ease;
  }

  #lmm-vendeuse-toggle.active .lmm-toggle-track {
    background: var(--lmm-gold);
  }

  #lmm-vendeuse-toggle.active .lmm-toggle-thumb {
    transform: translateX(13px);
  }

  @keyframes lmm-progress {
    from { width: 0px; }
    to { width: 200px; }
  }
{% endstylesheet %}

