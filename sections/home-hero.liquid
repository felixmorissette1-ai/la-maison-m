<section class="lmm-hero full-width">
  {% if section.settings.hero_photo %}
    <div class="lmm-hero__photo-block">
      <div class="lmm-hero__photo" style="background-image: url({{ section.settings.hero_photo | image_url: width: 1800 }});"></div>
      <div class="lmm-hero__wash"></div>
    </div>
  {% endif %}

  <div class="lmm-hero__text">
    <div class="lmm-hero__inner">
      <div class="lmm-hero__title-wrap">
        <div class="lmm-hero__title-block">
          <h1 class="lmm-hero__title">{{ section.settings.title }}</h1>
        </div>
      </div>
      <a href="{{ section.settings.step1_url }}" class="lmm-hero__cta">
        {{ section.settings.step1_label }}
      </a>

      <!-- Titre + numéros/titres du plan d'action — vivent ici (une seule
           instance, pas une copie) pour pouvoir rester figés avec le
           slogan/bouton pendant le défilement. Seules les descriptions de
           chaque étape restent dans la section .lmm-plan plus bas. -->
      <div class="lmm-hero__plan-head">
        <div class="lmm-plan__inner">
          <p class="lmm-plan__title">{{ section.settings.plan_title }}</p>
          <div class="lmm-plan__num-row">
            <span class="lmm-plan__num">01</span>
            <span class="lmm-plan__num">02</span>
            <span class="lmm-plan__num">03</span>
            <div class="lmm-plan__step-head">
              <span class="lmm-plan__step-title">{{ section.settings.step1_label }}</span>
            </div>
            <a href="#" class="lmm-plan__step-head lmm-plan__step-head--link" onclick="event.preventDefault(); ouvrirLocalisationModal()">
              <span class="lmm-plan__step-title">{{ section.settings.step2_label }}</span>
            </a>
            <div class="lmm-plan__step-head">
              <span class="lmm-plan__step-title">{{ section.settings.step3_label }}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="lmm-plan full-width">
  <div class="lmm-plan__inner">
    <div class="lmm-plan__row">
      <div class="lmm-plan__step">
        <div class="lmm-plan__desc">
          <p class="lmm-plan__intro">{{ section.settings.step1_intro }}</p>
          <ul class="lmm-plan__list">
            {% assign step1_lines = section.settings.step1_bullets | newline_to_br | split: '<br />' %}
            {% for line in step1_lines %}
              {% if line != blank %}<li>{{ line }}</li>{% endif %}
            {% endfor %}
            <li>Conseil stylistique — <a href="/pages/aide-configuration" class="lmm-plan__link">écrivez-nous</a></li>
            <li>Envie de voir les tissus avant de commander ? <a href="#" class="lmm-plan__link" onclick="event.preventDefault(); ouvrirLocalisationModal()">Prenez rendez-vous</a></li>
          </ul>
        </div>
      </div>

      <div class="lmm-plan__step">
        <div class="lmm-plan__desc">
          <p class="lmm-plan__intro">{{ section.settings.step2_intro }}</p>
          <ul class="lmm-plan__list">
            {% assign step2_lines = section.settings.step2_bullets | newline_to_br | split: '<br />' %}
            {% for line in step2_lines %}
              {% if line != blank %}<li>{{ line }}</li>{% endif %}
            {% endfor %}
            <li id="lmm-plan-ville-item"><span id="lmm-plan-ville">Partenaire disponible près de chez vous</span></li>
            <li><a href="#" class="lmm-plan__link" onclick="event.preventDefault(); ouvrirLocalisationModal()">Prenez rendez-vous</a> pour vos mensurations</li>
          </ul>
        </div>
      </div>

      <div class="lmm-plan__step">
        <div class="lmm-plan__desc">
          <p class="lmm-plan__intro">{{ section.settings.step3_intro }}</p>
          <ul class="lmm-plan__list">
            {% assign step3_lines = section.settings.step3_bullets | newline_to_br | split: '<br />' %}
            {% for line in step3_lines %}
              {% if line != blank %}<li>{{ line }}</li>{% endif %}
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Ville la plus proche pour l'étape 2 — demande la localisation dès
  // l'arrivée sur la page d'accueil ; échoue silencieusement (refus,
  // navigateur sans support, aucun tailleur dans un rayon raisonnable).
  (function () {
    var villeEl = document.getElementById('lmm-plan-ville');
    if (!villeEl || !navigator.geolocation) return;

    navigator.geolocation.getCurrentPosition(function (pos) {
      fetch('https://lmm-backend.vercel.app/api/couturiere', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lat: pos.coords.latitude, lng: pos.coords.longitude })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var nearest = data && data.success && data.couturieres && data.couturieres[0];
          if (nearest && nearest.ville && nearest.distanceValue < 100000) {
            villeEl.textContent = 'Partenaire disponible à ' + nearest.ville;
          }
        })
        .catch(function () {});
    }, function () {}, { timeout: 8000 });
  })();

  // Le titre + les numéros du plan vivent maintenant dans le hero, donc
  // il n'y a plus besoin de mesurer un "reveal height" séparé — le hero
  // prend simplement tout l'espace disponible sous le header, sur les
  // deux tailles d'écran.
  //
  // Mobile (<768px) : défilement normal, aucun effet — le hero est juste
  // dimensionné pour remplir l'écran.
  //
  // Desktop (>=768px) : la photo occupe tout l'écran dispo. Le contenu du
  // hero (slogan, bouton, titre+numéros du plan) reste figé (position:
  // sticky) pendant qu'on défile à travers une zone de 2 écrans de haut —
  // seul l'arrière-plan bouge, jusqu'à ce qu'il devienne 100% beige, puis
  // le défilement redevient normal et révèle les descriptions.
  (function () {
    var hero = document.querySelector('.lmm-hero');
    var header = document.querySelector('.lmm-header');
    var photoBlock = document.querySelector('.lmm-hero__photo-block');
    var heroText = document.querySelector('.lmm-hero__text');
    if (!hero || !header) return;

    var MIN_HERO_HEIGHT = 560;
    var desktopQuery = window.matchMedia('(min-width: 768px)');

    function updateMobile() {
      var headerHeight = header.getBoundingClientRect().height;
      var target = window.innerHeight - headerHeight;
      hero.style.height = Math.max(target, MIN_HERO_HEIGHT) + 'px';
      if (photoBlock) photoBlock.style.height = '';
      if (heroText) heroText.style.height = '';
    }

    function updateDesktopZone() {
      if (!photoBlock || !heroText) { updateMobile(); return; }
      var headerHeight = header.getBoundingClientRect().height;
      var photoHeight = Math.max(window.innerHeight - headerHeight, MIN_HERO_HEIGHT);
      hero.style.height = (photoHeight * 2) + 'px';
      photoBlock.style.height = photoHeight + 'px';
      heroText.style.height = photoHeight + 'px';
    }

    function update() {
      if (desktopQuery.matches) {
        updateDesktopZone();
      } else {
        updateMobile();
      }
    }

    update();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(update);
    }
    window.addEventListener('load', update);

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(update, 120);
    });
  })();
</script>

{% stylesheet %}
  /* ===== Hero ===== */
  .lmm-hero {
    position: relative;
    background: var(--lmm-ivoire);
    height: calc(100dvh - 104px);
    min-height: 560px;
    overflow: hidden;
  }

  .lmm-hero__photo-block {
    position: absolute;
    inset: 0;
  }

  .lmm-hero__photo {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    filter: grayscale(0.55) sepia(0.35) brightness(1.18) contrast(0.86) saturate(0.85);
  }

  .lmm-hero__wash {
    position: absolute;
    inset: 0;
    background: rgba(var(--lmm-ivoire-rgb), 0.38);
  }

  .lmm-hero__text {
    position: relative;
    height: 100%;
    z-index: 2;
  }

  .lmm-hero__inner {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px 32px 40px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  /* Occupe tout l'espace entre le header et le bouton, et centre le
     slogan à l'intérieur de cet espace. */
  .lmm-hero__title-wrap {
    flex: 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Boîte "inline-block" : sa largeur épouse exactement le texte du
     slogan (pas la largeur du hero). */
  .lmm-hero__title-block {
    display: inline-block;
    text-align: center;
  }

  .lmm-hero__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(24px, 3.2vw, 44px);
    font-weight: 400;
    color: var(--lmm-text);
    line-height: 1.3;
    text-align: center;
    margin: 0;
  }

  .lmm-hero__cta {
    display: inline-flex;
    background: var(--lmm-bordeaux);
    color: var(--lmm-ivoire);
    text-decoration: none;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 20px;
    padding: 22px 44px;
    border-radius: 8px;
    white-space: nowrap;
  }

  .lmm-hero__plan-head {
    width: 100%;
  }

  .lmm-hero__plan-head .lmm-plan__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0;
  }

  @media (min-width: 768px) {
    .lmm-hero__title {
      white-space: nowrap;
    }

    /* ===== Desktop : photo pleine page, contenu figé pendant le défilement =====
       Les hauteurs sont fixées en JS (voir <script>). Le texte est
       "sticky" : il reste à l'écran tant qu'on défile à travers la zone,
       puis reprend le flux normal une fois la zone terminée — pas
       d'animation, juste du CSS natif. */
    .lmm-hero {
      overflow: visible;
    }

    .lmm-hero__photo-block {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: auto;
      overflow: hidden;
      z-index: 1;
    }

    .lmm-hero__text {
      position: sticky;
      top: 104px;
    }
  }

  /* ===== Titre + numéros/titres du plan (dans le hero) ===== */
  .lmm-plan__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--lmm-text);
    text-align: left;
    margin: 0 0 24px;
    max-width: 640px;
  }

  @media (max-width: 767px) {
    .lmm-plan__title {
      font-size: 28px;
    }
  }

  .lmm-plan__num-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 28px;
    row-gap: 10px;
  }

  .lmm-plan__num {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 32px;
    font-weight: 400;
    color: var(--lmm-bordeaux-soft);
  }

  .lmm-plan__step-head {
    display: flex;
    align-items: flex-start;
    text-align: left;
    text-decoration: none;
  }

  .lmm-plan__step-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--lmm-text);
  }

  .lmm-plan__step-head--link {
    cursor: pointer;
  }

  .lmm-plan__step-head--link .lmm-plan__step-title {
    transition: color 0.2s;
  }

  .lmm-plan__step-head--link:hover .lmm-plan__step-title {
    color: var(--lmm-bordeaux-soft);
  }

  @media (max-width: 767px) {
    .lmm-plan__num-row {
      grid-template-columns: 1fr;
      row-gap: 20px;
    }
  }

  /* ===== Section plan d'action (descriptions seulement) ===== */
  .lmm-plan {
    position: relative;
    background: var(--lmm-ivoire);
    padding: 60px 32px 90px;
  }

  /* Fondu vers la couleur de la section suivante (Statistiques). */
  .lmm-plan::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30px;
    background: linear-gradient(to bottom, transparent, var(--lmm-ivoire-pale));
    pointer-events: none;
  }

  .lmm-plan__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .lmm-plan__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 28px;
    row-gap: 24px;
    align-items: stretch;
  }

  .lmm-plan__step {
    box-sizing: border-box;
    border: 1px solid var(--lmm-ivoire-line);
    border-radius: 10px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .lmm-plan__desc {
    width: 100%;
    text-align: left;
  }

  .lmm-plan__intro {
    font-size: 15.5px;
    color: var(--lmm-text);
    line-height: 1.6;
    text-align: left;
    margin: 0 0 20px;
  }

  .lmm-plan__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .lmm-plan__list li {
    font-size: 13.5px;
    color: var(--lmm-muted);
    line-height: 1.5;
    text-align: left;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  /* Beau rond vide devant chaque point. */
  .lmm-plan__list li::before {
    content: '○';
    display: inline-block;
    margin-right: 7px;
    color: var(--lmm-bordeaux-soft);
    font-size: 11px;
    vertical-align: 1px;
  }

  .lmm-plan__link {
    color: var(--lmm-bordeaux-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 767px) {
    .lmm-plan__row {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero — Accueil",
  "settings": [
    { "type": "image_picker", "id": "hero_photo", "label": "Photo de fond (laisser vide pour fond ivoire uni)" },
    { "type": "text", "id": "title", "label": "Slogan", "default": "Parce que la première impression compte" },

    { "type": "header", "content": "Plan d'action" },
    { "type": "text", "id": "plan_title", "label": "Titre du plan", "default": "En seulement trois étapes" },

    { "type": "text", "id": "step1_label", "label": "Étape 1 — texte du bouton", "default": "Configurez votre complet" },
    { "type": "url", "id": "step1_url", "label": "Étape 1 — lien" },
    { "type": "text", "id": "step1_intro", "label": "Étape 1 — phrase d'intro", "default": "Configurez votre complet de A à Z, ou commandez directement dans notre collection." },
    { "type": "textarea", "id": "step1_bullets", "label": "Étape 1 — points (un par ligne)", "default": "5 minutes" },

    { "type": "text", "id": "step2_label", "label": "Étape 2 — titre", "default": "Rendez-vous mensurations" },
    { "type": "text", "id": "step2_intro", "label": "Étape 2 — phrase d'intro", "default": "Vos mensurations sont prises par un de nos professionnels pour assurer un ajustement parfait." },
    { "type": "textarea", "id": "step2_bullets", "label": "Étape 2 — points (un par ligne)", "default": "30 minutes" },

    { "type": "text", "id": "step3_label", "label": "Étape 3 — titre", "default": "Recevez votre complet" },
    { "type": "text", "id": "step3_intro", "label": "Étape 3 — phrase d'intro", "default": "Profitez d'un complet parfaitement ajusté à votre silhouette pour une allure à la hauteur de vos ambitions." },
    { "type": "textarea", "id": "step3_bullets", "label": "Étape 3 — points (un par ligne)", "default": "Livraison à domicile\n4-8 semaines\nRetouches gratuites au besoin" }
  ],
  "presets": [
    { "name": "Hero — Accueil" }
  ]
}
{% endschema %}
