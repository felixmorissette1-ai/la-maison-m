<section class="lmm-hero full-width">
  {% if section.settings.hero_photo %}
    <div class="lmm-hero__photo" style="background-image: url({{ section.settings.hero_photo | image_url: width: 1800 }});"></div>
    <div class="lmm-hero__wash"></div>
  {% endif %}

  <div class="lmm-hero__inner">
    <h1 class="lmm-hero__title">{{ section.settings.title }}</h1>
  </div>
</section>

<section class="lmm-plan full-width">
  <div class="lmm-plan__inner">
    <p class="lmm-plan__title">{{ section.settings.plan_title }}</p>

    <div class="lmm-plan__row">
      <div class="lmm-plan__step">
        <a href="{{ section.settings.step1_url }}" class="lmm-plan__step-head lmm-plan__step-head--btn">
          <span class="lmm-plan__num">01</span>
          <span class="lmm-plan__step-title">{{ section.settings.step1_label }}</span>
        </a>
        <ul class="lmm-plan__list">
          {% assign step1_lines = section.settings.step1_bullets | newline_to_br | split: '<br />' %}
          {% for line in step1_lines %}
            {% if line != blank %}<li>{{ line }}</li>{% endif %}
          {% endfor %}
          <li>Besoin d'aide ? <a href="#" class="lmm-plan__link" onclick="event.preventDefault(); ouvrirLocalisationModal()">prenez rendez-vous</a> ou <a href="/pages/aide-configuration" class="lmm-plan__link">écrivez-nous</a></li>
        </ul>
      </div>

      <div class="lmm-plan__line"></div>

      <div class="lmm-plan__step">
        <a href="#" class="lmm-plan__step-head lmm-plan__step-head--link" onclick="event.preventDefault(); ouvrirLocalisationModal()">
          <span class="lmm-plan__num">02</span>
          <span class="lmm-plan__step-title">{{ section.settings.step2_label }}</span>
        </a>
        <ul class="lmm-plan__list">
          {% assign step2_lines = section.settings.step2_bullets | newline_to_br | split: '<br />' %}
          {% for line in step2_lines %}
            {% if line != blank %}<li>{{ line }}</li>{% endif %}
          {% endfor %}
          <li id="lmm-plan-ville-item" style="display:none;"><span id="lmm-plan-ville"></span></li>
        </ul>
      </div>

      <div class="lmm-plan__line"></div>

      <div class="lmm-plan__step">
        <div class="lmm-plan__step-head">
          <span class="lmm-plan__num">03</span>
          <span class="lmm-plan__step-title">{{ section.settings.step3_label }}</span>
        </div>
        <ul class="lmm-plan__list">
          {% assign step3_lines = section.settings.step3_bullets | newline_to_br | split: '<br />' %}
          {% for line in step3_lines %}
            {% if line != blank %}<li>{{ line }}</li>{% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  // Ville la plus proche pour l'étape 2 — demande la localisation dès
  // l'arrivée sur la page d'accueil ; échoue silencieusement (refus,
  // navigateur sans support, aucun tailleur dans un rayon raisonnable).
  (function () {
    var villeEl = document.getElementById('lmm-plan-ville');
    if (!villeEl || !navigator.geolocation) return;

    navigator.geolocation.getCurrentPosition(function (pos) {
      fetch('https://lmm-backend.vercel.app/api/couturiere', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lat: pos.coords.latitude, lng: pos.coords.longitude })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var nearest = data && data.success && data.couturieres && data.couturieres[0];
          if (nearest && nearest.ville && nearest.distanceValue < 100000) {
            villeEl.textContent = 'Disponible à ' + nearest.ville;
            document.getElementById('lmm-plan-ville-item').style.display = '';
          }
        })
        .catch(function () {});
    }, function () {}, { timeout: 8000 });
  })();
</script>

{% stylesheet %}
  .lmm-hero {
    position: relative;
    background: var(--lmm-ivoire);
    /* Volontairement moins que 100% de l'écran : le bas de la section
       suivante (.lmm-plan) doit dépasser visible sous le pli au chargement,
       comme indice pour inciter à défiler. */
    height: calc(100dvh - 104px - 320px);
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .lmm-hero__photo {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    filter: grayscale(0.55) sepia(0.35) brightness(1.18) contrast(0.86) saturate(0.85);
  }

  .lmm-hero__wash {
    position: absolute;
    inset: 0;
    background: rgba(var(--lmm-ivoire-rgb), 0.38);
  }

  .lmm-hero__inner {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lmm-hero__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(24px, 3.2vw, 44px);
    font-weight: 400;
    color: var(--lmm-text);
    line-height: 1.3;
    text-align: center;
    margin: 0;
  }

  @media (min-width: 768px) {
    .lmm-hero__title {
      white-space: nowrap;
    }
  }

  .lmm-plan {
    background: var(--lmm-ivoire);
    padding: 64px 32px 90px;
  }

  .lmm-plan__inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .lmm-plan__title {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lmm-bordeaux-soft);
    text-align: center;
    margin: 0 0 40px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .lmm-plan__row {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
  }

  .lmm-plan__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    flex: 1;
    max-width: 320px;
    padding: 0 20px;
  }

  .lmm-plan__line {
    width: 100%;
    max-width: 60px;
    border-top: 1px solid var(--lmm-ivoire-line);
    align-self: flex-start;
    /* Aligne la ligne sur le centre vertical du grand numéro (40px, en
       haut de chaque étape). */
    margin-top: 34px;
    flex-shrink: 1;
  }

  /* Même format de numéro et de titre pour les 3 étapes — seule la
     décoration (fond bordeaux pour l'étape 1, curseur pour l'étape 2)
     change selon que l'étape est cliquable ou non. */
  .lmm-plan__step-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-decoration: none;
  }

  .lmm-plan__num {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 40px;
    font-weight: 400;
    color: var(--lmm-ivoire-line);
  }

  .lmm-plan__step-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 26px;
    font-weight: 400;
    color: var(--lmm-text);
  }

  .lmm-plan__step-head--btn {
    background: var(--lmm-bordeaux);
    border-radius: 12px;
    padding: 24px 20px;
  }

  .lmm-plan__step-head--btn .lmm-plan__num {
    color: var(--lmm-bordeaux-pale);
  }

  .lmm-plan__step-head--btn .lmm-plan__step-title {
    color: var(--lmm-ivoire);
  }

  .lmm-plan__step-head--link {
    cursor: pointer;
  }

  .lmm-plan__step-head--link .lmm-plan__step-title {
    transition: color 0.2s;
  }

  .lmm-plan__step-head--link:hover .lmm-plan__step-title {
    color: var(--lmm-bordeaux-soft);
  }

  .lmm-plan__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: inline-flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
  }

  .lmm-plan__list li {
    position: relative;
    padding-left: 20px;
    font-size: 17px;
    color: var(--lmm-text);
    line-height: 1.6;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .lmm-plan__list li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--lmm-bordeaux-soft);
  }

  .lmm-plan__link {
    color: var(--lmm-bordeaux-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero — Accueil",
  "settings": [
    { "type": "image_picker", "id": "hero_photo", "label": "Photo de fond (laisser vide pour fond ivoire uni)" },
    { "type": "text", "id": "title", "label": "Slogan", "default": "Parce que la première impression compte." },

    { "type": "header", "content": "Plan d'action" },
    { "type": "text", "id": "plan_title", "label": "Titre du plan", "default": "Comment ça fonctionne" },

    { "type": "text", "id": "step1_label", "label": "Étape 1 — texte du bouton", "default": "Configurez votre complet" },
    { "type": "url", "id": "step1_url", "label": "Étape 1 — lien" },
    { "type": "textarea", "id": "step1_bullets", "label": "Étape 1 — points (un par ligne)", "default": "Configurez de A à Z, ou choisissez dans la collection" },

    { "type": "text", "id": "step2_label", "label": "Étape 2 — titre", "default": "Rendez-vous mensurations" },
    { "type": "textarea", "id": "step2_bullets", "label": "Étape 2 — points (un par ligne)", "default": "Mensurations prises par des professionnels\nPrès de chez vous" },

    { "type": "text", "id": "step3_label", "label": "Étape 3 — titre", "default": "Recevez votre complet" },
    { "type": "textarea", "id": "step3_bullets", "label": "Étape 3 — points (un par ligne)", "default": "Cousu à la main\nPrêt en quelques semaines\nLivré chez vous" }
  ],
  "presets": [
    { "name": "Hero — Accueil" }
  ]
}
{% endschema %}
