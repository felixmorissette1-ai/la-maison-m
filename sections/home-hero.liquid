<section class="lmm-hero full-width">
  {% if section.settings.hero_photo %}
    <div class="lmm-hero__photo" style="background-image: url({{ section.settings.hero_photo | image_url: width: 1800 }});"></div>
    <div class="lmm-hero__wash"></div>
  {% endif %}

  <div class="lmm-hero__inner">
    <h1 class="lmm-hero__title">{{ section.settings.title }}</h1>
  </div>
</section>

<section class="lmm-plan full-width">
  <div class="lmm-plan__inner">
    <p class="lmm-plan__title">{{ section.settings.plan_title }}</p>

    <div class="lmm-plan__row">
      <div class="lmm-plan__step lmm-plan__step--primary">
        <div class="lmm-plan__num">1</div>
        <a href="{{ section.settings.step1_url }}" class="lmm-plan__cta">{{ section.settings.step1_label }}</a>
        <p class="lmm-plan__desc" data-reveal>
          {{ section.settings.step1_detail }}
          Besoin d'aide ? <a href="#" class="lmm-plan__link" onclick="event.preventDefault(); ouvrirLocalisationModal()">prenez rendez-vous</a> avec un tailleur qui a des laines, ou <a href="mailto:{{ shop.email }}" class="lmm-plan__link">écrivez-nous</a>.
        </p>
      </div>

      <div class="lmm-plan__line"></div>

      <div class="lmm-plan__step">
        <div class="lmm-plan__num">2</div>
        <p class="lmm-plan__label">{{ section.settings.step2_label }}</p>
        <p class="lmm-plan__desc" data-reveal>{{ section.settings.step2_detail }}<span id="lmm-plan-ville"></span></p>
      </div>

      <div class="lmm-plan__line"></div>

      <div class="lmm-plan__step">
        <div class="lmm-plan__num">3</div>
        <p class="lmm-plan__label">{{ section.settings.step3_label }}</p>
        <p class="lmm-plan__desc" data-reveal>{{ section.settings.step3_detail }}</p>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var reveals = document.querySelectorAll('.lmm-plan [data-reveal]');
    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('lmm-reveal--in');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.35 });
      reveals.forEach(function (el) { observer.observe(el); });
    } else {
      reveals.forEach(function (el) { el.classList.add('lmm-reveal--in'); });
    }
  })();

  // Ville la plus proche pour l'étape 2 — demande la localisation dès
  // l'arrivée sur la page d'accueil ; échoue silencieusement (refus,
  // navigateur sans support, aucun tailleur dans un rayon raisonnable).
  (function () {
    var villeEl = document.getElementById('lmm-plan-ville');
    if (!villeEl || !navigator.geolocation) return;

    navigator.geolocation.getCurrentPosition(function (pos) {
      fetch('https://lmm-backend.vercel.app/api/couturiere', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lat: pos.coords.latitude, lng: pos.coords.longitude })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var nearest = data && data.success && data.couturieres && data.couturieres[0];
          if (nearest && nearest.ville && nearest.distanceValue < 100000) {
            villeEl.textContent = ' Couturière la plus proche : ' + nearest.ville + '.';
          }
        })
        .catch(function () {});
    }, function () {}, { timeout: 8000 });
  })();
</script>

{% stylesheet %}
  .lmm-hero {
    position: relative;
    background: var(--lmm-ivoire);
    /* Volontairement moins que 100% de l'écran : le bas de la section
       suivante (.lmm-plan) doit dépasser visible sous le pli au chargement,
       comme indice pour inciter à défiler. */
    height: calc(100dvh - 104px - 320px);
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .lmm-hero__photo {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    filter: grayscale(0.55) sepia(0.35) brightness(1.18) contrast(0.86) saturate(0.85);
  }

  .lmm-hero__wash {
    position: absolute;
    inset: 0;
    background: rgba(var(--lmm-ivoire-rgb), 0.38);
  }

  .lmm-hero__inner {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lmm-hero__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(24px, 3.2vw, 44px);
    font-weight: 400;
    color: var(--lmm-text);
    line-height: 1.3;
    text-align: center;
    margin: 0;
  }

  @media (min-width: 768px) {
    .lmm-hero__title {
      white-space: nowrap;
    }
  }

  .lmm-plan {
    background: var(--lmm-ivoire);
    padding: 64px 32px 90px;
  }

  .lmm-plan__inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .lmm-plan__title {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lmm-bordeaux-soft);
    text-align: center;
    margin: 0 0 40px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .lmm-plan__row {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
  }

  .lmm-plan__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    flex: 1;
    max-width: 300px;
    padding: 0 20px;
  }

  .lmm-plan__line {
    width: 100%;
    max-width: 90px;
    border-top: 1px solid var(--lmm-ivoire-line);
    align-self: flex-start;
    /* Aligne la ligne sur le centre vertical du cercle numéroté (30px de
       haut, premier élément de chaque étape, sans padding au-dessus). */
    margin-top: 15px;
    flex-shrink: 1;
  }

  .lmm-plan__num {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    margin-bottom: 4px;
    border: 1px solid var(--lmm-muted);
    color: var(--lmm-muted);
    background: var(--lmm-ivoire);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .lmm-plan__step--primary .lmm-plan__num {
    background: var(--lmm-bordeaux);
    border-color: var(--lmm-bordeaux);
    color: var(--lmm-ivoire);
  }

  .lmm-plan__cta {
    display: inline-block;
    background: var(--lmm-bordeaux);
    color: var(--lmm-ivoire);
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 0.03em;
    padding: 15px 30px;
    border-radius: 8px;
    white-space: nowrap;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .lmm-plan__label {
    font-size: 14px;
    color: var(--lmm-text);
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .lmm-plan__desc {
    font-size: 12.5px;
    color: var(--lmm-muted);
    line-height: 1.6;
    margin: 0;
  }

  .lmm-plan__link {
    color: var(--lmm-bordeaux-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lmm-plan__desc[data-reveal] {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .lmm-plan__desc.lmm-reveal--in {
    opacity: 1;
    transform: translateY(0);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero — Accueil",
  "settings": [
    { "type": "image_picker", "id": "hero_photo", "label": "Photo de fond (laisser vide pour fond ivoire uni)" },
    { "type": "text", "id": "title", "label": "Slogan", "default": "Parce que la première impression compte." },

    { "type": "header", "content": "Plan d'action" },
    { "type": "text", "id": "plan_title", "label": "Titre du plan", "default": "Comment ça fonctionne" },

    { "type": "text", "id": "step1_label", "label": "Étape 1 — texte du bouton", "default": "Configurez votre complet" },
    { "type": "url", "id": "step1_url", "label": "Étape 1 — lien" },
    { "type": "text", "id": "step1_detail", "label": "Étape 1 — description", "default": "Vous pouvez configurer votre complet de A à Z, ou choisir directement dans notre collection." },

    { "type": "text", "id": "step2_label", "label": "Étape 2 — titre", "default": "Rendez-vous mensurations" },
    { "type": "text", "id": "step2_detail", "label": "Étape 2 — description", "default": "Vos mensurations sont prises par des professionnels près de chez vous, pour maximiser la qualité de l'ajustement." },

    { "type": "text", "id": "step3_label", "label": "Étape 3 — titre", "default": "Recevez votre complet" },
    { "type": "text", "id": "step3_detail", "label": "Étape 3 — description", "default": "Votre complet est cousu à la main par un tailleur, prêt en quelques semaines, et livré directement chez vous." }
  ],
  "presets": [
    { "name": "Hero — Accueil" }
  ]
}
{% endschema %}
