<section class="lmm-hero full-width">
  {% if section.settings.hero_photo %}
    <div class="lmm-hero__photo" style="background-image: url({{ section.settings.hero_photo | image_url: width: 1800 }});"></div>
    <div class="lmm-hero__wash"></div>
  {% endif %}

  <div class="lmm-hero__inner">
    <div class="lmm-hero__title-wrap">
      <div class="lmm-hero__title-block">
        <h1 class="lmm-hero__title">{{ section.settings.title }}</h1>
      </div>
    </div>
    <a href="{{ section.settings.step1_url }}" class="lmm-hero__cta">
      {{ section.settings.step1_label }}
    </a>
  </div>
</section>

<section class="lmm-plan full-width">
  <div class="lmm-plan__inner">
    <p class="lmm-plan__title">{{ section.settings.plan_title }}</p>

    <div class="lmm-plan__row">
      <div class="lmm-plan__step">
        <span class="lmm-plan__num">01</span>
        <div class="lmm-plan__step-head">
          <span class="lmm-plan__step-title">{{ section.settings.step1_label }}</span>
        </div>
        <div class="lmm-plan__desc">
          <p class="lmm-plan__intro">{{ section.settings.step1_intro }}</p>
          <ul class="lmm-plan__list">
            {% assign step1_lines = section.settings.step1_bullets | newline_to_br | split: '<br />' %}
            {% for line in step1_lines %}
              {% if line != blank %}<li>{{ line }}</li>{% endif %}
            {% endfor %}
            <li>Conseil stylistique — <a href="/pages/aide-configuration" class="lmm-plan__link">écrivez-nous</a></li>
            <li>Envie de voir les tissus avant de commander ? <a href="#" class="lmm-plan__link" onclick="event.preventDefault(); ouvrirLocalisationModal()">Prenez rendez-vous</a></li>
          </ul>
        </div>
      </div>

      <div class="lmm-plan__step">
        <span class="lmm-plan__num">02</span>
        <a href="#" class="lmm-plan__step-head lmm-plan__step-head--link" onclick="event.preventDefault(); ouvrirLocalisationModal()">
          <span class="lmm-plan__step-title">{{ section.settings.step2_label }}</span>
        </a>
        <div class="lmm-plan__desc">
          <p class="lmm-plan__intro">{{ section.settings.step2_intro }}</p>
          <ul class="lmm-plan__list">
            {% assign step2_lines = section.settings.step2_bullets | newline_to_br | split: '<br />' %}
            {% for line in step2_lines %}
              {% if line != blank %}<li>{{ line }}</li>{% endif %}
            {% endfor %}
            <li id="lmm-plan-ville-item"><span id="lmm-plan-ville">Partenaire disponible près de chez vous</span></li>
            <li><a href="#" class="lmm-plan__link" onclick="event.preventDefault(); ouvrirLocalisationModal()">Prenez rendez-vous</a> pour vos mensurations</li>
          </ul>
        </div>
      </div>

      <div class="lmm-plan__step">
        <span class="lmm-plan__num">03</span>
        <div class="lmm-plan__step-head">
          <span class="lmm-plan__step-title">{{ section.settings.step3_label }}</span>
        </div>
        <div class="lmm-plan__desc">
          <p class="lmm-plan__intro">{{ section.settings.step3_intro }}</p>
          <ul class="lmm-plan__list">
            {% assign step3_lines = section.settings.step3_bullets | newline_to_br | split: '<br />' %}
            {% for line in step3_lines %}
              {% if line != blank %}<li>{{ line }}</li>{% endif %}
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Ville la plus proche pour l'étape 2 — demande la localisation dès
  // l'arrivée sur la page d'accueil ; échoue silencieusement (refus,
  // navigateur sans support, aucun tailleur dans un rayon raisonnable).
  (function () {
    var villeEl = document.getElementById('lmm-plan-ville');
    if (!villeEl || !navigator.geolocation) return;

    navigator.geolocation.getCurrentPosition(function (pos) {
      fetch('https://lmm-backend.vercel.app/api/couturiere', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lat: pos.coords.latitude, lng: pos.coords.longitude })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var nearest = data && data.success && data.couturieres && data.couturieres[0];
          if (nearest && nearest.ville && nearest.distanceValue < 100000) {
            villeEl.textContent = 'Partenaire disponible à ' + nearest.ville;
          }
        })
        .catch(function () {});
    }, function () {}, { timeout: 8000 });
  })();

  // Hauteur du hero calculée à partir des vraies mesures du DOM (pas de
  // pixels devinés) : on mesure combien d'espace prend le titre "Comment
  // ça fonctionne" + la rangée numéro/titre de chaque carte — cette
  // distance ne dépend pas de la hauteur du hero lui-même, seulement du
  // contenu du plan. Le hero prend tout le reste de l'écran, ce qui
  // garantit que les titres restent visibles au chargement et que les
  // descriptions restent sous le pli, peu importe la taille de l'écran
  // ou si un titre passe sur deux lignes.
  (function () {
    var hero = document.querySelector('.lmm-hero');
    var header = document.querySelector('.lmm-header');
    var plan = document.querySelector('.lmm-plan');
    var planTitle = document.querySelector('.lmm-plan__title');
    var stepHeads = document.querySelectorAll('.lmm-plan__step-head');
    if (!hero || !header || !plan || !planTitle || !stepHeads.length) return;

    var MIN_HERO_HEIGHT = 300;
    var BUFFER_BELOW_TITLES = 20;

    function updateHeroPeek() {
      var planTop = plan.getBoundingClientRect().top;
      var maxBottom = planTitle.getBoundingClientRect().bottom;
      stepHeads.forEach(function (el) {
        var bottom = el.getBoundingClientRect().bottom;
        if (bottom > maxBottom) maxBottom = bottom;
      });

      var revealHeight = maxBottom - planTop;
      var headerHeight = header.getBoundingClientRect().height;
      var target = window.innerHeight - headerHeight - revealHeight - BUFFER_BELOW_TITLES;

      hero.style.height = Math.max(target, MIN_HERO_HEIGHT) + 'px';
    }

    updateHeroPeek();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(updateHeroPeek);
    }
    window.addEventListener('load', updateHeroPeek);

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(updateHeroPeek, 120);
    });
  })();
</script>

{% stylesheet %}
  .lmm-hero {
    position: relative;
    background: var(--lmm-ivoire);
    /* Valeur de repli avant que le script en bas de page ne mesure le
       vrai contenu et fixe la hauteur exacte en pixels (voir <script> :
       garantit que les titres du plan restent visibles au chargement et
       que les descriptions restent sous le pli, de façon fiable). */
    height: calc(100dvh - 284px);
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .lmm-hero__photo {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    filter: grayscale(0.55) sepia(0.35) brightness(1.18) contrast(0.86) saturate(0.85);
  }

  .lmm-hero__wash {
    position: absolute;
    inset: 0;
    background: rgba(var(--lmm-ivoire-rgb), 0.38);
  }

  .lmm-hero__inner {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px 32px 40px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  /* Occupe tout l'espace entre le header et le bouton, et centre le
     slogan à l'intérieur de cet espace — pas juste "centré dans le hero"
     en général, qui le collait trop haut une fois le bouton poussé en bas. */
  .lmm-hero__title-wrap {
    flex: 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Boîte "inline-block" : sa largeur épouse exactement le texte du
     slogan (pas la largeur du hero), pour que la ligne courbe en dessous
     ait toujours la largeur du slogan lui-même — comme un soulignement. */
  .lmm-hero__title-block {
    display: inline-block;
    text-align: center;
  }

  .lmm-hero__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(24px, 3.2vw, 44px);
    font-weight: 400;
    color: var(--lmm-text);
    line-height: 1.3;
    text-align: center;
    margin: 0;
  }

  .lmm-hero__cta {
    display: inline-flex;
    background: var(--lmm-bordeaux);
    color: var(--lmm-ivoire);
    text-decoration: none;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 20px;
    padding: 22px 44px;
    border-radius: 8px;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .lmm-hero__title {
      white-space: nowrap;
    }
  }

  .lmm-plan {
    background: var(--lmm-ivoire);
    padding: 40px 32px 90px;
  }

  .lmm-plan__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  /* Même gabarit que .lmm-why__heading — grand, aligné à gauche, Georgia —
     pour que tous les titres de section du site soient cohérents. */
  .lmm-plan__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--lmm-text);
    text-align: left;
    margin: 0 0 40px;
    max-width: 640px;
  }

  @media (max-width: 767px) {
    .lmm-plan__title {
      font-size: 28px;
    }
  }

  /* Une carte encadrée par étape — largeur égale, contenu aligné à
     gauche. Les 3 cartes forment une seule rangée de grille, donc elles
     s'étirent à la même hauteur peu importe la longueur du titre. */
  .lmm-plan__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 28px;
    row-gap: 24px;
    align-items: stretch;
  }

  .lmm-plan__step {
    box-sizing: border-box;
    border: 1px solid var(--lmm-ivoire-line);
    border-radius: 10px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    text-align: left;
  }

  .lmm-plan__desc {
    width: 100%;
    /* Marge supplémentaire (en plus du gap de la carte) entre le titre et
       la description : donne une vraie zone tampon au script de hauteur
       du hero, pour que la coupure au chargement reste fiable même avec
       de petites variations de rendu entre navigateurs. */
    margin-top: 26px;
    text-align: left;
  }

  /* Même format de numéro et de titre pour les 3 étapes — seule la
     décoration (curseur pour l'étape 2, l'étape cliquable) change selon
     que l'étape est cliquable ou non. */
  .lmm-plan__num {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 32px;
    font-weight: 400;
    color: var(--lmm-bordeaux-soft);
  }

  .lmm-plan__step-head {
    display: flex;
    align-items: flex-start;
    /* Fixe à la hauteur d'un titre sur 2 lignes : même si un titre est
       plus court qu'un autre (une ligne au lieu de deux), la description
       qui suit démarre toujours à la même hauteur dans les 3 cartes —
       sinon la carte au titre le plus court laisserait sa description
       dépasser avant celle des autres, et la coupure au chargement du
       hero ne serait plus fiable. */
    min-height: 54px;
    text-decoration: none;
  }

  .lmm-plan__step-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--lmm-text);
  }

  .lmm-plan__step-head--link {
    cursor: pointer;
  }

  .lmm-plan__step-head--link .lmm-plan__step-title {
    transition: color 0.2s;
  }

  .lmm-plan__step-head--link:hover .lmm-plan__step-title {
    color: var(--lmm-bordeaux-soft);
  }

  /* Phrase d'intro : donne le contexte en une phrase claire. Les puces qui
     suivent ne portent que les détails concrets — jamais les deux à
     répéter la même idée. */
  .lmm-plan__intro {
    font-size: 15.5px;
    color: var(--lmm-text);
    line-height: 1.6;
    text-align: left;
    margin: 0 0 20px;
  }

  .lmm-plan__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .lmm-plan__list li {
    font-size: 13.5px;
    color: var(--lmm-muted);
    line-height: 1.5;
    text-align: left;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  /* Beau rond vide devant chaque point — inline, pas positionné en absolu,
     pour rester correct même avec du texte centré sur plusieurs lignes. */
  .lmm-plan__list li::before {
    content: '○';
    display: inline-block;
    margin-right: 7px;
    color: var(--lmm-bordeaux-soft);
    font-size: 11px;
    vertical-align: 1px;
  }

  .lmm-plan__link {
    color: var(--lmm-bordeaux-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero — Accueil",
  "settings": [
    { "type": "image_picker", "id": "hero_photo", "label": "Photo de fond (laisser vide pour fond ivoire uni)" },
    { "type": "text", "id": "title", "label": "Slogan", "default": "Parce que la première impression compte" },

    { "type": "header", "content": "Plan d'action" },
    { "type": "text", "id": "plan_title", "label": "Titre du plan", "default": "En seulement trois étapes" },

    { "type": "text", "id": "step1_label", "label": "Étape 1 — texte du bouton", "default": "Configurez votre complet" },
    { "type": "url", "id": "step1_url", "label": "Étape 1 — lien" },
    { "type": "text", "id": "step1_intro", "label": "Étape 1 — phrase d'intro", "default": "Configurez votre complet de A à Z, ou commandez directement dans notre collection." },
    { "type": "textarea", "id": "step1_bullets", "label": "Étape 1 — points (un par ligne)", "default": "5 minutes" },

    { "type": "text", "id": "step2_label", "label": "Étape 2 — titre", "default": "Rendez-vous mensurations" },
    { "type": "text", "id": "step2_intro", "label": "Étape 2 — phrase d'intro", "default": "Vos mensurations sont prises par un de nos professionnels pour assurer un ajustement parfait." },
    { "type": "textarea", "id": "step2_bullets", "label": "Étape 2 — points (un par ligne)", "default": "30 minutes" },

    { "type": "text", "id": "step3_label", "label": "Étape 3 — titre", "default": "Recevez votre complet" },
    { "type": "text", "id": "step3_intro", "label": "Étape 3 — phrase d'intro", "default": "Profitez d'un complet parfaitement ajusté à votre silhouette pour une allure à la hauteur de vos ambitions." },
    { "type": "textarea", "id": "step3_bullets", "label": "Étape 3 — points (un par ligne)", "default": "Livraison à domicile\n4-8 semaines\nRetouches gratuites au besoin" }
  ],
  "presets": [
    { "name": "Hero — Accueil" }
  ]
}
{% endschema %}
