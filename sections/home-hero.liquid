<section class="lmm-hero full-width">
  {% if section.settings.hero_photo %}
    <div class="lmm-hero__photo" style="background-image: url({{ section.settings.hero_photo | image_url: width: 1800 }});"></div>
    <div class="lmm-hero__wash"></div>
  {% endif %}

  <div class="lmm-hero__inner">
    <h1 class="lmm-hero__title">{{ section.settings.title }}</h1>
    <a href="{{ section.settings.step1_url }}" class="lmm-hero__cta">
      {{ section.settings.step1_label }}
    </a>
  </div>
</section>

<section class="lmm-plan full-width">
  <div class="lmm-plan__inner">
    <p class="lmm-plan__title">{{ section.settings.plan_title }}</p>

    <div class="lmm-plan__row">
      <span class="lmm-plan__num">01</span>
      <span class="lmm-plan__num">02</span>
      <span class="lmm-plan__num">03</span>

      <div class="lmm-plan__step-head">
        <span class="lmm-plan__step-title">{{ section.settings.step1_label }}</span>
      </div>
      <a href="#" class="lmm-plan__step-head lmm-plan__step-head--link" onclick="event.preventDefault(); ouvrirLocalisationModal()">
        <span class="lmm-plan__step-title">{{ section.settings.step2_label }}</span>
      </a>
      <div class="lmm-plan__step-head">
        <span class="lmm-plan__step-title">{{ section.settings.step3_label }}</span>
      </div>

      <div class="lmm-plan__desc">
        <p class="lmm-plan__intro">{{ section.settings.step1_intro }}</p>
        <ul class="lmm-plan__list">
          {% assign step1_lines = section.settings.step1_bullets | newline_to_br | split: '<br />' %}
          {% for line in step1_lines %}
            {% if line != blank %}
              {% assign emoji = line | split: ' ' | first %}
              {% assign rest = line | remove_first: emoji | strip %}
              <li><span class="lmm-plan__emoji">{{ emoji }}</span> {{ rest }}</li>
            {% endif %}
          {% endfor %}
          <li><span class="lmm-plan__emoji">💬</span> Besoin d'aide ? <a href="#" class="lmm-plan__link" onclick="event.preventDefault(); ouvrirLocalisationModal()">prenez rendez-vous</a> ou <a href="/pages/aide-configuration" class="lmm-plan__link">écrivez-nous</a></li>
        </ul>
      </div>

      <div class="lmm-plan__desc">
        <p class="lmm-plan__intro">{{ section.settings.step2_intro }}</p>
        <ul class="lmm-plan__list">
          {% assign step2_lines = section.settings.step2_bullets | newline_to_br | split: '<br />' %}
          {% for line in step2_lines %}
            {% if line != blank %}
              {% assign emoji = line | split: ' ' | first %}
              {% assign rest = line | remove_first: emoji | strip %}
              <li><span class="lmm-plan__emoji">{{ emoji }}</span> {{ rest }}</li>
            {% endif %}
          {% endfor %}
          <li id="lmm-plan-ville-item" style="display:none;"><span class="lmm-plan__emoji">📍</span> <span id="lmm-plan-ville"></span></li>
        </ul>
      </div>

      <div class="lmm-plan__desc">
        <p class="lmm-plan__intro">{{ section.settings.step3_intro }}</p>
        <ul class="lmm-plan__list">
          {% assign step3_lines = section.settings.step3_bullets | newline_to_br | split: '<br />' %}
          {% for line in step3_lines %}
            {% if line != blank %}
              {% assign emoji = line | split: ' ' | first %}
              {% assign rest = line | remove_first: emoji | strip %}
              <li><span class="lmm-plan__emoji">{{ emoji }}</span> {{ rest }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  // Ville la plus proche pour l'étape 2 — demande la localisation dès
  // l'arrivée sur la page d'accueil ; échoue silencieusement (refus,
  // navigateur sans support, aucun tailleur dans un rayon raisonnable).
  (function () {
    var villeEl = document.getElementById('lmm-plan-ville');
    if (!villeEl || !navigator.geolocation) return;

    navigator.geolocation.getCurrentPosition(function (pos) {
      fetch('https://lmm-backend.vercel.app/api/couturiere', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lat: pos.coords.latitude, lng: pos.coords.longitude })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var nearest = data && data.success && data.couturieres && data.couturieres[0];
          if (nearest && nearest.ville && nearest.distanceValue < 100000) {
            villeEl.textContent = 'Disponible à ' + nearest.ville;
            document.getElementById('lmm-plan-ville-item').style.display = '';
          }
        })
        .catch(function () {});
    }, function () {}, { timeout: 8000 });
  })();
</script>

{% stylesheet %}
  .lmm-hero {
    position: relative;
    background: var(--lmm-ivoire);
    /* Volontairement moins que 100% de l'écran : seuls le titre "Comment
       ça fonctionne" et la rangée numéro/titre du plan doivent dépasser
       visibles sous le pli au chargement — pas les descriptions. */
    height: calc(100dvh - 104px - 180px);
    min-height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .lmm-hero__photo {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    filter: grayscale(0.55) sepia(0.35) brightness(1.18) contrast(0.86) saturate(0.85);
  }

  .lmm-hero__wash {
    position: absolute;
    inset: 0;
    background: rgba(var(--lmm-ivoire-rgb), 0.38);
  }

  .lmm-hero__inner {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px 32px 40px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
  }

  .lmm-hero__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(24px, 3.2vw, 44px);
    font-weight: 400;
    color: var(--lmm-text);
    line-height: 1.3;
    text-align: center;
    margin: 0;
  }

  .lmm-hero__cta {
    display: inline-flex;
    background: var(--lmm-bordeaux);
    color: var(--lmm-ivoire);
    text-decoration: none;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 20px;
    padding: 22px 44px;
    border-radius: 8px;
    white-space: nowrap;
    /* Pousse le bouton vers le bas du hero (juste au-dessus du plan
       d'action) peu importe où le titre se retrouve au-dessus. */
    margin-top: auto;
  }

  @media (min-width: 768px) {
    .lmm-hero__title {
      white-space: nowrap;
    }
  }

  .lmm-plan {
    background: var(--lmm-ivoire);
    padding: 40px 32px 90px;
  }

  .lmm-plan__inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .lmm-plan__title {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lmm-bordeaux-soft);
    text-align: center;
    margin: 0 0 24px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  /* Grille 3 colonnes x 3 rangées (numéro / titre / description) — chaque
     rangée de la grille partage la même hauteur pour les 3 colonnes, donc
     les descriptions démarrent toutes sur la même ligne horizontale peu
     importe si un titre est plus long qu'un autre. Chaque description
     reste directement sous son propre titre (même colonne). */
  .lmm-plan__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 24px;
    row-gap: 18px;
    text-align: center;
    justify-items: center;
  }

  /* Largeur fixe partagée par la phrase d'intro ET la liste à l'intérieur,
     sinon chacune se centre indépendamment à sa propre largeur de contenu
     et elles finissent décalées l'une par rapport à l'autre. */
  .lmm-plan__desc {
    width: 100%;
    max-width: 300px;
    text-align: center;
  }

  /* Même format de numéro et de titre pour les 3 étapes — seule la
     décoration (fond bordeaux pour l'étape 1, curseur pour l'étape 2)
     change selon que l'étape est cliquable ou non. Le numéro reste hors
     du bouton de l'étape 1 (juste au-dessus), pas dedans. */
  .lmm-plan__num {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 32px;
    font-weight: 400;
    color: var(--lmm-ivoire-line);
  }

  .lmm-plan__step-head {
    display: flex;
    text-decoration: none;
  }

  .lmm-plan__step-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 20px;
    font-weight: 400;
    color: var(--lmm-text);
  }

  .lmm-plan__step-head--link {
    cursor: pointer;
  }

  .lmm-plan__step-head--link .lmm-plan__step-title {
    transition: color 0.2s;
  }

  .lmm-plan__step-head--link:hover .lmm-plan__step-title {
    color: var(--lmm-bordeaux-soft);
  }

  /* Phrase d'intro : donne le contexte en une phrase claire. Les puces qui
     suivent ne portent que les détails concrets — jamais les deux à
     répéter la même idée. */
  .lmm-plan__intro {
    font-size: 15.5px;
    color: var(--lmm-text);
    line-height: 1.6;
    margin: 0 0 20px;
  }

  .lmm-plan__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .lmm-plan__list li {
    font-size: 13.5px;
    color: var(--lmm-muted);
    line-height: 1.5;
    text-align: center;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .lmm-plan__link {
    color: var(--lmm-bordeaux-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Émoticônes en niveaux de gris — gardent leur forme, perdent leur
     couleur, pour rester discrètes à côté du texte muted. */
  .lmm-plan__emoji {
    filter: grayscale(1);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero — Accueil",
  "settings": [
    { "type": "image_picker", "id": "hero_photo", "label": "Photo de fond (laisser vide pour fond ivoire uni)" },
    { "type": "text", "id": "title", "label": "Slogan", "default": "Parce que la première impression compte." },

    { "type": "header", "content": "Plan d'action" },
    { "type": "text", "id": "plan_title", "label": "Titre du plan", "default": "Comment ça fonctionne" },

    { "type": "text", "id": "step1_label", "label": "Étape 1 — texte du bouton", "default": "Configurez votre complet" },
    { "type": "url", "id": "step1_url", "label": "Étape 1 — lien" },
    { "type": "text", "id": "step1_intro", "label": "Étape 1 — phrase d'intro", "default": "Configurez votre complet à votre rythme." },
    { "type": "textarea", "id": "step1_bullets", "label": "Étape 1 — points (un par ligne, avec émoticône)", "default": "✂️ De A à Z, ou directement dans la collection" },

    { "type": "text", "id": "step2_label", "label": "Étape 2 — titre", "default": "Rendez-vous mensurations" },
    { "type": "text", "id": "step2_intro", "label": "Étape 2 — phrase d'intro", "default": "Vos mensurations sont prises par des professionnels." },
    { "type": "textarea", "id": "step2_bullets", "label": "Étape 2 — points (un par ligne, avec émoticône)", "default": "📍 Près de chez vous" },

    { "type": "text", "id": "step3_label", "label": "Étape 3 — titre", "default": "Recevez votre complet" },
    { "type": "text", "id": "step3_intro", "label": "Étape 3 — phrase d'intro", "default": "Votre complet est cousu à la main." },
    { "type": "textarea", "id": "step3_bullets", "label": "Étape 3 — points (un par ligne, avec émoticône)", "default": "⏱️ Prêt en quelques semaines\n📦 Livré chez vous" }
  ],
  "presets": [
    { "name": "Hero — Accueil" }
  ]
}
{% endschema %}
