{% if section.settings.hero_photo %}
  <!-- Photo figée en arrière-plan (position:fixed), pas liée à une seule
     section — elle reste visible derrière le hero ET le plan d'action
     tant que ces deux sections n'ont pas leur propre fond opaque, et
     disparaît naturellement dès que la section Statistiques (fond
     opaque) arrive par-dessus au défilement. -->
  <div class="lmm-hero-fixed-bg">
    <div class="lmm-hero-fixed-bg__photo" style="background-image: url({{ section.settings.hero_photo | image_url: width: 1800 }});"></div>
    <div class="lmm-hero-fixed-bg__wash"></div>
  </div>
{% endif %}

<section class="lmm-hero full-width">
  <div class="lmm-hero__inner">
    <div class="lmm-hero__title-wrap">
      <div class="lmm-hero__title-block">
        <h1 class="lmm-hero__title">{{ section.settings.title }}</h1>
      </div>
    </div>
    <div class="lmm-hero__cta-row">
      <a href="{{ section.settings.step1_url }}" class="lmm-hero__cta">
        {{ section.settings.step1_label }}
      </a>
      {% if section.settings.tissus_link_label != blank %}
        <a href="#" class="lmm-hero__cta-secondary" onclick="event.preventDefault(); ouvrirLocalisationModal('tissus')">{{ section.settings.tissus_link_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

<section class="lmm-plan full-width">
  <div class="lmm-plan__inner">
    <p class="lmm-plan__title">{{ section.settings.plan_title }}</p>

    <div class="lmm-plan__row">
      <div class="lmm-plan__step">
        <div class="lmm-plan__head-group">
          <span class="lmm-plan__num">01</span>
          <div class="lmm-plan__step-head">
            <span class="lmm-plan__step-title">{{ section.settings.step1_label }}</span>
          </div>
        </div>
        <div class="lmm-plan__card">
          <svg class="lmm-plan__icon" width="44" height="44" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10a3 3 0 1 0-3-3"/>
            <path d="M22 10v3"/>
            <path d="M6 26 L20 13 a3 3 0 0 1 4 0 L38 26"/>
            <path d="M4 26h36"/>
            <rect x="14" y="30" width="10" height="10" rx="1"/>
          </svg>
          <p class="lmm-plan__intro">{{ section.settings.step1_intro }}</p>
          <ul class="lmm-plan__list">
            {% assign step1_lines = section.settings.step1_bullets | newline_to_br | split: '<br />' %}
            {% for line in step1_lines %}
              {% if line != blank %}<li>{{ line }}</li>{% endif %}
            {% endfor %}
            {% if section.settings.step1_style_advice_label != blank %}
              <li>{{ section.settings.step1_style_advice_label }} <a href="{{ section.settings.step1_style_advice_url | default: '/pages/aide-configuration' }}" class="lmm-plan__link">{{ section.settings.step1_style_advice_link_label }}</a></li>
            {% endif %}
          </ul>
          <a href="{{ section.settings.step1_url }}" class="lmm-plan__btn">{{ section.settings.step1_btn_label }}</a>
        </div>
      </div>

      <div class="lmm-plan__step">
        <div class="lmm-plan__head-group">
          <span class="lmm-plan__num">02</span>
          <a href="#" class="lmm-plan__step-head lmm-plan__step-head--link" onclick="event.preventDefault(); ouvrirLocalisationModal('mensurations')">
            <span class="lmm-plan__step-title">{{ section.settings.step2_label }}</span>
          </a>
        </div>
        <div class="lmm-plan__card">
          <svg class="lmm-plan__icon" width="44" height="44" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="14" width="32" height="18" rx="3"/>
            <path d="M12 14v6M17 14v4M22 14v6M27 14v4M32 14v6"/>
            <path d="M22 32v6"/>
          </svg>
          <p class="lmm-plan__intro">{{ section.settings.step2_intro }}</p>
          <ul class="lmm-plan__list">
            {% assign step2_lines = section.settings.step2_bullets | newline_to_br | split: '<br />' %}
            {% for line in step2_lines %}
              {% if line != blank %}<li>{{ line }}</li>{% endif %}
            {% endfor %}
            <li id="lmm-plan-ville-item"><span id="lmm-plan-ville">Partenaire disponible près de chez vous</span></li>
          </ul>
          <a href="#" class="lmm-plan__btn" onclick="event.preventDefault(); ouvrirLocalisationModal('mensurations')">{{ section.settings.step2_btn_label }}</a>
        </div>
      </div>

      <div class="lmm-plan__step">
        <div class="lmm-plan__head-group">
          <span class="lmm-plan__num">03</span>
          <div class="lmm-plan__step-head">
            <span class="lmm-plan__step-title">{{ section.settings.step3_label }}</span>
          </div>
        </div>
        <div class="lmm-plan__card">
          <svg class="lmm-plan__icon" width="44" height="44" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 6a2.5 2.5 0 1 0-2.5-2.5"/>
            <path d="M22 6v3"/>
            <path d="M14 9 L9 15 L6 17 L6 38 L38 38 L38 17 L35 15 L30 9"/>
            <path d="M14 9 L18 14 L22 11 L26 14 L30 9"/>
            <line x1="10" y1="19" x2="10" y2="34" stroke-opacity="0.4"/>
            <line x1="34" y1="19" x2="34" y2="34" stroke-opacity="0.4"/>
          </svg>
          <p class="lmm-plan__intro">{{ section.settings.step3_intro }}</p>
          <ul class="lmm-plan__list">
            {% assign step3_lines = section.settings.step3_bullets | newline_to_br | split: '<br />' %}
            {% for line in step3_lines %}
              {% if line != blank %}<li>{{ line }}</li>{% endif %}
            {% endfor %}
          </ul>
          <a href="{{ section.settings.step1_url }}" class="lmm-plan__btn">{{ section.settings.step3_btn_label }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Ville la plus proche pour l'étape 2 — demande la localisation dès
  // l'arrivée sur la page d'accueil ; échoue silencieusement (refus,
  // navigateur sans support, aucun tailleur dans un rayon raisonnable).
  (function () {
    var villeEl = document.getElementById('lmm-plan-ville');
    if (!villeEl || !navigator.geolocation) return;

    navigator.geolocation.getCurrentPosition(function (pos) {
      fetch('https://lmm-backend.vercel.app/api/couturiere', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lat: pos.coords.latitude, lng: pos.coords.longitude })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var nearest = data && data.success && data.couturieres && data.couturieres[0];
          if (nearest && nearest.ville && nearest.distanceValue < 100000) {
            villeEl.textContent = 'Partenaire disponible à ' + nearest.ville;
          }
        })
        .catch(function () {});
    }, function () {}, { timeout: 8000 });
  })();
</script>

{% stylesheet %}
  /* z-index:-1 (pas juste "derrière le hero" mais littéralement derrière
     tout le contenu normal de la page) — les sections plus bas (à partir
     de Statistiques) ont leur propre fond opaque, donc elles la
     recouvrent naturellement dès qu'on défile jusque-là. Aucun gradient
     de transition nécessaire : la coupure est nette par nature. */
  .lmm-hero-fixed-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .lmm-hero-fixed-bg__photo {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    filter: grayscale(0.55) sepia(0.35) brightness(1.18) contrast(0.86) saturate(0.85);
  }

  /* Léger en haut (photo vive derrière le slogan), s'intensifie vers le
     bas — la photo occupe ~87% de l'écran, le haut de "Comment procéder"
     (titre + numéros/titres d'étapes) apparaît dans les ~13% restants dès
     le chargement, sans avoir à défiler. Le dégradé adoucit la jonction. */
  .lmm-hero-fixed-bg__wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(var(--lmm-ivoire-rgb), 0.28) 0%,
      rgba(var(--lmm-ivoire-rgb), 0.34) 60%,
      rgba(var(--lmm-ivoire-rgb), 0.55) 100%
    );
  }

  .lmm-hero {
    position: relative;
    /* Transparent volontairement : la photo figée derrière montre à
       travers. */
    background: transparent;
    /* Assez court pour que le haut de "Comment procéder" (titre + les 3
       numéros/titres d'étape) soit visible au chargement, sans défiler. */
    height: calc(45dvh - 104px);
    min-height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
  }

  .lmm-hero__inner {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px 32px 40px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Centre le slogan + les boutons comme un seul bloc dans le hero,
       au lieu d'étirer le slogan pour pousser les boutons en bas. */
    justify-content: center;
    gap: 28px;
  }

  .lmm-hero__title-wrap {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Boîte "inline-block" : sa largeur épouse exactement le texte du
     slogan (pas la largeur du hero), pour que la ligne courbe en dessous
     ait toujours la largeur du slogan lui-même — comme un soulignement. */
  .lmm-hero__title-block {
    display: inline-block;
    text-align: center;
  }

  .lmm-hero__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(30px, 4vw, var(--lmm-fs-slogan));
    font-weight: 400;
    color: var(--lmm-text);
    line-height: 1.3;
    text-align: center;
    margin: 0;
  }

  .lmm-hero__cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .lmm-hero__cta {
    display: inline-flex;
    background: var(--lmm-bordeaux);
    color: var(--lmm-ivoire);
    text-decoration: none;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 20px;
    padding: 22px 44px;
    border-radius: 8px;
    white-space: nowrap;
  }

  /* Bouton secondaire — même gabarit que le CTA principal mais en
     contour, pour rester clairement subordonné à "Configurez votre
     complet" tout en restant un vrai bouton (pas juste un lien discret). */
  .lmm-hero__cta-secondary {
    display: inline-flex;
    align-items: center;
    background: transparent;
    border: 1.5px solid var(--lmm-text);
    color: var(--lmm-text);
    text-decoration: none;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 18px;
    padding: 20px 32px;
    border-radius: 8px;
    white-space: nowrap;
    transition: background 0.2s, color 0.2s;
  }

  .lmm-hero__cta-secondary:hover {
    background: var(--lmm-text);
    color: var(--lmm-ivoire);
  }

  @media (min-width: 768px) {
    .lmm-hero__title {
      white-space: nowrap;
    }
  }

  @media (max-width: 560px) {
    .lmm-hero__cta-row {
      flex-direction: column;
      width: 100%;
    }

    .lmm-hero__cta,
    .lmm-hero__cta-secondary {
      width: 100%;
      justify-content: center;
      box-sizing: border-box;
    }
  }

  .lmm-plan {
    position: relative;
    /* Fond plein et opaque — cette section est maintenant entièrement
       sous le pli, sur son propre plan, plus superposée à la photo du
       hero (voir .lmm-hero ci-dessus). */
    background: var(--lmm-ivoire-pale);
    padding: 80px 32px 90px;
  }

  .lmm-plan__inner {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
  }

  .lmm-plan__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--lmm-fs-section-title);
    font-weight: 400;
    line-height: 1.3;
    color: var(--lmm-text);
    text-align: center;
    margin: 0 0 56px;
  }

  /* Une carte encadrée par étape — largeur égale, contenu aligné à
     gauche. Les 3 cartes forment une seule rangée de grille, donc elles
     s'étirent à la même hauteur peu importe la longueur du titre. */
  .lmm-plan__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 28px;
    row-gap: 24px;
    align-items: stretch;
  }

  /* Plus de boîte autour de toute la case — seule la description (voir
     .lmm-plan__desc) est encadrée. Le numéro et le titre restent nus sur
     le fond flouté. */
  .lmm-plan__step {
    position: relative;
    box-sizing: border-box;
    background: transparent;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    text-align: left;
  }

  /* Boîte encadrée — icône, points, bouton. flex:1 + le bouton en
     margin-top:auto font que les 3 cartes restent à la même hauteur et
     que les boutons s'alignent tous en bas, peu importe le nombre de
     points dans chaque carte (voir .lmm-plan__row align-items:stretch
     qui donne d'abord aux 3 .lmm-plan__step la même hauteur). Bordure
     noire (pas bordeaux) pour rester dans le registre plus neutre
     demandé pour les pastilles/boutons de cette zone du site. */
  .lmm-plan__card {
    box-sizing: border-box;
    width: 100%;
    flex: 1;
    margin-top: 26px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid var(--lmm-text);
    border-radius: 10px;
    padding: 44px 34px 36px;
  }

  .lmm-plan__icon {
    color: var(--lmm-bordeaux);
    margin-bottom: 30px;
  }

  .lmm-plan__intro {
    font-size: var(--lmm-fs-body);
    color: var(--lmm-text);
    line-height: 1.85;
    text-align: left;
    margin: 0 0 26px;
  }

  /* Regroupe numéro + titre pour que la flèche entre étapes se centre
     verticalement sur les deux ensemble, pas juste sur le titre seul. */
  .lmm-plan__head-group {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 14px;
  }

  /* Petite flèche bordeaux entre les étapes (pas sur la dernière, rien
     après), centrée sur le groupe numéro+titre entier plutôt que sur le
     titre seul. Hampe (::before) + pointe (::after). */
  .lmm-plan__step:not(:last-child) .lmm-plan__head-group::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 100%;
    width: 20px;
    height: 1.5px;
    background: var(--lmm-bordeaux);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .lmm-plan__step:not(:last-child) .lmm-plan__head-group::after {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(100% + 20px);
    width: 0;
    height: 0;
    border-top: 4.5px solid transparent;
    border-bottom: 4.5px solid transparent;
    border-left: 7px solid var(--lmm-bordeaux);
    transform: translateY(-50%);
    pointer-events: none;
  }

  /* Même format de numéro et de titre pour les 3 étapes — seule la
     décoration (curseur pour l'étape 2, l'étape cliquable) change selon
     que l'étape est cliquable ou non. */
  .lmm-plan__num {
    display: block;
    width: 100%;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--lmm-fs-number);
    font-weight: 400;
    color: var(--lmm-bordeaux);
    text-align: center;
  }

  .lmm-plan__step-head {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    text-align: center;
    /* Fixe à la hauteur d'un titre sur 2 lignes : même si un titre est
       plus court qu'un autre (une ligne au lieu de deux), la description
       qui suit démarre toujours à la même hauteur dans les 3 cartes —
       sinon la carte au titre le plus court laisserait sa description
       dépasser avant celle des autres, et la coupure au chargement du
       hero ne serait plus fiable. */
    min-height: 63px;
    text-decoration: none;
  }

  .lmm-plan__step-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--lmm-fs-card-title);
    font-weight: 400;
    line-height: 1.3;
    color: var(--lmm-text);
  }

  .lmm-plan__step-head--link {
    cursor: pointer;
  }

  .lmm-plan__step-head--link .lmm-plan__step-title {
    transition: color 0.2s;
  }

  .lmm-plan__step-head--link:hover .lmm-plan__step-title {
    color: var(--lmm-bordeaux-soft);
  }

  .lmm-plan__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  /* La puce est un vrai item flex (pas juste un ::before inline) pour
     que le texte qui passe à la ligne s'aligne sous le début du texte,
     pas sous la puce — sinon la 2e ligne repart tout à gauche du bloc. */
  .lmm-plan__list li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: var(--lmm-fs-body);
    color: var(--lmm-text);
    line-height: 1.85;
    text-align: left;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .lmm-plan__list li::before {
    content: '○';
    flex-shrink: 0;
    color: var(--lmm-bordeaux-soft);
    font-size: 11px;
  }

  .lmm-plan__link {
    color: var(--lmm-bordeaux-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Lien fin plutôt qu'un gros bouton rempli — juste un texte souligné
     avec une flèche, dans le ton du reste de la carte. */
  .lmm-plan__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    /* auto pousse le lien en bas de la carte, peu importe combien de
       points la liste contient — garde les 3 alignés. */
    margin-top: auto;
    padding-top: 24px;
    background: none;
    color: var(--lmm-bordeaux);
    text-decoration: none;
    border-bottom: 1px solid var(--lmm-bordeaux-soft);
    padding-bottom: 4px;
    font-size: 13px;
    letter-spacing: 0.03em;
    transition: opacity 0.2s;
  }

  .lmm-plan__btn::after {
    content: '→';
  }

  .lmm-plan__btn:hover {
    opacity: 0.7;
  }

  @media (max-width: 767px) {
    .lmm-plan__title {
      font-size: 26px;
    }

    .lmm-plan__row {
      grid-template-columns: 1fr;
      row-gap: 40px;
    }

    /* Les flèches de connexion entre étapes n'ont de sens qu'en rangée
       horizontale — cachées une fois les cartes empilées. */
    .lmm-plan__step:not(:last-child) .lmm-plan__head-group::before,
    .lmm-plan__step:not(:last-child) .lmm-plan__head-group::after {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero — Accueil",
  "settings": [
    { "type": "image_picker", "id": "hero_photo", "label": "Photo de fond (laisser vide pour fond ivoire uni)" },
    { "type": "text", "id": "title", "label": "Slogan", "default": "Parce que la première impression compte" },
    { "type": "text", "id": "tissus_link_label", "label": "Lien sous le bouton — voir les tissus", "default": "Voir les tissus en personne" },

    { "type": "header", "content": "Plan d'action" },
    { "type": "text", "id": "plan_title", "label": "Titre du plan", "default": "Comment procéder" },

    { "type": "text", "id": "step1_label", "label": "Étape 1 — texte du bouton", "default": "Configurez votre complet" },
    { "type": "url", "id": "step1_url", "label": "Étape 1 — lien" },
    { "type": "text", "id": "step1_intro", "label": "Étape 1 — phrase d'intro", "default": "Configurez votre complet de A à Z, ou commandez directement dans notre collection." },
    { "type": "textarea", "id": "step1_bullets", "label": "Étape 1 — points (un par ligne)", "default": "5 minutes" },
    { "type": "text", "id": "step1_style_advice_label", "label": "Étape 1 — texte avant le lien conseil stylistique", "default": "Conseil stylistique disponible — réponse en moins de 24h." },
    { "type": "text", "id": "step1_style_advice_link_label", "label": "Étape 1 — texte du lien conseil stylistique", "default": "Cliquez ici" },
    { "type": "url", "id": "step1_style_advice_url", "label": "Étape 1 — lien conseil stylistique (vide = /pages/aide-configuration)" },
    { "type": "text", "id": "step1_btn_label", "label": "Étape 1 — texte du bouton (dans la carte)", "default": "Configurer mon complet" },

    { "type": "text", "id": "step2_label", "label": "Étape 2 — titre", "default": "Rendez-vous mensurations" },
    { "type": "text", "id": "step2_intro", "label": "Étape 2 — phrase d'intro", "default": "Vos mensurations sont prises par un de nos professionnels pour assurer un ajustement parfait." },
    { "type": "textarea", "id": "step2_bullets", "label": "Étape 2 — points (un par ligne)", "default": "30 minutes" },
    { "type": "text", "id": "step2_btn_label", "label": "Étape 2 — texte du bouton (dans la carte)", "default": "Prendre rendez-vous" },

    { "type": "text", "id": "step3_label", "label": "Étape 3 — titre", "default": "Recevez votre complet" },
    { "type": "text", "id": "step3_intro", "label": "Étape 3 — phrase d'intro", "default": "Profitez d'un complet parfaitement ajusté à votre silhouette pour une allure à la hauteur de vos ambitions." },
    { "type": "textarea", "id": "step3_bullets", "label": "Étape 3 — points (un par ligne)", "default": "Livraison à domicile\n4-8 semaines\nRetouches gratuites au besoin" },
    { "type": "text", "id": "step3_btn_label", "label": "Étape 3 — texte du bouton (dans la carte)", "default": "Démarrer ma création" }
  ],
  "presets": [
    { "name": "Hero — Accueil" }
  ]
}
{% endschema %}
