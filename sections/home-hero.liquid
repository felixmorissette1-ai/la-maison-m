{% if section.settings.hero_photo %}
  <!-- Photo figée en arrière-plan (position:fixed), pas liée à une seule
     section — elle reste visible derrière le hero ET le plan d'action
     tant que ces deux sections n'ont pas leur propre fond opaque, et
     disparaît naturellement dès que la section Statistiques (fond
     opaque) arrive par-dessus au défilement. -->
  <div class="lmm-hero-fixed-bg">
    <div class="lmm-hero-fixed-bg__photo" style="background-image: url({{ section.settings.hero_photo | image_url: width: 1800 }});"></div>
    <div class="lmm-hero-fixed-bg__wash"></div>
  </div>
{% endif %}

<section class="lmm-hero full-width">
  <div class="lmm-hero__inner">
    <div class="lmm-hero__title-wrap">
      <div class="lmm-hero__title-block">
        <h1 class="lmm-hero__title">{{ section.settings.title }}</h1>
      </div>
    </div>
    <div class="lmm-hero__cta-row">
      <a href="{{ section.settings.step1_url }}" class="lmm-hero__cta">
        {{ section.settings.step1_label }}
      </a>
      {% if section.settings.tissus_link_label != blank %}
        <a href="#" class="lmm-hero__cta-secondary" onclick="event.preventDefault(); ouvrirLocalisationModal('tissus')">{{ section.settings.tissus_link_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

<section class="lmm-plan full-width">
  <div class="lmm-plan__inner">
    <div class="lmm-plan__layout">
      <div class="lmm-plan__title-col">
        <p class="lmm-plan__title" id="lmm-plan-title">{{ section.settings.plan_title }}</p>
      </div>

      <div class="lmm-plan__content-col">
    <div class="lmm-plan__row">
      <div class="lmm-plan__step">
        <div class="lmm-plan__head-group">
          <span class="lmm-plan__num">01</span>
          <div class="lmm-plan__step-head">
            <span class="lmm-plan__step-title">{{ section.settings.step1_label }}</span>
            {% if section.settings.step1_duration != blank %}<span class="lmm-plan__step-duration">{{ section.settings.step1_duration }}</span>{% endif %}
          </div>
        </div>
        <div class="lmm-plan__card">
          <svg class="lmm-plan__icon" width="44" height="44" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10a3 3 0 1 0-3-3"/>
            <path d="M22 10v3"/>
            <path d="M6 26 L20 13 a3 3 0 0 1 4 0 L38 26"/>
            <path d="M4 26h36"/>
            <rect x="14" y="30" width="10" height="10" rx="1"/>
          </svg>
          <p class="lmm-plan__intro">{{ section.settings.step1_intro }}</p>
          <ul class="lmm-plan__list">
            {% assign step1_lines = section.settings.step1_bullets | newline_to_br | split: '<br />' %}
            {% for line in step1_lines %}
              {% if line != blank %}<li>{{ line }}</li>{% endif %}
            {% endfor %}
            <li>Possibilité de voir et toucher les tissus</li>
            {% if section.settings.step1_style_advice_label != blank %}
              <li>{{ section.settings.step1_style_advice_label }}</li>
            {% endif %}
          </ul>
        </div>
      </div>

      <div class="lmm-plan__step">
        <div class="lmm-plan__head-group">
          <span class="lmm-plan__num">02</span>
          <a href="#" class="lmm-plan__step-head lmm-plan__step-head--link" onclick="event.preventDefault(); ouvrirLocalisationModal('mensurations')">
            <span class="lmm-plan__step-title">{{ section.settings.step2_label }}</span>
            {% if section.settings.step2_duration != blank %}<span class="lmm-plan__step-duration">{{ section.settings.step2_duration }}</span>{% endif %}
          </a>
        </div>
        <div class="lmm-plan__card">
          <svg class="lmm-plan__icon" width="44" height="44" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="14" width="32" height="18" rx="3"/>
            <path d="M12 14v6M17 14v4M22 14v6M27 14v4M32 14v6"/>
            <path d="M22 32v6"/>
          </svg>
          <p class="lmm-plan__intro">{{ section.settings.step2_intro }}</p>
          <ul class="lmm-plan__list">
            {% assign step2_lines = section.settings.step2_bullets | newline_to_br | split: '<br />' %}
            {% for line in step2_lines %}
              {% if line != blank %}<li>{{ line }}</li>{% endif %}
            {% endfor %}
            <li id="lmm-plan-ville-item"><span id="lmm-plan-ville">Ajustement disponible près de chez vous</span></li>
          </ul>
        </div>
      </div>

      <div class="lmm-plan__step">
        <div class="lmm-plan__head-group">
          <span class="lmm-plan__num">03</span>
          <div class="lmm-plan__step-head">
            <span class="lmm-plan__step-title">{{ section.settings.step3_label }}</span>
            {% if section.settings.step3_duration != blank %}<span class="lmm-plan__step-duration">{{ section.settings.step3_duration }}</span>{% endif %}
          </div>
        </div>
        <div class="lmm-plan__card">
          <svg class="lmm-plan__icon" width="44" height="44" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 6a2.5 2.5 0 1 0-2.5-2.5"/>
            <path d="M22 6v3"/>
            <path d="M14 9 L9 15 L6 17 L6 38 L38 38 L38 17 L35 15 L30 9"/>
            <path d="M14 9 L18 14 L22 11 L26 14 L30 9"/>
            <line x1="10" y1="19" x2="10" y2="34" stroke-opacity="0.4"/>
            <line x1="34" y1="19" x2="34" y2="34" stroke-opacity="0.4"/>
          </svg>
          <p class="lmm-plan__intro">{{ section.settings.step3_intro }}</p>
          <ul class="lmm-plan__list">
            {% assign step3_lines = section.settings.step3_bullets | newline_to_br | split: '<br />' %}
            {% for line in step3_lines %}
              {% if line != blank %}<li>{{ line }}</li>{% endif %}
            {% endfor %}
          </ul>
          <a href="{{ section.settings.step1_url }}" class="lmm-plan__cta-btn">{{ section.settings.step3_btn_label }}</a>
        </div>
      </div>
    </div>

    {% if section.settings.learnmore_link_label != blank %}
      <p class="lmm-plan__learnmore">
        {{ section.settings.learnmore_label }}
        <a href="{{ section.settings.learnmore_url | default: '/pages/comment-ca-fonctionne' }}" class="lmm-plan__link">{{ section.settings.learnmore_link_label }}</a>
      </p>
    {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  // Ville la plus proche pour l'étape 2 — demande la localisation dès
  // l'arrivée sur la page d'accueil ; échoue silencieusement (refus,
  // navigateur sans support, aucun tailleur dans un rayon raisonnable).
  (function () {
    var villeEl = document.getElementById('lmm-plan-ville');
    if (!villeEl || !navigator.geolocation) return;

    navigator.geolocation.getCurrentPosition(function (pos) {
      fetch('https://lmm-backend.vercel.app/api/couturiere', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lat: pos.coords.latitude, lng: pos.coords.longitude })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var nearest = data && data.success && data.couturieres && data.couturieres[0];
          if (nearest && nearest.ville && nearest.distanceValue < 100000) {
            villeEl.textContent = 'Ajustement disponible à ' + nearest.ville;
          }
        })
        .catch(function () {});
    }, function () {}, { timeout: 8000 });
  })();

  // Hauteur du hero calculée à partir des vraies mesures du DOM (pas de
  // pixels devinés ni de pourcentage fixe) : on mesure combien d'espace
  // prend le titre "Comment procéder" + le TITRE de chaque étape (pas
  // juste les flèches) — cette distance ne dépend pas de la hauteur du
  // hero lui-même, seulement du contenu du plan. Le hero prend tout le
  // reste de l'écran, ce qui garantit que les titres d'étapes restent
  // visibles au chargement, peu importe la taille de l'écran ou si un
  // titre passe sur deux lignes.
  // BUFFER_BELOW_TITLES doit être égal au padding-top de .lmm-plan (voir
  // le bloc de styles plus bas) : le padding donne l'espace visible
  // AU-DESSUS des étapes dans la bande ivoire, le buffer donne l'espace
  // visible EN DESSOUS — les deux égaux = les étapes centrées
  // verticalement dans la bande visible, plutôt que collées en bas
  // contre le pli.
  (function () {
    var hero = document.querySelector('.lmm-hero');
    var header = document.querySelector('.lmm-header');
    var plan = document.querySelector('.lmm-plan');
    var planTitle = document.querySelector('.lmm-plan__title');
    var stepHeads = document.querySelectorAll('.lmm-plan__step-head');
    if (!hero || !header || !plan || !planTitle || !stepHeads.length) return;

    var MIN_HERO_HEIGHT = 260;
    var BUFFER_BELOW_TITLES = 28;

    function updateHeroPeek() {
      var planTop = plan.getBoundingClientRect().top;
      var maxBottom = planTitle.getBoundingClientRect().bottom;
      stepHeads.forEach(function (el) {
        var bottom = el.getBoundingClientRect().bottom;
        if (bottom > maxBottom) maxBottom = bottom;
      });

      var revealHeight = maxBottom - planTop;
      var headerHeight = header.getBoundingClientRect().height;
      var target = window.innerHeight - headerHeight - revealHeight - BUFFER_BELOW_TITLES;

      hero.style.height = Math.max(target, MIN_HERO_HEIGHT) + 'px';
    }

    updateHeroPeek();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(updateHeroPeek);
    }
    window.addEventListener('load', updateHeroPeek);

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(updateHeroPeek, 120);
    });
  })();

  // "Comment procéder" (titre en marge) : centré dans sa colonne, aligné
  // verticalement avec le bloc qui fusionne le numéro + le titre de
  // l'étape 1 (.lmm-plan__head-group), pour que ça ait l'air continu
  // avec le hero au-dessus.
  // Spécifique à cette section (le prototype de titre en marge n'est
  // pour l'instant que sur "Comment procéder").
  (function () {
    var title = document.querySelector('.lmm-plan__title');
    var headGroup = document.querySelector('.lmm-plan__head-group');
    if (!title || !headGroup) return;

    function alignTitleWithArrows() {
      title.style.marginTop = '0px';
      var titleRect = title.getBoundingClientRect();
      var titleCenter = titleRect.top + titleRect.height / 2;
      var hgRect = headGroup.getBoundingClientRect();
      var targetY = hgRect.top + hgRect.height / 2;
      title.style.marginTop = (targetY - titleCenter) + 'px';
    }

    alignTitleWithArrows();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(alignTitleWithArrows);
    }
    window.addEventListener('load', alignTitleWithArrows);

    var titleResizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(titleResizeTimer);
      titleResizeTimer = setTimeout(alignTitleWithArrows, 120);
    });
  })();
</script>

{% stylesheet %}
  /* z-index:-1 (pas juste "derrière le hero" mais littéralement derrière
     tout le contenu normal de la page) — les sections plus bas (à partir
     de Statistiques) ont leur propre fond opaque, donc elles la
     recouvrent naturellement dès qu'on défile jusque-là. Aucun gradient
     de transition nécessaire : la coupure est nette par nature. */
  .lmm-hero-fixed-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .lmm-hero-fixed-bg__photo {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    filter: grayscale(0.55) sepia(0.35) brightness(1.18) contrast(0.86) saturate(0.85);
  }

  /* Léger en haut (photo vive derrière le slogan), s'intensifie vers le
     bas — la photo occupe ~87% de l'écran, le haut de "Comment procéder"
     (titre + numéros/titres d'étapes) apparaît dans les ~13% restants dès
     le chargement, sans avoir à défiler. Le dégradé adoucit la jonction. */
  .lmm-hero-fixed-bg__wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(var(--lmm-ivoire-rgb), 0.28) 0%,
      rgba(var(--lmm-ivoire-rgb), 0.34) 60%,
      rgba(var(--lmm-ivoire-rgb), 0.55) 100%
    );
  }

  .lmm-hero {
    position: relative;
    /* Transparent volontairement : la photo figée derrière montre à
       travers. */
    background: transparent;
    /* Valeur de repli avant que le script en bas de page ne mesure le
       vrai contenu et fixe la hauteur exacte en pixels (voir <script> :
       vise la hauteur des flèches entre les étapes, peu importe l'écran). */
    height: calc(100dvh - 104px);
    min-height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
  }

  .lmm-hero__inner {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px 32px 40px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Centre le slogan + les boutons comme un seul bloc dans le hero,
       au lieu d'étirer le slogan pour pousser les boutons en bas. */
    justify-content: center;
    gap: 28px;
  }

  .lmm-hero__title-wrap {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Boîte "inline-block" : sa largeur épouse exactement le texte du
     slogan (pas la largeur du hero), pour que la ligne courbe en dessous
     ait toujours la largeur du slogan lui-même — comme un soulignement. */
  .lmm-hero__title-block {
    display: inline-block;
    text-align: center;
  }

  .lmm-hero__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(30px, 4vw, var(--lmm-fs-slogan));
    font-weight: 400;
    color: var(--lmm-text);
    line-height: 1.3;
    text-align: center;
    margin: 0;
  }

  .lmm-hero__cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .lmm-hero__cta {
    display: inline-flex;
    background: var(--lmm-bordeaux);
    color: var(--lmm-ivoire);
    text-decoration: none;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 20px;
    padding: 22px 44px;
    border-radius: 8px;
    white-space: nowrap;
  }

  /* Bouton secondaire — même gabarit que le CTA principal mais en
     contour, pour rester clairement subordonné à "Configurez votre
     complet" tout en restant un vrai bouton (pas juste un lien discret). */
  .lmm-hero__cta-secondary {
    display: inline-flex;
    align-items: center;
    background: transparent;
    border: 1.5px solid var(--lmm-text);
    color: var(--lmm-text);
    text-decoration: none;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 18px;
    padding: 20px 32px;
    border-radius: 8px;
    white-space: nowrap;
    transition: background 0.2s, color 0.2s;
  }

  .lmm-hero__cta-secondary:hover {
    background: var(--lmm-text);
    color: var(--lmm-ivoire);
  }

  @media (min-width: 768px) {
    .lmm-hero__title {
      white-space: nowrap;
    }
  }

  @media (max-width: 560px) {
    .lmm-hero__cta-row {
      flex-direction: column;
      width: 100%;
    }

    .lmm-hero__cta,
    .lmm-hero__cta-secondary {
      width: 100%;
      justify-content: center;
      box-sizing: border-box;
    }
  }

  .lmm-plan {
    position: relative;
    /* Fond plein et opaque — cette section est maintenant entièrement
       sous le pli, sur son propre plan, plus superposée à la photo du
       hero (voir .lmm-hero ci-dessus). */
    background: var(--lmm-ivoire-pale);
    /* Pas de padding horizontal ici — .lmm-plan__layout s'en charge, pour
       garder le contrôle des marges gauche/droite à un seul endroit
       (et éviter un cumul des deux qui pousserait le contenu trop loin
       du bord droit). Padding du haut : volontairement égal à
       BUFFER_BELOW_TITLES (voir <script>) — c'est ce qui garantit que le
       titre/les étapes sont centrés verticalement dans la bande ivoire
       visible sous la photo au chargement, pas juste collés en bas. */
    padding: 28px 0 90px;
  }

  .lmm-plan__inner {
    position: relative;
    width: 100%;
  }

  /* Le titre vit dans une colonne de marge à part, délimitée par une
     ligne, plutôt qu'au-dessus du contenu. Pleine largeur — pas de
     conteneur max-width centré ici : la colonne de titre reste collée
     près du bord gauche et la colonne de contenu s'étend jusqu'au bord
     droit, sans jamais laisser de marge vide à droite (voir
     .lmm-plan__row plus bas, qui se centre PLUTÔT à l'intérieur de
     cette colonne de contenu). Les colonnes s'étirent à la même hauteur
     (comportement grid par défaut) pour que la ligne coure sur toute la
     hauteur de la section. */
  .lmm-plan__layout {
    display: grid;
    /* clamp() plutôt qu'un minmax() à bornes fixes : une largeur fixe
       est soit trop petite sur un grand écran (27"), soit trop grande
       sur un petit (~20"). Le clamp() suit la largeur réelle de l'écran
       en continu entre les deux bornes. */
    grid-template-columns: clamp(170px, 15vw, 300px) 1fr;
    gap: 48px;
    padding: 0 40px 0 56px;
  }

  .lmm-plan__title-col {
    border-right: 1px solid var(--lmm-text);
    padding-right: 28px;
  }

  /* Centré dans la colonne de marge (pas aligné sur la ligne) — le
     retour à la ligne normal du navigateur suffit, jamais de coupure
     en plein mot. */
  .lmm-plan__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(26px, 2.4vw, 36px);
    font-weight: 400;
    line-height: 1.3;
    color: var(--lmm-bordeaux);
    text-align: center;
    margin: 0;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .lmm-plan__content-col {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Hors des cartes, centré sous les 3 étapes — pas un point de liste
     comme les autres, un lien partagé pour toute la section. */
  .lmm-plan__learnmore {
    margin: 32px 0 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--lmm-text);
    text-align: center;
  }

  /* Une carte encadrée par étape — largeur égale, contenu aligné à
     gauche. Les 3 cartes forment une seule rangée de grille, donc elles
     s'étirent à la même hauteur peu importe la longueur du titre.
     max-width : se centre dans .lmm-plan__content-col plutôt que
     d'étirer les cartes à l'infini sur un très grand écran. */
  .lmm-plan__row {
    width: 100%;
    max-width: 1200px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 28px;
    row-gap: 24px;
    align-items: stretch;
  }

  /* Plus de boîte autour de toute la case — seule la description (voir
     .lmm-plan__desc) est encadrée. Le numéro et le titre restent nus sur
     le fond flouté. */
  .lmm-plan__step {
    position: relative;
    box-sizing: border-box;
    background: transparent;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    text-align: left;
  }

  /* Boîte encadrée — icône, points, bouton. flex:1 + le bouton en
     margin-top:auto font que les 3 cartes restent à la même hauteur et
     que les boutons s'alignent tous en bas, peu importe le nombre de
     points dans chaque carte (voir .lmm-plan__row align-items:stretch
     qui donne d'abord aux 3 .lmm-plan__step la même hauteur). Bordure
     noire (pas bordeaux) pour rester dans le registre plus neutre
     demandé pour les pastilles/boutons de cette zone du site. */
  .lmm-plan__card {
    box-sizing: border-box;
    width: 100%;
    flex: 1;
    margin-top: 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid var(--lmm-text);
    border-radius: 10px;
    padding: 38px 32px 32px;
  }

  .lmm-plan__icon {
    color: var(--lmm-bordeaux);
    margin-bottom: 24px;
  }

  .lmm-plan__intro {
    font-size: var(--lmm-fs-body);
    color: var(--lmm-text);
    line-height: 1.7;
    text-align: center;
    margin: 0 0 22px;
  }

  .lmm-plan__head-group {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 14px;
  }

  /* Même format de numéro et de titre pour les 3 étapes — seule la
     décoration (curseur pour l'étape 2, l'étape cliquable) change selon
     que l'étape est cliquable ou non. */
  .lmm-plan__num {
    position: relative;
    display: block;
    width: 100%;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--lmm-fs-number);
    font-weight: 400;
    color: var(--lmm-bordeaux);
    text-align: center;
  }

  /* Petite flèche bordeaux entre les étapes (pas sur la dernière, rien
     après) — ancrée sur le NUMÉRO seul (pas tout le groupe numéro+titre)
     pour toujours rester au même niveau que "01 → 02 → 03", peu importe
     si un titre d'étape passe sur une ou deux lignes. Hampe (::before) +
     pointe (::after). */
  .lmm-plan__step:not(:last-child) .lmm-plan__num::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 100%;
    width: 20px;
    height: 1.5px;
    background: var(--lmm-bordeaux);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .lmm-plan__step:not(:last-child) .lmm-plan__num::after {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(100% + 20px);
    width: 0;
    height: 0;
    border-top: 4.5px solid transparent;
    border-bottom: 4.5px solid transparent;
    border-left: 7px solid var(--lmm-bordeaux);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .lmm-plan__step-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    text-align: center;
    /* Fixe à la hauteur d'un titre sur 2 lignes : même si un titre est
       plus court qu'un autre (une ligne au lieu de deux), la description
       qui suit démarre toujours à la même hauteur dans les 3 cartes —
       sinon la carte au titre le plus court laisserait sa description
       dépasser avant celle des autres, et la coupure au chargement du
       hero ne serait plus fiable. */
    min-height: 63px;
    text-decoration: none;
  }

  .lmm-plan__step-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--lmm-fs-card-title);
    font-weight: 400;
    line-height: 1.3;
    color: var(--lmm-text);
  }

  /* La durée vit sous le titre d'étape, dans le groupe numéro+titre —
     donc visible dès le chargement de la page, dans la bande ivoire du
     hero, pas seulement une fois la carte scrollée en vue. */
  .lmm-plan__step-duration {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--lmm-muted);
  }

  .lmm-plan__step-head--link {
    cursor: pointer;
  }

  .lmm-plan__step-head--link .lmm-plan__step-title {
    transition: color 0.2s;
  }

  .lmm-plan__step-head--link:hover .lmm-plan__step-title {
    color: var(--lmm-bordeaux-soft);
  }

  .lmm-plan__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  /* La puce est un vrai item flex (pas juste un ::before inline) pour
     que le texte qui passe à la ligne s'aligne sous le début du texte,
     pas sous la puce — sinon la 2e ligne repart tout à gauche du bloc. */
  .lmm-plan__list li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: var(--lmm-fs-body);
    color: var(--lmm-text);
    line-height: 1.7;
    text-align: left;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .lmm-plan__list li::before {
    content: '○';
    flex-shrink: 0;
    color: var(--lmm-bordeaux-soft);
    font-size: 11px;
  }

  .lmm-plan__link {
    color: var(--lmm-bordeaux-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Seule l'étape 3 (l'action finale du parcours) garde un bouton dans
     la carte — même langage visuel que le CTA du hero (bordeaux, coins
     ronds, serif) plutôt que le bouton sombre partagé .lmm-btn-primary,
     pour rester dans le ton du reste de la section. auto pousse le
     bouton en bas de la carte, peu importe combien de points la liste
     contient — et le centre horizontalement, hérité de
     .lmm-plan__card { align-items: center }. */
  .lmm-plan__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    padding: 15px 36px 14px;
    background: var(--lmm-bordeaux);
    color: var(--lmm-ivoire);
    text-decoration: none;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 15px;
    border-radius: 8px;
    transition: opacity 0.2s;
  }

  .lmm-plan__cta-btn:hover {
    opacity: 0.85;
  }

  /* La colonne de marge n'a plus la place de respirer en dessous de
     900px — le titre repasse au-dessus du contenu, centré, avec une
     ligne horizontale plutôt que verticale. */
  @media (max-width: 900px) {
    .lmm-plan__layout {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 0 24px;
    }

    .lmm-plan__title-col {
      border-right: none;
      border-bottom: 1px solid var(--lmm-text);
      padding-right: 0;
      padding-bottom: 24px;
    }

    .lmm-plan__title {
      text-align: center;
    }
  }

  @media (max-width: 767px) {
    .lmm-plan__title {
      font-size: 26px;
    }

    .lmm-plan__row {
      grid-template-columns: 1fr;
      row-gap: 40px;
    }

    /* Les flèches de connexion entre étapes n'ont de sens qu'en rangée
       horizontale — cachées une fois les cartes empilées. */
    .lmm-plan__step:not(:last-child) .lmm-plan__num::before,
    .lmm-plan__step:not(:last-child) .lmm-plan__num::after {
      display: none;
    }
  }
{% endstylesheet %}

