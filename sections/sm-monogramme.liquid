{% comment %} Monogramme — Configurateur Custom {% endcomment %}
{% render 'fil-ariane-custom', etape_active: 8 %}
{% render 'sm-preview' %}

<style>
  .lmm-smono-wrap {
    width: 90%; max-width: 560px; margin: 0 auto; padding: 56px 0 60px;
    display: flex; flex-direction: column; box-sizing: border-box;
  }
  @media (min-width: 861px) { .lmm-smono-wrap { margin-right: 0; margin-left: 5%; } }
  .lmm-smono__label { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lmm-bordeaux); margin-bottom: 6px; }
  .lmm-smono__title { font-family: Georgia, serif; font-size: 28px; font-weight: 400; color: var(--lmm-text); margin-bottom: 10px; }
  .lmm-smono__sub { font-size: 13px; color: var(--lmm-muted); font-weight: 300; line-height: 1.6; margin-bottom: 32px; }
  .lmm-smono__field { margin-bottom: 8px; }
  .lmm-smono__input {
    width: 100%; box-sizing: border-box; border: 1px solid var(--lmm-border); background: var(--lmm-ivoire-pale);
    padding: 16px 18px; font-family: Georgia, serif; font-size: 18px; letter-spacing: 0.04em;
    color: var(--lmm-text); text-align: center; text-transform: uppercase;
  }
  .lmm-smono__input:focus { outline: none; border-color: var(--lmm-bordeaux); }
  .lmm-smono__count { font-size: 10px; color: var(--lmm-muted); text-align: right; margin: 6px 0 0; }
  .lmm-smono__prix { font-size: 11px; color: var(--lmm-muted); text-align: center; margin: 16px 0 0; letter-spacing: 0.04em; }
  .lmm-smono__checkbox-row { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 20px; }
  .lmm-smono__checkbox-row input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--lmm-bordeaux); cursor: pointer; }
  .lmm-smono__checkbox-row label { font-size: 12px; letter-spacing: 0.04em; color: var(--lmm-muted); cursor: pointer; }
</style>

<div class="lmm-smono-wrap lmm-sm-main">
  <p class="lmm-smono__label">Configurateur custom — Étape 8 sur 9</p>
  <h1 class="lmm-smono__title">Un nom brodé à l'intérieur du veston</h1>
  <p class="lmm-smono__sub">{{ section.settings.sous_titre }}</p>

  <div class="lmm-smono__field">
    <input type="text" id="mono-input" class="lmm-smono__input" maxlength="{{ section.settings.max_caracteres | default: 20 }}" placeholder="Ex. J. Morissette" autocomplete="off">
    <p class="lmm-smono__count"><span id="mono-count">0</span> / {{ section.settings.max_caracteres | default: 20 }}</p>
  </div>

  {% if section.settings.prix_monogramme and section.settings.prix_monogramme > 0 %}
    <p class="lmm-smono__prix">+ {{ section.settings.prix_monogramme | money }} si un nom est brodé</p>
  {% endif %}

  <div class="lmm-smono__checkbox-row">
    <input type="checkbox" id="mono-skip-checkbox">
    <label for="mono-skip-checkbox">Ne rien broder</label>
  </div>
</div>

<script>
  var monoInput = document.getElementById('mono-input');
  var monoCount = document.getElementById('mono-count');
  var monoSkip = document.getElementById('mono-skip-checkbox');

  // Étape toujours optionnelle — le bouton "Continuer" partagé du panneau
  // preview (sm-preview.liquid) est actif dès l'arrivée sur la page, comme
  // sur les autres étapes une fois leur sélection complète. "Ne rien
  // broder" ne fait qu'effacer/désactiver le champ — le client doit
  // quand même cliquer "Continuer" pour poursuivre (pas de navigation
  // automatique au clic de la case).
  var lmmSharedNext = document.getElementById('lmm-prev-btn-next');
  if (lmmSharedNext) lmmSharedNext.classList.add('active');

  var savedMono = new URLSearchParams(window.location.search).get('monogramme');
  if (savedMono) {
    monoInput.value = savedMono;
    monoCount.textContent = savedMono.length;
  }

  monoInput.addEventListener('input', function() {
    monoCount.textContent = monoInput.value.length;
  });

  monoSkip.addEventListener('change', function() {
    monoInput.disabled = monoSkip.checked;
    if (monoSkip.checked) {
      monoInput.value = '';
      monoCount.textContent = '0';
    }
  });

  function goNext() {
    var p = new URLSearchParams(window.location.search);
    var val = monoSkip.checked ? '' : monoInput.value.trim();
    if (val) { p.set('monogramme', val); } else { p.delete('monogramme'); }
    p.set('mono_vu', '1');
    window.location.href = '/pages/sur-mesure-recap?' + p.toString();
  }
</script>

{% schema %}
{
  "name": "Custom — Monogramme",
  "settings": [
    { "type": "textarea", "id": "sous_titre", "label": "Sous-titre", "default": "Faites broder discrètement un nom ou des initiales à l'intérieur du veston. Cette étape est entièrement optionnelle." },
    { "type": "number", "id": "max_caracteres", "label": "Nombre de caractères maximum", "default": 20 },
    { "type": "number", "id": "prix_monogramme", "label": "Prix du monogramme (en cents, ex: 1500 = 15,00$)", "default": 2000 }
  ],
  "presets": [{ "name": "Custom — Monogramme" }]
}
{% endschema %}
