{% comment %} Page produit — La Maison M. {% endcomment %}

<script>window.scrollTo(0, 0);</script>

<div class="lmm-product full-width">
  <div class="lmm-product__inner">

    <a href="/collections/all" style="display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:var(--lmm-muted);text-decoration:none;padding:0;margin-bottom:20px;">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 2L4 7L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Retour
    </a>

    {% comment %} Breadcrumb {% endcomment %}
    <div class="lmm-breadcrumb">
      <a href="/">Accueil</a>
      <span>/</span>
      {% if product.type == 'Chemise' %}
        <a href="/collections/chemises">Chemises</a>
      {% else %}
        <a href="/collections/collection">Collection</a>
      {% endif %}
      <span>/</span>
      <span>{{ product.title }}</span>
    </div>

    <div class="lmm-product__grid">

      {% comment %} Photo {% endcomment %}
      <div class="lmm-product__visual">
        <div class="lmm-product__photo">
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 900 | image_tag: alt: product.title }}
          {% else %}
            <div class="lmm-photo-placeholder lmm-photo-placeholder--large">
              <span>Photo à venir</span>
            </div>
          {% endif %}
        </div>
      </div>

      {% comment %} Infos {% endcomment %}
      <div class="lmm-product__info">

        {% for tag in product.tags %}
          {% if tag == 'Prestige' or tag == 'Contemporain' or tag == 'Décontracté' %}
            <p class="lmm-label" style="color:var(--lmm-bordeaux); margin-bottom:16px;">Collection {{ tag }}</p>
          {% endif %}
        {% endfor %}

        <h1 class="lmm-product__title">{{ product.title }}</h1>
        <p class="lmm-product__subtitle">{{ product.metafields.custom.subtitle }}</p>

        <div class="lmm-divider-gold"></div>

        <div class="lmm-product__price-row">
          <span class="lmm-product__price">{{ product.price | money_without_trailing_zeros }} CAD</span>
          <span class="lmm-product__delivery">Livraison en {{ product.metafields.custom.delai | default: '6–8' }} semaines</span>
        </div>

        {% if product.type == 'Chemise' %}
          {% comment %} Variantes couleur — photos {% endcomment %}
          <div class="lmm-product__tissu">
            <p class="lmm-product__section-label">Couleur</p>
            <div class="lmm-product__variant-swatches" id="chemise-variant-swatches">
              {% for variant in product.variants %}
                <div class="lmm-product__variant-swatch{% if variant.id == product.selected_or_first_available_variant.id %} lmm-product__variant-swatch--selected{% endif %}{% unless variant.available %} lmm-product__variant-swatch--disabled{% endunless %}"
                     data-variant-id="{{ variant.id }}"
                     title="{{ variant.title }}"
                     onclick="selectChemiseVariant(this, {{ variant.id }})">
                  {% if variant.featured_image %}
                    <img src="{{ variant.featured_image | image_url: width: 100 }}" alt="{{ variant.title }}">
                  {% else %}
                    <div class="lmm-photo-placeholder lmm-photo-placeholder--swatch-lg"><span>{{ variant.title }}</span></div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
            <p class="lmm-product__tissu-name" id="chemise-variant-label">{{ product.selected_or_first_available_variant.title }}</p>
          </div>
        {% else %}
          {% comment %} Tissu swatch {% endcomment %}
          <div class="lmm-product__tissu">
            <p class="lmm-product__section-label">Tissu</p>
            <div class="lmm-product__tissu-row">
              <div class="lmm-product__tissu-swatch">
                <div class="lmm-photo-placeholder lmm-photo-placeholder--swatch-lg"><span>Photo</span></div>
              </div>
              <div>
                <p class="lmm-product__tissu-name">{{ product.metafields.custom.tissu | default: '—' }}</p>
                <p class="lmm-product__tissu-origine">{{ product.metafields.custom.origine }}</p>
              </div>
            </div>
          </div>
        {% endif %}

        {% comment %} Caractéristiques {% endcomment %}
        {% if product.metafields.custom.caracteristiques %}
          <div class="lmm-product__features">
            <p class="lmm-product__section-label">Caractéristiques</p>
            <div class="lmm-product__features-grid">
              {% assign feats = product.metafields.custom.caracteristiques | split: ',' %}
              {% for feat in feats %}
                <div class="lmm-product__feature">
                  <span class="lmm-dot"></span>
                  <span>{{ feat | strip }}</span>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <div class="lmm-product__ctas">
          {% if product.type == 'Chemise' %}
            {% form 'product', product %}
              <input type="hidden" name="id" id="chemise-selected-variant" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="lmm-product__cta-primary" {% unless product.available %}disabled{% endunless %}>
                <span>{% if product.available %}Ajouter au panier{% else %}Épuisé{% endif %}</span>
              </button>
            {% endform %}
          {% else %}
            <a href="/pages/configurateur?modele={{ product.handle }}&prix={{ product.price }}&variant={{ product.variants.first.id }}&p1={{ product.metafields.custom.thermocolle.value | url_encode }}&p2={{ product.metafields.custom.demi_canva.value | url_encode }}&p3={{ product.metafields.custom.plein_canva.value | url_encode }}&rec={{ product.metafields.custom.cava_recommande.value | url_encode }}&p3pieces={{ product.metafields.custom.supplement_3_pieces.value | url_encode }}" class="lmm-product__cta-primary">
              <span>Commander ce complet</span>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            {% assign style_entry = product.metafields.custom.style.value %}
            {% if style_entry %}
              {% assign style_nom = style_entry.nom.value %}
              {% assign style_photo = style_entry.photo.value | image_url: width: 800 %}
              <a href="/pages/sur-mesure-pieces?style={{ style_nom | url_encode }}&style_photo={{ style_photo | url_encode }}" class="lmm-product__cta-secondary">
                Personnaliser ce complet
              </a>
            {% else %}
              <a href="/pages/sur-mesure-pieces" class="lmm-product__cta-secondary">
                Personnaliser ce complet
              </a>
            {% endif %}
          {% endif %}
        </div>

        {% if product.description != blank %}
          <div class="lmm-product__description-section">
            <p class="lmm-product__section-label">Description</p>
            <div class="lmm-product__description-text">{{ product.description }}</div>
          </div>
        {% endif %}

      </div>
    </div>

    {% comment %} Complets similaires {% endcomment %}
    {% assign related = collections.all.products %}
    {% if related.size > 1 %}
      <div class="lmm-related">
        <h2 class="lmm-related__title">Vous aimerez aussi</h2>
        <div class="lmm-related__grid">
          {% assign count = 0 %}
          {% for p in related %}
            {% unless p.handle == product.handle %}
              {% if count < 3 %}
                <a href="{{ p.url }}" class="lmm-related__card">
                  <div class="lmm-related__photo">
                    {% if p.featured_image %}
                      {{ p.featured_image | image_url: width: 300 | image_tag: alt: p.title }}
                    {% else %}
                      <div class="lmm-photo-placeholder"><span>Photo à venir</span></div>
                    {% endif %}
                  </div>
                  <div class="lmm-related__info">
                    <h3>{{ p.title }}</h3>
                    <p>{{ p.price | money_without_trailing_zeros }} CAD</p>
                  </div>
                </a>
                {% assign count = count | plus: 1 %}
              {% endif %}
            {% endunless %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

  </div>
</div>

<script>
  function selectChemiseVariant(el, variantId) {
    document.querySelectorAll('.lmm-product__variant-swatch').forEach(function(s) {
      s.classList.remove('lmm-product__variant-swatch--selected');
    });
    el.classList.add('lmm-product__variant-swatch--selected');
    var input = document.getElementById('chemise-selected-variant');
    if (input) input.value = variantId;
    var label = document.getElementById('chemise-variant-label');
    if (label) label.textContent = el.getAttribute('title');
  }
</script>

{% stylesheet %}
  .lmm-product__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 32px 32px 80px;
  }

  .lmm-breadcrumb {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    color: var(--lmm-muted);
    margin-bottom: 40px;
  }

  .lmm-breadcrumb a { text-decoration: none; color: var(--lmm-muted); transition: color 0.2s; }
  .lmm-breadcrumb a:hover { color: var(--lmm-text); }

  .lmm-product__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    margin-bottom: 80px;
  }

  .lmm-product__visual { position: sticky; top: 100px; }

  .lmm-product__photo {
    background: var(--lmm-surface);
    border: 1px solid rgba(var(--lmm-text-rgb),0.08);
    padding: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 520px;
  }

  .lmm-photo-placeholder--large {
    width: 100%;
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lmm-photo-placeholder--large span {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lmm-muted);
  }

  .lmm-product__title {
    font-family: Georgia, serif;
    font-size: 40px;
    font-weight: 400;
    color: var(--lmm-text);
    margin-bottom: 8px;
  }

  .lmm-product__subtitle {
    font-size: 16px;
    color: var(--lmm-muted);
    font-weight: 300;
    margin-bottom: 24px;
  }

  .lmm-divider-gold {
    height: 1px;
    background: var(--lmm-bordeaux);
    width: 48px;
    margin-bottom: 24px;
  }

  .lmm-product__price-row {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 28px;
  }

  .lmm-product__price {
    font-family: Georgia, serif;
    font-size: 28px;
    color: var(--lmm-text);
  }

  .lmm-product__delivery {
    font-size: 13px;
    color: var(--lmm-muted);
    font-weight: 300;
  }

  .lmm-product__section-label {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lmm-muted);
    margin-bottom: 12px;
  }

  .lmm-product__tissu { margin-bottom: 28px; }

  .lmm-product__tissu-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .lmm-product__tissu-swatch {
    width: 48px;
    height: 48px;
    border: 1px solid rgba(var(--lmm-text-rgb),0.12);
    overflow: hidden;
    flex-shrink: 0;
  }

  .lmm-photo-placeholder--swatch-lg {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--lmm-surface);
  }

  .lmm-photo-placeholder--swatch-lg span {
    font-size: 8px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lmm-muted);
  }

  .lmm-product__tissu-name { font-size: 14px; font-weight: 500; color: var(--lmm-text); }
  .lmm-product__tissu-origine { font-size: 12px; color: var(--lmm-muted); }

  .lmm-product__features { margin-bottom: 28px; }

  .lmm-product__features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .lmm-product__feature {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--lmm-muted);
  }

  .lmm-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--lmm-bordeaux);
    flex-shrink: 0;
  }

  .lmm-product__description-section {
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid rgba(var(--lmm-text-rgb),0.08);
  }

  .lmm-product__description-text {
    font-family: Georgia, serif;
    font-size: 15px;
    font-weight: 400;
    color: rgba(var(--lmm-text-rgb),0.75);
    line-height: 1.9;
  }

  .lmm-product__description-text p { margin: 0 0 14px; }
  .lmm-product__description-text p:last-child { margin-bottom: 0; }

  .lmm-product__variant-swatches {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .lmm-product__variant-swatch {
    width: 48px;
    height: 48px;
    border: 1px solid rgba(var(--lmm-text-rgb),0.12);
    overflow: hidden;
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 0.2s;
  }

  .lmm-product__variant-swatch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lmm-product__variant-swatch--selected {
    border: 2px solid var(--lmm-text);
  }

  .lmm-product__variant-swatch--disabled {
    opacity: 0.35;
    cursor: not-allowed;
    pointer-events: none;
  }

  .lmm-product__ctas {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 28px;
  }

  .lmm-product__cta-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    background: var(--lmm-text);
    color: var(--lmm-white);
    text-decoration: none;
    padding: 20px 36px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    transition: background 0.25s, gap 0.25s;
    box-sizing: border-box;
  }

  .lmm-product__cta-primary:hover {
    background: var(--lmm-bordeaux);
    color: var(--lmm-text);
    gap: 18px;
  }

  .lmm-product__cta-primary svg { width: 16px; height: 16px; flex-shrink: 0; }

  .lmm-product__cta-primary[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .lmm-product__cta-secondary {
    display: block;
    width: 100%;
    text-align: center;
    background: transparent;
    color: var(--lmm-muted);
    text-decoration: none;
    padding: 14px 36px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid rgba(var(--lmm-text-rgb),0.15);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    transition: border-color 0.2s, color 0.2s;
    box-sizing: border-box;
  }

  .lmm-product__cta-secondary:hover {
    border-color: var(--lmm-text);
    color: var(--lmm-text);
  }

  .lmm-related {
    border-top: 1px solid rgba(var(--lmm-text-rgb),0.08);
    padding-top: 64px;
  }

  .lmm-related__title {
    font-family: Georgia, serif;
    font-size: 24px;
    font-weight: 400;
    margin-bottom: 32px;
    color: var(--lmm-text);
  }

  .lmm-related__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .lmm-related__card {
    text-decoration: none;
    color: inherit;
    display: flex;
    gap: 16px;
    align-items: center;
    background: var(--lmm-white);
    padding: 20px;
    border: 1px solid rgba(var(--lmm-text-rgb),0.06);
  }

  .lmm-related__photo {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--lmm-surface);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lmm-related__photo img { width: 100%; height: 100%; object-fit: cover; }

  .lmm-related__info h3 {
    font-family: Georgia, serif;
    font-size: 15px;
    font-weight: 400;
    color: var(--lmm-text);
    margin-bottom: 4px;
  }

  .lmm-related__info p { font-size: 13px; font-weight: 500; color: var(--lmm-text); }

  @media (max-width: 768px) {
    .lmm-product__grid { grid-template-columns: 1fr; gap: 40px; }
    .lmm-related__grid { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Produit",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
